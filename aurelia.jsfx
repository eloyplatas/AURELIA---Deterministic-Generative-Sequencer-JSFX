textAt("RITMO", PX + 10, 266); textAt("ARMONÍA", PX + 180, 266);
knob(PX + 30, 308, 5, 0, 16, 3, 1, "REJILLA", nmDiv[max(0, min(16, slider5))], 4, gHelp[5]);
sprintf(#k6, "%d%%", slider6); knob(PX + 80, 308, 6, 0, 100, 100, 1, "FUERZA", #k6, 4, gHelp[6]);
hd = slider7;
strcpy(#k7, hd < 1 ? "UNÍS/8ª" : (hd < 2.58 ? "8ª" : (hd < 3.58 ? "5ª" : (hd < 3.91 ? "4ª" : (hd < 4.32 ? "6ª M" : (hd < 4.91 ? "3ª M" : (hd < 5.32 ? "3ª m" : (hd < 6.17 ? "6ª m" : (hd < 7.17 ? "2ª/7ª" : (hd < 10.49 ? "7ª m/2ª m" : "TODO"))))))))));
sprintf(#k7b, "%.1f %s", hd, #k7);
knob(PX + 200, 308, 7, 0, 12, 5, 0.1, "DIST ARM", #k7b, 4, gHelp[7]);
sprintf(#k8, "VOZ %d", slider8); knob(PX + 256, 308, 8, 1, 4, 4, 1, "GUÍA", #k8, max(0, slider8 - 1), gHelp[8]);
gfx_setfont(3);
toggle(PX + 286, 294, 54, 20, slider9 ? "TODAS" : "GUÍA", 1, 4) ? setSlider(9, !slider9);
hover(PX + 286, 294, 54, 20) ? strcpy(#help, gHelp[9]);
gfx_set(0.42, 0.42, 0.45, 1); textAt("contra", PX + 294, 317);

// entrada MIDI
