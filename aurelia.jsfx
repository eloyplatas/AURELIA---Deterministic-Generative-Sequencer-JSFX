prDesc = 62383;
prDesc[0] = "Masas de glissandi que se abren y se cierran, como las cuerdas de Metastaseis (1954): cuatro nubes con GLISS al máximo y alturas sin escala.";
prDesc[1] = "Nubes de pizzicati cuyas velocidades siguen la ley de Gauss, como las moléculas de gas de Pithoprakta (1956). Notas muy cortas, densidad alta.";
prDesc[2] = "La matriz de Achorripsis (1957): cada voz alterna secciones activas y silenciosas según Poisson, con densidades distintas por voz.";
prDesc[3] = "Las cadenas de Markov de pantallas de Analogique A (1958) con su matriz original GTPM, en tres registros de cuerda.";
prDesc[4] = "Analogique A con las tres cadenas acopladas alfa/beta y protocolo de secciones perturbadas hacia la pantalla H.";
prDesc[5] = "Música estocástica calculada por ordenador como ST/10 (1962): secciones cortas con leyes uniformes y cuatro timbres que entran y salen.";
prDesc[6] = "Cuarteto de cuerda estocástico a la manera de ST/4: violonchelo, viola y dos violines con nubes de densidad media en sus registros.";
prDesc[7] = "Piano a la manera de Herma (1961): nubes rápidas que recorren todo el teclado con la ley lineal de intervalos.";
prDesc[8] = "Ráfagas de piano contra notas largas de metales, como en Eonta (1964).";
prDesc[9] = "Las rotaciones del cubo de Nomos Alpha (1966) como permutaciones de una serie de 8 sonidos en el violonchelo.";
prDesc[10] = "Cuatro polígonos dinámicos estocásticos de segundo orden, microtonales y en glissando, como las capas de GENDY3 (1991).";
prDesc[11] = "Paseos aleatorios de primer orden, rápidos y ásperos, como en S.709 (1994), la última obra de GENDYN.";
prDesc[12] = "GENDYN a escala de forma: tramos de varios tiempos, barreras estrechas y glissandi largos que dibujan drones moviéndose.";
prDesc[13] = "Crepitar de brasas como en Concret PH (1958): miles de granos cortísimos, agudos y microtonales.";
prDesc[14] = "Una masa espesa que apenas cambia, como Bohor (1962): nubes de seis notas largas que se superponen.";
prDesc[15] = "Dibujos a mano alzada de la UPIC (Mycenae Alpha, 1978): líneas GENDYN largas con glissando continuo.";
prDesc[16] = "Arborescencias de piano como en Evryali (1973): un tronco melódico que se ramifica en variantes.";
prDesc[17] = "Paseos aleatorios de piano como en Mists (1980): la melodía se arrastra por el registro y deja estelas.";
prDesc[18] = "Cribas de Xenakis como en Psappha (1975): unión de clases de restos (5 y 7) que dan ataques irregulares pero periódicos.";
prDesc[19] = "Glissandi lentos de cuerda que se cruzan, como en Syrmos (1959).";
prDesc[20] = "Sonido disperso entre los músicos como en Terretektorh (1966): cuatro nubes cuyos centros derivan por todo el registro.";
prDesc[21] = "Rotación de golpes entre seis percusionistas como en Persephassa (1969): anillos euclídeos desplazados que se persiguen.";
prDesc[22] = "Una sola voz con la ley de Cauchy: casi todo son pasos pequeños, pero de vez en cuando aparece un salto enorme.";
prDesc[23] = "Movimiento browniano puro: cada nota sale de la anterior con un paso aleatorio, a escala.";
prDesc[24] = "La forma más pura de la música estocástica: ataques de Poisson y alturas uniformes en cuatro registros.";
prDesc[25] = "Dos cribas de Xenakis: la unión de los periodos 3 y 5 y la de 7 y 8, en registros opuestos.";
prDesc[26] = "La ley del arcoseno favorece los extremos: la voz salta entre el grave y el agudo y evita el centro.";
prDesc[27] = "Barreras casi cerradas: el polígono choca una y otra vez contra paredes estrechas y la melodía vibra en un intervalo pequeño.";
prDesc[28] = "Granos microtonales a medio registro: nube densa, sin escala y con desviación MICRO máxima.";
prDesc[29] = "La densidad deriva al máximo: la nube se espesa hasta la saturación y se vacía hasta el silencio.";
prDesc[30] = "Matriz de Achorripsis con más voces activas y secciones cortas: textura en mosaico.";
prDesc[31] = "Cuatro voces con ley de Gauss y paseo moderado en la escala acústica: estocástico pero consonante.";
prDesc[32] = "Cage (1951): alturas, ritmos y dinámicas sacados al azar de tablas, como con el I Ching. PR2 en ALEA para los tres parámetros.";
prDesc[33] = "Cage (1951), doce radios: cuatro fuentes independientes que entran y salen por secciones al azar.";
prDesc[34] = "Cage (1952): cientos de fragmentos de cinta empalmados. Granos de todas las duraciones, densos y cortados por secciones.";
prDesc[35] = "Un homenaje a 4'33'': casi todo es silencio. Notas aisladas y suaves que hacen escuchar el espacio entre ellas.";
prDesc[36] = "Cage (1961): notas sacadas de cartas estelares. Puntos aislados, largos y agudos, como estrellas.";
prDesc[37] = "Cage (1983): glissandi lentos sobre un pulso de percusión irregular que nunca cambia de altura.";
prDesc[38] = "Una sola línea melódica que avanza por pasos con intervalos elegidos al azar, como la línea única de Cheap Imitation.";
prDesc[39] = "Cage y Hiller (1969): capas de dados musicales superpuestas. Cuatro voces PR2 independientes y saturadas.";
prDesc[40] = "Cage (1974): las dos manos leen mapas estelares. Puntos dispersos en todo el teclado, con alguna nota en común.";
prDesc[41] = "Los paréntesis temporales de los Number Pieces: notas largas que entran y salen en ventanas flexibles.";
prDesc[42] = "Feldman (1950): notación gráfica de registro (agudo, medio, grave) sin alturas fijas. Muy suave.";
prDesc[43] = "Feldman (1971): acordes suaves y sostenidos, casi inmóviles, con una melodía de viola que aparece de vez en cuando.";
prDesc[44] = "Feldman (1985): figuras que se repiten casi igual durante mucho tiempo, cambiando apenas.";
prDesc[45] = "Earle Brown: una partitura gráfica de rectángulos. Puntos con duración y registro al azar, todos independientes.";
prDesc[46] = "Earle Brown (1961): formas móviles que el director reordena. Bloom con orden al azar y ramas.";
prDesc[47] = "Christian Wolff (1964): los músicos reaccionan unos a otros. Voces cortas que se ajustan armónicamente a todas las demás.";
prDesc[48] = "Stockhausen (1956): fragmentos tocados en el orden que el ojo encuentra. Un tronco de 19 pasos leído al azar.";
prDesc[49] = "Boulez (1957): formantes cuyo orden se permuta. Permutaciones lexicográficas de una serie de 7.";
prDesc[50] = "Lutosławski (1961), aleatorismo controlado: cada instrumento repite su célula a su propio ritmo, sin sincronizar.";
prDesc[51] = "Lutosławski (1964): móviles de células repetidas de longitud distinta, que el conjunto superpone.";
prDesc[52] = "El Musikalisches Würfelspiel atribuido a Mozart (1792): compases elegidos por dados sobre una armonía fija.";
prDesc[53] = "Der allezeit fertige Polonoisen- und Menuettencomponist (1757): danza compuesta por dados, con forma AABA.";
prDesc[54] = "Stockhausen (1959): un percusionista recorre un ciclo de instrumentos. Anillos con lógica XOR y golpes que giran.";
prDesc[55] = "Una forma móvil que va y vuelve, como un móvil de Calder: Bloom en péndulo con ramas que cambian.";
prDesc[56] = "Cardew (1967): una partitura gráfica de líneas continuas. Dos líneas GENDYN lentas y puntos sueltos.";
prDesc[57] = "Cardew (1968), párrafo 7: cada voz elige una nota que oye y la sostiene; nace un coro de notas largas.";
prDesc[58] = "Cage (1961): puntos y líneas sobre transparencias. Valores totalmente uniformes en altura, dinámica y duración.";
prDesc[59] = "Feldman (1986): pequeñas figuras de piano que vuelven una y otra vez, con mínimas variaciones.";
prDesc[60] = "Cada parámetro tira su propio dado: alturas, ritmo y dinámica totalmente al azar (PR2 en ALEA) en cuatro voces.";
prDesc[61] = "La moneda como generador: un registro Turing con BLOQUEO al 50 % es azar puro, bit a bit.";
prDesc[62] = "Seis líneas, como un hexagrama: un registro de 6 bits que cambia algunas líneas en cada lectura.";
prDesc[63] = "Aleatorismo controlado por secciones: el material está fijado, pero cuándo suena cada voz es azar.";
prDesc[64] = "Schoenberg (1923), la primera obra enteramente dodecafónica: la serie en sus cuatro formas, una tras otra.";
prDesc[65] = "Webern (1928): un canon en el que una voz lee la serie y otra la lee al revés (palíndromo).";
prDesc[66] = "Webern (1934): una serie derivada de una célula de tres notas transformada (P, RI, R, I) y transpuesta.";
prDesc[67] = "Webern (1936): simetría en espejo. Una voz toca la serie y otra su inversión, al mismo tiempo.";
prDesc[68] = "Messiaen (1949): cada altura tiene su duración y su dinámica. PR1 en nivel irregular para los tres parámetros.";
prDesc[69] = "Boulez (1952), serialismo integral para dos pianos: serie estricta en alturas, duraciones y dinámicas.";
prDesc[70] = "Stockhausen (1951): registros que se cruzan. Una voz baja mientras la otra sube.";
prDesc[71] = "Stockhausen (1957): tres orquestas con tempos distintos. Tres series con unidades de 1/16, 1/16T y 1/8T.";
prDesc[72] = "Nono (1956): la serie se reparte nota a nota entre las voces (hoquetus puntillista).";
prDesc[73] = "Babbitt: combinaciones de la serie. Hexacordos que se combinan sin repetir sonidos.";
prDesc[74] = "Krenek: la serie rota un paso en cada vuelta y genera sus propias variantes.";
prDesc[75] = "Las interversiones de Chronochromie (1960): permutaciones sucesivas de un orden de valores.";
prDesc[76] = "Koenig (1970), Project 1: alturas casi irregulares, ritmo regular y dinámica intermedia.";
prDesc[77] = "Tres voces PR1 con niveles 2, 4 y 6: de la serie casi estricta al azar casi total.";
prDesc[78] = "Koenig, Project 2: máscaras de tendencia que se abren y se cierran en alturas, ritmo y dinámica.";
prDesc[79] = "Koenig, Project 2: el método GRUPO repite cada valor elegido varias veces seguidas.";
prDesc[80] = "Funciones de control a la manera de Koenig: PR2 con RATIO y SECUENC., ritmo fino y registro amplio.";
prDesc[81] = "Berg (1926): dodecafonismo expresivo con resonancias tonales. Serie en menor armónica, lenta.";
prDesc[82] = "Dallapiccola (1952): un serialismo lírico y cantable, con figuras breves.";
prDesc[83] = "Las tablas de rotación del Stravinsky tardío: hexacordos que rotan y se transponen.";
prDesc[84] = "Una serie de 12 sonidos tocada en forma P, sin transformaciones: el punto de partida de todo.";
prDesc[85] = "Combinaciones de 3 entre 6: el material del hexacordo distribuido en todos sus subconjuntos.";
prDesc[86] = "El estilo de Webern: notas aisladas en registros muy separados, con mucho aire entre ellas.";
prDesc[87] = "Cuatro voces PR1 con niveles mezclados: la textura del serialismo integral de los años 50.";
prDesc[88] = "Ritmo de Messiaen: duraciones irregulares (PR1 ritmo nivel 7) sobre una serie de alturas regular.";
prDesc[89] = "Color y talea de longitudes distintas, como en los motetes isorrítmicos: nota en bucle de 13 y ritmo en bucle de 7.";
prDesc[90] = "Canon del cangrejo, como en la Ofrenda musical de Bach: la misma línea hacia delante y hacia atrás.";
prDesc[91] = "Proporciones de Fibonacci, frecuentes en Nono y Bartók: la palabra de Fibonacci decide los pasos de la melodía.";
prDesc[92] = "Stockhausen (1970): composición por fórmula para dos pianos. La fórmula y su inversión, que se expanden.";
prDesc[93] = "Stockhausen (1975): doce melodías del zodiaco, tonales, para caja de música.";
prDesc[94] = "Stockhausen (1953): puntos que poco a poco se agrupan. PR1 con niveles regulares y grupos.";
prDesc[95] = "Cuatro voces PR2 con métodos distintos: una polifonía serial no estricta.";
prDesc[96] = "Riley (1964): cada músico repite una célula y avanza a la siguiente cuando quiere, sobre un pulso de corcheas en Do.";
prDesc[97] = "Reich (1967): dos pianos con el mismo patrón de 12 notas. Aquí uno tiene 12 pasos y el otro 11, así que se desfasan.";
prDesc[98] = "Reich (1972): el mismo ritmo en dos voces, una desplazada respecto a la otra (aproximación euclídea).";
prDesc[99] = "Reich (1976): acordes pulsados en corcheas y patrones de marimba que se repiten sobre ellos.";
prDesc[100] = "Reich (1971): bongós que se van construyendo por sustitución de silencios, en hoquetus.";
prDesc[101] = "Reich (1987): capas de guitarra en bucle que se encajan entre sí.";
prDesc[102] = "Reich (1973): seis pianos con patrones cortos entrelazados en una escala modal.";
prDesc[103] = "Riley (1969): arpegios modales rápidos de órgano que se superponen y mutan despacio.";
prDesc[104] = "Riley: el acumulador de retardo multiplica una frase en ecos. Aquí, la misma secuencia en tres longitudes.";
prDesc[105] = "Glass: figuras arpegiadas que se alargan y se acortan. Arpegios en tres ritmos euclídeos distintos.";
prDesc[106] = "Glass (1976): arpegios rápidos sin parar y un bajo que cuenta.";
prDesc[107] = "Eno (1978): bucles de cinta de longitudes inconmensurables. Cada voz repite una nota en un ciclo de 19, 23, 29 o 31 pasos.";
prDesc[108] = "Eno (1975): dos frases cortas en bucle, lentas, que se superponen de forma distinta en cada vuelta.";
prDesc[109] = "Eno (1985): piano disperso y lento sobre una nube suave.";
prDesc[110] = "Pärt (1976), tintinnabuli: una voz melódica por grados y otra que solo toca notas de la tríada de la tónica.";
prDesc[111] = "Pärt (1978): arpegios de tresillos en el piano y una melodía que sube y baja por grados.";
prDesc[112] = "Como en Tabula Rasa (Pärt) o los canones de Ockeghem: la misma línea a velocidad x1, x2 y x4.";
prDesc[113] = "Tom Johnson (1982): melodías autosemejantes construidas por reglas. La palabra de Thue-Morse.";
prDesc[114] = "Tom Johnson: contar como proceso musical. Dos anillos euclídeos que suman sus pulsos.";
prDesc[115] = "La Monte Young: nubes de notas tocadas como drones, en un registro estrecho y grave.";
prDesc[116] = "La Monte Young (1958): notas larguísimas que entran y salen lentamente.";
prDesc[117] = "Una secuencia larga que cambia muy poco a poco: la idea de proceso musical gradual de Reich.";
prDesc[118] = "Un arpegio modal que se mueve con la armonía, sobre un bajo y un pad.";
prDesc[119] = "Kotekan balinés: dos voces que se encajan, una en los tiempos y otra en los contratiempos, en escala pelog.";
prDesc[120] = "La técnica medieval del hoquetus: una melodía repartida nota a nota entre dos voces.";
prDesc[121] = "El pulso constante de Riley y Reich: corcheas repetidas en tres registros, con pequeñas variaciones.";
prDesc[122] = "Bucles de longitudes 16, 7, 5 y 3 para disparo, nota, octava y duración: nunca se repite igual.";
prDesc[123] = "Adams (1977): pulsos modales rápidos que cambian de modo por puertas. Patrones en lidio.";
prDesc[124] = "Adams (1978): trémolos y bucles cortos que vibran.";
prDesc[125] = "Ostinatos menores obsesivos al estilo de las bandas sonoras minimalistas: arpegio, bajo y un pad.";
prDesc[126] = "Tom Johnson (1979): nueve campanas tocadas siguiendo recorridos sistemáticos. Permutaciones de 9 sonidos.";
prDesc[127] = "Un patrón empieza casi vacío y se va llenando (y vaciando) por mutación: la técnica de construcción de Drumming.";
prDesc[128] = "Tangerine Dream (1974): un secuenciador de 16 pasos que se repite, mellotrón lento y el filtro que se mueve solo (CC74 en el canal 1).";
prDesc[129] = "Tangerine Dream (1975): una secuencia que muta despacio sobre un drone oscuro.";
prDesc[130] = "Tangerine Dream (1975): secuencia rápida, batería y un solo que improvisa.";
prDesc[131] = "Tangerine Dream (1976): secuencia y guitarra acústica en tresillos, con un pad brillante.";
prDesc[132] = "Tangerine Dream (1979): secuencias en octavas que empujan hacia delante, bajo y solo.";
prDesc[133] = "Klaus Schulze (1975): un bucle de secuenciador muy largo, pads que respiran y un filtro que deriva durante media hora.";
prDesc[134] = "Klaus Schulze (1977): texturas heladas, campanas y glissandi lentos.";
prDesc[135] = "Klaus Schulze (1976): secuenciador y batería en un groove largo.";
prDesc[136] = "Klaus Schulze (1978): secuencias en capas que se cruzan, más rápidas y densas.";
prDesc[137] = "Manuel Göttsching (1984): dos acordes dóricos que alternan durante una hora, pulso y una guitarra que improvisa.";
prDesc[138] = "Ashra (1976): arpegios brillantes y luminosos sobre un pad mayor.";
prDesc[139] = "Subotnick (1967) con el secuenciador Buchla: patrones cromáticos raros, saltarines y en cambio constante.";
prDesc[140] = "Michael Hoenig (1978): secuencias superpuestas de longitudes distintas (polimetría de Kria).";
prDesc[141] = "Moroder (1977): bajo de secuenciador en semicorcheas con saltos de octava, y bombo a negras.";
prDesc[142] = "Kraftwerk (1977): secuencias metálicas y repetitivas, como un tren.";
prDesc[143] = "Jarre (1976): un pad ancho, un arpegio que flota y una melodía cantable.";
prDesc[144] = "Steve Roach (1984): acordes que se transforman con muchísima lentitud.";
prDesc[145] = "La Berlin School oscura de Redshift o Node: secuencia en menor armónica, drone y filtro lento.";
prDesc[146] = "Lo básico de la Berlin School: 16 pasos en bucle y un sample & hold del filtro (CC74) en el mismo canal.";
prDesc[147] = "Línea de TB-303: secuencia con slides y un barrido de filtro errático (CC74) en el mismo canal.";
prDesc[148] = "Pads de mellotrón y un arpegio de órgano: la paleta de la Berlin School temprana.";
prDesc[149] = "Secuencia de bajo con la resonancia (CC71) y el corte (CC74) moviéndose a ritmos distintos.";
prDesc[150] = "Tres secuenciadores de 16, 15 y 13 pasos: los patrones se cruzan y tardan mucho en volver a coincidir.";
prDesc[151] = "Cuatro modulaciones lentas para tus sintes: CC74 y CC71 en el canal 1, CC1 y CC11 en el canal 2.";
prDesc[152] = "Música cósmica alemana: drone, eco de secuenciador y glissandi espaciales.";
prDesc[153] = "Cluster/Harmonia (1974): ostinatos simples y alegres que se repiten como juguetes.";
prDesc[154] = "El ritmo motorik de Neu!: batería recta y un bajo que no para.";
prDesc[155] = "Klaus Schulze: secuencia muy rápida, casi una vibración, con un filtro que respira.";
prDesc[156] = "Una secuencia que cambia sola en cada vuelta y puede bloquearse cuando suena bien (sube BLOQUEO a 100).";
prDesc[157] = "El secuenciador cartesiano de Make Noise aplicado a la Berlin School: rejilla 4×4 recorrida en zigzag.";
prDesc[158] = "Dos secuencias iguales, una en semicorcheas y otra en tresillos, que se desplazan entre sí.";
prDesc[159] = "Acordes largos con la expresión (CC11) y la modulación (CC1) moviéndose como una mano en el teclado.";
prDesc[160] = "Hiller e Isaacson (1957), experimento 1: contrapunto de primera especie generado por reglas, contra un cantus firmus.";
prDesc[161] = "Hiller e Isaacson, experimento 4: cadenas de Markov de orden variable sobre un corpus.";
prDesc[162] = "Laurie Spiegel (1986): un cursor mueve dos pares de voces con reglas de armonía y movimiento contrario.";
prDesc[163] = "Laurie Spiegel (1980, sistema GROOVE): procesos lentos que se despliegan sin prisa.";
prDesc[164] = "La app Bloom (2008): notas que se repiten en bucle y se desvanecen, en escala pentatónica.";
prDesc[165] = "Batuhan Bozkurt (2011): células que rebotan en una rejilla y suenan al chocar con las paredes.";
prDesc[166] = "La regla 30 de Wolfram: caos determinista leído como melodía.";
prDesc[167] = "La regla 90 dibuja el triángulo de Sierpinski: patrones fractales que se repiten y se doblan.";
prDesc[168] = "La regla 110, capaz de computación universal: estructuras que viajan y chocan.";
prDesc[169] = "Cuatro filas de autómatas elementales con reglas consecutivas: cada nacimiento es una nota.";
prDesc[170] = "Nørgård (1968): la serie infinita, una melodía que contiene versiones lentas de sí misma.";
prDesc[171] = "Nørgård (1970): la serie infinita superpuesta a varias velocidades a la vez.";
prDesc[172] = "La serie infinita con intervalo de tercera y ritmo fractal.";
prDesc[173] = "Voss y Clarke (1975): la música se parece al ruido 1/f. Melodía rosa, a medio camino entre azar y paseo.";
prDesc[174] = "Los tres colores de ruido de Voss: blanco (azar), rosa (1/f) y marrón (paseo aleatorio).";
prDesc[175] = "La gramática de Fibonacci (A→AB, B→A): una melodía cuasi periódica que nunca se repite exactamente.";
prDesc[176] = "La sucesión de Thue-Morse: equilibrio perfecto entre subidas y bajadas.";
prDesc[177] = "El polvo de Cantor: sonido y silencio en proporciones fractales.";
prDesc[178] = "Una planta de Lindenmayer convertida en partitura: ramas que suben, vuelven y vuelven a crecer.";
prDesc[179] = "Búsqueda adaptativa de OpenMusic: una frase de 8 notas se corrige sola para cumplir reglas de intervalos y saltos.";
prDesc[180] = "La librería Situation (OpenMusic): acordes con intervalos verticales permitidos y movimiento mínimo.";
prDesc[181] = "Toca una melodía por la entrada MIDI: la cadena de Markov la aprende y la recombina.";
prDesc[182] = "Las voces aprenden unas de otras: un sistema que se escucha a sí mismo.";
prDesc[183] = "La librería Subsequence: grafo de acordes, bajo, melodía y arpegio que se escuchan.";
prDesc[184] = "El René de Make Noise: rejilla 4×4 con relojes X e Y independientes.";
prDesc[185] = "El Kria de monome: cada parámetro con su propio bucle.";
prDesc[186] = "En el espíritu de Orca: líneas de operadores reloj, incremento y azar.";
prDesc[187] = "La Turing Machine de Music Thing Modular: un registro de 16 bits que cambia o se bloquea.";
prDesc[188] = "La Turing Machine con su expansor Pulses: cada bit es una salida de gate.";
prDesc[189] = "El mapa de patrones de Grids (Mutable Instruments) tocando bombo, caja y charles en el canal 10.";
prDesc[190] = "El teclado Samchillian de Leon Gruenbaum: cada nota sale de la anterior por un intervalo, en modo automático.";
prDesc[191] = "El Misha de Eventide: una secuencia de intervalos en ciclo P, R, I y RI.";
prDesc[192] = "Ligeti (1968): patrones de clave rapidísimos de longitudes distintas que se convierten en un continuo.";
prDesc[193] = "Ligeti (1962), 100 metrónomos: pulsos a velocidades distintas que se superponen.";
prDesc[194] = "Ligeti (1961): clusters cromáticos inmóviles que cambian de color muy despacio.";
prDesc[195] = "Ligeti (1967), micropolifonía: líneas que avanzan por semitonos en canon a velocidades distintas.";
prDesc[196] = "Ligeti (1985), estudio n.º 1: la mano derecha en teclas blancas y la izquierda cromática, con acentos que se desplazan.";
prDesc[197] = "Ligeti (1953): cada pieza con un número creciente de alturas. Aquí, una serie de solo 3 sonidos.";
prDesc[198] = "Nancarrow, Studies for Player Piano: la misma línea a tempos 3:4:6.";
prDesc[199] = "Grisey (1975): el espectro armónico de un Mi grave orquestado. Escala acústica (armónicos 8-14) en registros abiertos.";
prDesc[200] = "Scelsi (1959): una sola altura que vibra con microtonos, glissandi mínimos y cambios de intensidad.";
prDesc[201] = "Penderecki (1960): clusters de cuerda y glissandi en bloque.";
prDesc[202] = "Tenney (1974), para Nancarrow: cada voz es un armónico y repite su nota a un ritmo propio.";
prDesc[203] = "Tenney: música ergódica, estadísticamente igual en cualquier momento. Distribución uniforme estacionaria.";
prDesc[204] = "Lucier: notas sostenidas casi iguales cuya pequeña desafinación produce batimientos.";
prDesc[205] = "Pauline Oliveros: drones lentos y profundos para escuchar el espacio.";
prDesc[206] = "Éliane Radigue: un único drone que cambia imperceptiblemente.";
prDesc[207] = "Messiaen (1958): cantos de pájaros, rápidos, agudos y con saltos bruscos.";
prDesc[208] = "Messiaen: el tercer modo de transposición limitada, con acordes y una melodía en él.";
prDesc[209] = "Messiaen (1960): las duraciones como color; capas de ritmo irregular que se superponen.";
prDesc[210] = "Stockhausen (1968): seis voces cantan los armónicos de un Si bemol grave.";
prDesc[211] = "Stockhausen (1960): impulsos que se aceleran hasta ser tono y vuelven a ser ritmo.";
prDesc[212] = "Stockhausen (1956): grupos de impulsos y nubes con densidades y registros que cambian.";
prDesc[213] = "Ferneyhough y la nueva complejidad: densidad extrema, ritmos sin rejilla y dinámicas cambiantes.";
prDesc[214] = "Lachenmann: ruidos y ataques secos con dinámicas extremas.";
prDesc[215] = "Sciarrino: sonidos agudos y frágiles al borde del silencio.";
prDesc[216] = "Saariaho: texturas tímbricas que cambian lentamente de lo ruidoso a lo armónico.";
prDesc[217] = "Radulescu: drones de armónicos que se entrelazan.";
prDesc[218] = "Alturas libres entre los semitonos: nubes MICRO al máximo sobre un drone.";
prDesc[219] = "Ligeti (1969): dos grupos de cuerdas, uno desafinado un cuarto de tono, en figuras que se enredan.";
prDesc[220] = "Kurtág: piezas mínimas, gestos breves rodeados de silencio.";
prDesc[221] = "Varèse (1931): percusión pura, sirenas y golpes con ritmos irregulares.";
prDesc[222] = "Nancarrow, estudio 3a: boogie-woogie para pianola, con un bajo que camina y capas rápidas encima.";
prDesc[223] = "Cowell y Theremin (1931): cada armónico se repite a un ritmo proporcional a su número.";
prDesc[224] = "E(3,8), el tresillo cubano: el ritmo euclídeo más extendido del mundo (Toussaint, 2005).";
prDesc[225] = "E(5,8), el cinquillo cubano, también presente en la música tradicional de África occidental.";
prDesc[226] = "E(5,16), el patrón de la bossa nova brasileña.";
prDesc[227] = "E(7,12), la campana bembé de África occidental y Cuba.";
prDesc[228] = "E(4,9), un ritmo aksak (cojo) de Turquía.";
prDesc[229] = "E(3,4), base de la cumbia y del calipso.";
prDesc[230] = "E(7,16), un patrón de samba brasileña.";
prDesc[231] = "E(3,7), la ruchenitza búlgara.";
prDesc[232] = "E(13,24), un patrón de los pigmeos aka de África central.";
prDesc[233] = "E(5,12), un ritmo de Sudáfrica.";
prDesc[234] = "E(2,5), el ritmo persa khafif-e-ramal.";
prDesc[235] = "E(4,11), el compás de Outside Now de Frank Zappa.";
prDesc[236] = "E(5,11), el compás irregular del Promenade de Cuadros de una exposición (Musorgski).";
prDesc[237] = "E(5,6), el York-Samai de la tradición árabe.";
prDesc[238] = "E(7,8), un ritmo tuareg del Sáhara.";
prDesc[239] = "E(9,16), un patrón de África central.";
prDesc[240] = "E(5,7), el ritmo árabe nawakhat.";
prDesc[241] = "E(11,24), otro patrón de los aka.";
prDesc[242] = "Dos anillos euclídeos combinados: 3 contra 4, el polirritmo más básico.";
prDesc[243] = "5 contra 4, el tipo de polirritmo de los estudios de Ligeti y de Nancarrow.";
prDesc[244] = "Dos anillos combinados con XOR: suena donde golpea uno u otro, pero no los dos.";
prDesc[245] = "Grids en una esquina recta del mapa: bombo a negras, caja en 2 y 4 y charles en corcheas (canal 10).";
prDesc[246] = "Grids hacia la esquina sincopada y con caos: un break que cambia sin parar.";
prDesc[247] = "Euclídeo con repeticiones (ratchets) y armonía, como en el Torso T-1.";
prDesc[248] = "El mismo ritmo en tres voces con rotaciones distintas: el desplazamiento crea el contrapunto.";
prDesc[249] = "Estructura colotómica del gamelan: gong, kenong, kempul y bonang dividen el mismo ciclo en 1, 2, 4 y 8.";
prDesc[250] = "Un ciclo de 8 tiempos como el adi tala del sur de la India, con un ritmo de 3 en 8 encima y un drone.";
prDesc[251] = "Modulación: la Turing Machine como sample & hold del corte del filtro (CC74) en los canales 1 y 2.";
prDesc[252] = "Modulación: dos polígonos GENDYN mueven el corte (CC74) y la resonancia (CC71) del canal 1.";
prDesc[253] = "Modulación: el panorama (CC10) de los cuatro canales se mueve como una partícula browniana.";
prDesc[254] = "Modulación: ruido 1/f en la expresión (CC11) de los canales 1 a 4, como un intérprete humano.";
prDesc[255] = "Modulación: bucles polimétricos de Kria en la rueda de modulación (CC1) y el corte (CC74) del canal 1, con su secuencia.";
