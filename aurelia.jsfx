vcHelp = 62066;
vcHelp[0] = "Enciende o apaga la voz.";
vcHelp[1] = "Canal MIDI por el que sale esta voz.";
vcHelp[2] = "Modo de la voz (14 motores). Al cambiarlo se cargan sus valores iniciales.";
vcHelp[3] = "ESC: cuantiza las alturas a la escala común. Apagado = cromático (y microtonal en GENDYN y MICRO).";
vcHelp[4] = "RIT: cuantiza los ataques y las duraciones a la rejilla común.";
vcHelp[5] = "ARM: limita la distancia armónica con la voz guía (o con todas): cada nota se mueve a la más cercana que cumpla la distancia máxima.";
vcHelp[6] = "Velocidad base.";
vcHelp[7] = "Variación aleatoria de la velocidad.";
vcHelp[8] = "Duración de la nota respecto a su tramo o paso. 100 % o más = legato (necesario para glissandi continuos).";
vcHelp[9] = "Semilla de la voz: la misma semilla da siempre el mismo material.";
vcHelp[10] = "SALIDA: NOTAS manda notas MIDI; CC manda un controlador continuo por el mismo canal. El valor del CC es la altura que habría sonado (0-127, ya ajustada a escala y armonía), así que la voz se convierte en un secuenciador de modulación.";
vcHelp[11] = "Número del controlador MIDI que se envía en modo CC (1 = rueda de modulación, 7 = volumen, 10 = panorama, 11 = expresión, 71 = resonancia, 74 = brillo o corte de filtro). Rueda o flechas para cambiarlo; clic para elegir de la lista.";
gHelp = 62082;
gHelp[0] = "";
gHelp[1] = "RELOJ: HOST sigue el transporte de REAPER; LIBRE usa su propio tempo y suena con el transporte parado; HOST/LIBRE cambia solo.";
gHelp[2] = "Tempo del reloj libre.";
gHelp[3] = "Tónica de la escala común.";
gHelp[4] = "Escala común a la que cuantizan las voces con ESC encendido.";
gHelp[5] = "Rejilla común a la que cuantizan las voces con RIT encendido.";
gHelp[6] = "Fuerza de la cuantización rítmica: 100 % = clavado a la rejilla; menos = solo se acerca.";
gHelp[7] = "Distancia armónica máxima (de Tenney) entre una voz con ARM y su referencia. 0 = solo unísono; 2,6 = hasta la quinta; 4,3 = terceras y sextas; 12 = sin límite. Cada octava suma 1.";
gHelp[8] = "Voz guía: la referencia armónica de las voces con ARM.";
gHelp[9] = "ARM contra: GUÍA = solo contra la voz guía; TODAS = contra la última nota de cada una de las otras voces.";
gHelp[10] = "Rango de pitch bend de tus sintetizadores (para glissandi, microtonos y GENDYN). Debe coincidir con el del sinte.";
gHelp[11] = "Volver al inicio de la secuencia (las mismas notas) cada vez que das play.";
gHelp[12] = "Semilla global: cambia el material aleatorio de las cuatro voces.";
gHelp[13] = "Transposición desde la entrada MIDI: OFF; TRANSPONER = la última nota tocada transporta todo (respecto a REF) y se queda; MANTENER = solo mientras la tecla está pulsada; TÓNICA = la nota cambia la tónica sin cambiar de octava.";
gHelp[14] = "REF: nota de la entrada que no transporta (por defecto C4). Tocar D4 sube todo un tono.";
gHelp[15] = "THRU: deja pasar a la salida el MIDI de la entrada.";
gHelp[16] = "Canal de la entrada MIDI que escucha Aurelia (OMNI = todos).";
vcDefGate = 62103;
vcDefGate[0] = 100;
vcDefGate[1] = 80;
vcDefGate[2] = 60;
vcDefGate[3] = 70;
