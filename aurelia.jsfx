hover(PX + 262, 360, 80, 36) ? strcpy(#help, "Transposición actual que llega de la entrada MIDI (en semitonos). Afecta a las cuatro voces y a la escala.");

// reloj y global
gfx_setfont(5); gfx_set(0.5, 0.5, 0.52, 1); textAt("RELOJ Y SALIDA", PX + 10, 414);
gfx_setfont(3);
toggle(PX + 10, 436, 70, 22, slider1 == 0 ? "HOST" : (slider1 == 1 ? "LIBRE" : "HOST/LIBRE"), 1, 4) ? setSlider(1, (slider1 + 1) % 3);
hover(PX + 10, 436, 70, 22) ? strcpy(#help, gHelp[1]);
sprintf(#k9, "%.1f", slider2); knob(PX + 112, 458, 2, 20, 300, 110, 0.1, "TEMPO", #k9, 4, gHelp[2]);
sprintf(#ka, "±%d st", slider10); knob(PX + 162, 458, 10, 1, 48, 12, 1, "BEND", #ka, 4, gHelp[10]);
sprintf(#kb, "%d", slider12); knob(PX + 212, 458, 12, 0, 999, 0, 1, "SEMILLA", #kb, 4, gHelp[12]);
toggle(PX + 246, 436, 94, 22, slider11 ? "RESET AL PLAY" : "SIN RESET", slider11, 4) ? setSlider(11, !slider11);
hover(PX + 246, 436, 94, 22) ? strcpy(#help, gHelp[11]);

// ayuda
gfx_set(0.08, 0.08, 0.085, 1); gfx_rect(PX + 8, 494, PW - 16, 92);
