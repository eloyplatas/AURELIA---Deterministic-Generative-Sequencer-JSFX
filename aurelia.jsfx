mpHelp = 60470;
mpHelp[0] = "Densidad media de eventos por tiempo. Los intervalos entre notas siguen la ley exponencial (proceso de Poisson), como en la música estocástica de Xenakis.";
mpHelp[1] = "La densidad deriva lentamente con un paseo aleatorio: la nube se espesa y se aclara.";
mpHelp[2] = "Ley de probabilidad de las alturas. LINEAL es la ley de intervalos de Xenakis (los pequeños son más probables); CAUCHY da saltos extremos ocasionales.";
mpHelp[3] = "Parámetro de forma de la ley: cuánto se concentra o cuánta cola tiene.";
mpHelp[4] = "Altura central de la nube.";
mpHelp[5] = "Anchura del registro a cada lado del centro.";
mpHelp[6] = "El centro de la nube se desplaza lentamente por el registro.";
mpHelp[7] = "0 = cada altura es independiente; 100 = cada altura sale de la anterior (paseo aleatorio).";
mpHelp[8] = "Desviación microtonal aleatoria con pitch bend. Solo actúa con ESC apagado.";
mpHelp[9] = "Duración media de las notas (ley exponencial), en tiempos.";
mpHelp[10] = "Notas simultáneas máximas en cada evento.";
mpHelp[11] = "Probabilidad de que una nota llegue en glissando desde la anterior (pitch bend).";
mpHelp[12] = "Arquitectura de Xenakis: duración media de cada sección en compases (ley exponencial). OFF = sin secciones.";
mpHelp[13] = "Probabilidad de que una sección suene; si no, la voz calla toda la sección.";
mpHelp[14] = "";
mpHelp[15] = "";
mpHelp[16] = "Puntos de ruptura del polígono de GENDYN (Xenakis usaba unos 12). Cada punto es una nota del ciclo y su tramo, el tiempo hasta el siguiente.";
mpHelp[17] = "1 = paseo aleatorio simple (S.709, Gendy1). 2 = paseo de segundo orden, como en GENDY3: los pasos mueven una velocidad y la velocidad mueve el punto. Más estable y con inercia.";
mpHelp[18] = "Ley de los pasos de amplitud (altura). Son las seis de Xenakis: lineal, Cauchy, logística, coseno hiperbólico, arcoseno y exponencial.";
mpHelp[19] = "Ley de los pasos de duración de cada tramo.";
mpHelp[20] = "Tamaño de los pasos aleatorios de amplitud.";
mpHelp[21] = "Tamaño de los pasos aleatorios de duración.";
mpHelp[22] = "Parámetro a de las leyes (como adparam/ddparam de Gendy).";
mpHelp[23] = "Barreras reflectantes de la amplitud. Cerrarlas congela la altura. Según Xenakis y Hoffmann, la posición de las barreras es lo que más cambia el resultado.";
mpHelp[24] = "Altura que corresponde a amplitud 0 (el eje del polígono).";
mpHelp[25] = "Semitonos que corresponden a amplitud ±1.";
mpHelp[26] = "Duración mínima de un tramo (barrera inferior del tiempo), en tiempos.";
mpHelp[27] = "Duración máxima de un tramo (barrera superior del tiempo), en tiempos.";
mpHelp[28] = "LIBRE: el ciclo dura lo que sumen los tramos (Gendy1). Con un valor, el ciclo dura esos tiempos y los tramos se reparten como en GENDY3 (frecuencia fija).";
mpHelp[29] = "Interpolación lineal entre puntos con pitch bend, como la forma de onda poligonal de GENDYN. Ajusta el rango de bend igual que en tu sintetizador.";
mpHelp[30] = "Arquitectura: duración media de las secciones en compases (ley exponencial), como las pistas de GENDY3. OFF = suena siempre.";
mpHelp[31] = "Probabilidad de que una sección suene (decisión a cara o cruz por sección).";
mpHelp[32] = "Como el mando grande del Turing Machine: arriba bloquea el bucle, en el centro todo es azar y abajo el bucle se invierte en cada pasada (el doble de largo).";
mpHelp[33] = "Longitud del bucle del registro de desplazamiento.";
mpHelp[34] = "Escala de salida: semitonos que abarca el DAC de 8 bits.";
mpHelp[35] = "Nota más grave.";
mpHelp[36] = "Reloj de la voz: duración de cada paso.";
mpHelp[37] = "Como el expansor Pulses: TODOS = nota en cada paso; BIT n = solo cuando ese bit del registro está a 1.";
mpHelp[38] = "Probabilidad de glissando desde la nota anterior, como un limitador de slew en el CV.";
mpHelp[39] = "";
mpHelp[40] = "";
mpHelp[41] = "";
mpHelp[42] = "";
mpHelp[43] = "";
mpHelp[44] = "";
mpHelp[45] = "";
mpHelp[46] = "";
mpHelp[47] = "";
mpHelp[48] = "Longitud del tronco: la secuencia base de la que nacen las ramas.";
mpHelp[49] = "Ramas que suenan tras el tronco, como en Qu-Bit Bloom. Cada rama deriva de la anterior (transposición, inversión, retrógrado o mutación).";
mpHelp[50] = "Camino por el árbol fractal: en cada nivel se elige la rama izquierda o la derecha. Hay 128 caminos.";
mpHelp[51] = "Cambia notas del tronco al terminar cada vuelta. Es destructivo: 100 = tronco nuevo en cada vuelta. DESHACER recupera el último tronco guardado.";
mpHelp[52] = "Nota raíz de la voz.";
mpHelp[53] = "Rango del tronco en octavas.";
mpHelp[54] = "Orden de reproducción: adelante, atrás, péndulo o al azar.";
mpHelp[55] = "Reloj de la voz: duración de cada paso.";
mpHelp[56] = "Probabilidad de que un paso del tronco sea silencio.";
mpHelp[57] = "Probabilidad de que un paso se repita en ráfaga (ratchet de 2 a 4).";
mpHelp[58] = "Probabilidad de que un paso llegue deslizándose desde el anterior.";
mpHelp[59] = "";
mpHelp[60] = "";
mpHelp[61] = "";
mpHelp[62] = "";
mpHelp[63] = "";
mpHelp[64] = "Duración de cada pantalla, en tiempos. En Analogique A cada pantalla dura media redonda (unos 1,2 s).";
mpHelp[65] = "GTPM: la matriz 8x8 de transición entre pantallas de la obra. ACOPLADO: tres cadenas de dos estados (altura, dinámica, densidad) cuyas matrices alfa/beta elige el estado de otro parámetro, como las definió Xenakis.";
mpHelp[66] = "Perturbación: probabilidad de forzar la pantalla elegida en DESTINO en lugar de seguir la matriz (equilibrio). Solo con PROTOC. apagado.";
mpHelp[67] = "DESTINO: pantalla a la que tiende la perturbación. A = f0 g0 d0 … H = f1 g1 d1 (altura, dinámica, densidad).";
mpHelp[68] = "Protocolo de Xenakis: secciones de 30 pantallas, unas en equilibrio y otras perturbadas hacia una pantalla al azar.";
mpHelp[69] = "Escala la densidad de granos: 100 % = las densidades de la obra (1, 3 o 9 sucesos por celda y pantalla).";
mpHelp[70] = "Transporta las seis regiones de altura de la obra (de E1 a A6) por octavas.";
mpHelp[71] = "5+4+3: los ataques caen en quintillos, cuatrillos o tresillos de la pantalla, como en la obra. LIBRE: en cualquier instante.";
mpHelp[72] = "Duración de las notas largas respecto a la pantalla.";
mpHelp[73] = "Proporción de notas muy cortas, como el col legno frappé de las cuerdas.";
mpHelp[74] = "";
mpHelp[75] = "";
mpHelp[76] = "";
mpHelp[77] = "";
mpHelp[78] = "";
mpHelp[79] = "";
mpHelp[80] = "Qué toca la voz sobre la progresión: acordes con conducción de voces, bajo, melodía o arpegio.";
mpHelp[81] = "Grafo de acordes con pesos: FUNCIONAL (tonal), MODAL (grados vecinos), CROMÁTICO (transformaciones P, L, R y deslizamientos) o PEDAL (siempre vuelve a la tónica).";
mpHelp[82] = "Atracción hacia la tónica: cuanto más alta, más vuelve la progresión al acorde de I.";
mpHelp[83] = "Tiempos que dura cada acorde.";
mpHelp[84] = "LIBRE: cada acorde se genera en vivo. FIJA: una progresión de 4 acordes congelada que se repite. AABA: A congelada y B en vivo.";
mpHelp[85] = "Nota más grave del registro de la voz.";
mpHelp[86] = "Duración de cada paso del ritmo.";
mpHelp[87] = "Golpes del ritmo euclídeo en cada ciclo de 16 pasos. El patrón se reconstruye en cada ciclo.";
mpHelp[88] = "El ritmo se aclara a medida que avanza la sección de 4 acordes (la tensión crece).";
mpHelp[89] = "Inercia melódica de Narmour (para MELODÍA): tras un salto la melodía cambia de dirección; tras un paso pequeño, sigue en la misma.";
mpHelp[90] = "Probabilidad de rotar el ritmo en cada ciclo.";
mpHelp[91] = "Notas por acorde: tríadas o cuatriadas.";
mpHelp[92] = "";
mpHelp[93] = "";
mpHelp[94] = "";
mpHelp[95] = "";
mpHelp[96] = "De dónde aprende: ENTRADA = lo que tocas por la entrada MIDI; VOCES = lo que tocan las otras voces de Aurelia; AZAR = un corpus aleatorio. Sin notas aprendidas usa el corpus al azar.";
mpHelp[97] = "Orden de la cadena de alturas: cuántas notas anteriores mira para decidir la siguiente. Si no encuentra coincidencias, baja de orden.";
mpHelp[98] = "Orden de la cadena de ritmo (duraciones aprendidas). 0 = ritmo fijo con DIV.";
mpHelp[99] = "ABSOLUTO aprende notas; INTERV. aprende intervalos (la melodía puede moverse por todo el registro).";
mpHelp[100] = "Temperatura: probabilidad de saltar a una nota cualquiera del corpus (más exploración).";
mpHelp[101] = "Cuántas notas recientes del corpus se usan.";
mpHelp[102] = "Congela el corpus: deja de aprender y sigue generando con lo aprendido.";
mpHelp[103] = "Paso del ritmo cuando ORDEN R = 0.";
mpHelp[104] = "Transporta lo generado por esta voz.";
mpHelp[105] = "Probabilidad de saltarse una nota.";
mpHelp[106] = "Probabilidad de romper la cadena y empezar en un punto al azar del corpus.";
mpHelp[107] = "";
mpHelp[108] = "";
mpHelp[109] = "";
mpHelp[110] = "";
mpHelp[111] = "";
mpHelp[112] = "PR1 y PR2 son los Project 1 y 2 de G. M. Koenig (1964-66). MISHA lee una serie con formas P/R/I/RI como el secuenciador de Eventide Misha. ROTAR, PERMUTAR y COMBINAR son las operaciones combinatorias de OpenMusic: rotación de la serie, permutaciones en orden lexicográfico y combinaciones.";
mpHelp[113] = "Longitud de la serie de alturas (en grados). 12 con ESC apagado = serie dodecafónica.";
mpHelp[114] = "Forma de la serie en MISHA: P original, R retrógrado, I inversión, RI retrógrado de la inversión; CICLO recorre las cuatro; AZAR elige una en cada vuelta.";
mpHelp[115] = "Desplazamiento en grados que se suma en cada vuelta de la serie (transposición progresiva).";
mpHelp[116] = "PR1: nivel de regularidad de las alturas. 1 = serial y en grupos repetidos; 7 = aleatorio sin repetición inmediata. Koenig movía cada parámetro entre estos 7 niveles.";
mpHelp[117] = "PR1: nivel de regularidad del ritmo (6 valores múltiplos de UNIDAD).";
mpHelp[118] = "PR1: nivel de regularidad de la dinámica (6 niveles).";
mpHelp[119] = "PR2: método de selección de las alturas. ALEA = azar con repetición; SERIE = sin repetir hasta agotar; SECUENC. = en orden; GRUPO = repite grupos; TENDENC. = máscara de tendencia que se abre y se cierra; RATIO = pesos decrecientes.";
mpHelp[120] = "PR2: método de selección del ritmo.";
mpHelp[121] = "PR2: método de selección de la dinámica.";
mpHelp[122] = "Nota más grave del registro de la voz.";
mpHelp[123] = "Octavas de registro por encima de BASE. Las alturas que se salen rebotan dentro.";
mpHelp[124] = "Unidad rítmica. En PR1/PR2 las duraciones son 1 a 6 unidades; en los demás tipos cada nota dura una unidad.";
mpHelp[125] = "Compases que tarda la máscara de tendencia (TENDENC.) en abrirse y cerrarse.";
mpHelp[126] = "Probabilidad de desplazar una nota de octava (registro libre de la serie).";
mpHelp[127] = "Tamaño máximo de los grupos de repetición (niveles regulares de PR1 y método GRUPO de PR2).";
mpHelp[128] = "NØRGÅRD = serie infinita de Per Nørgård (autosemejante: cada 2, 4, 8 notas reaparece la serie entera). 1/F = ruido rosa de Voss, a medio camino entre azar y paseo. L-SYSTEM = gramáticas de Lindenmayer que se reescriben a sí mismas.";
mpHelp[129] = "Intervalo de la serie de Nørgård, en grados (1 en escala = la serie diatónica; con ESC apagado y 1, la cromática original).";
mpHelp[130] = "Punto de entrada en la serie infinita.";
mpHelp[131] = "1/F: número de dados de Voss. Más dados = más memoria a largo plazo y más registro.";
mpHelp[132] = "1/F: mezcla de ruido blanco (azar puro).";
mpHelp[133] = "L-SYSTEM: FIBONACCI (A→AB, B→A), THUE-MORSE (A→AB, B→BA), CANTOR (sonido/silencio A→ABA, B→BBB) y PLANTA (ramificación con pila, de Lindenmayer).";
mpHelp[134] = "Generaciones de reescritura de la gramática.";
mpHelp[135] = "Grados que sube (A, +) o baja (B, −) cada símbolo.";
mpHelp[136] = "Nota más grave del registro de la voz.";
mpHelp[137] = "Octavas de registro por encima de BASE. Las alturas que se salen rebotan dentro.";
mpHelp[138] = "Paso del ritmo.";
mpHelp[139] = "Probabilidad de alargar la nota 2 o 3 veces según otra lectura de la serie de Nørgård (ritmo autosemejante).";
mpHelp[140] = "Probabilidad de que cada paso suene.";
mpHelp[141] = "";
mpHelp[142] = "";
mpHelp[143] = "";
mpHelp[144] = "OTOMATA: células que viajan por una rejilla de 9×9; al chocar con una pared suenan y dan la vuelta, y al cruzarse giran. ECA-256: cuatro autómatas elementales de 8 células; cada nacimiento es una nota. WOLFRAM: una fila de 16 células cuyo estado se lee como altura.";
mpHelp[145] = "Regla de Wolfram (0-255). 30 = caos, 90 = Sierpinski, 110 = complejidad, 184 = tráfico.";
mpHelp[146] = "ECA-256: cada fila usa REGLA + fila × VARIA.";
mpHelp[147] = "OTOMATA: número de células en la rejilla.";
mpHelp[148] = "Densidad de células vivas al resembrar un autómata que se ha extinguido.";
mpHelp[149] = "Probabilidad de cambiar una célula al azar en cada paso (evita los ciclos muertos).";
mpHelp[150] = "Notas simultáneas máximas por paso.";
mpHelp[151] = "WOLFRAM: BINARIA = el centro de la fila como número binario; CUENTA = número de células vivas; CENTRO = suena solo si la célula central está viva.";
mpHelp[152] = "Nota más grave del registro de la voz.";
mpHelp[153] = "Octavas de registro por encima de BASE. Las alturas que se salen rebotan dentro.";
mpHelp[154] = "Paso del autómata.";
mpHelp[155] = "";
mpHelp[156] = "";
mpHelp[157] = "";
mpHelp[158] = "";
mpHelp[159] = "";
mpHelp[160] = "RENÉ (Make Noise): secuenciador cartesiano 4×4 con relojes X e Y y páginas Z. KRIA (monome): cada parámetro tiene su propio bucle de longitud distinta. ORCA (Hundred Rabbits): líneas de operadores reloj (D), incremento (I) y azar (R).";
mpHelp[161] = "Paso del reloj X (el principal).";
mpHelp[162] = "RENÉ: reloj Y independiente (en RECORRIDO = RELOJ XY).";
mpHelp[163] = "RENÉ: cómo se mueve el cursor por la rejilla: por FILAS, en ZIGZAG, con dos RELOJES X/Y independientes, en DIAGONAL o al AZAR (paso a paso).";
mpHelp[164] = "RENÉ: páginas Z de 16 celdas que se recorren una tras otra.";
mpHelp[165] = "RENÉ y KRIA: proporción de celdas que tienen el disparo activado.";
mpHelp[166] = "Probabilidad de cambiar una celda (o, en ORCA, de que la línea dé una nota al azar).";
mpHelp[167] = "Nota más grave del registro de la voz.";
mpHelp[168] = "Octavas de registro por encima de BASE. Las alturas que se salen rebotan dentro.";
mpHelp[169] = "KRIA: longitud del bucle de disparos.";
mpHelp[170] = "KRIA: longitud del bucle de notas.";
mpHelp[171] = "KRIA: longitud del bucle de octavas.";
mpHelp[172] = "KRIA: longitud del bucle de duraciones.";
mpHelp[173] = "ORCA: número de líneas de operadores.";
mpHelp[174] = "Probabilidad de que cada disparo suene.";
mpHelp[175] = "";
mpHelp[176] = "TOUSSAINT: ritmo euclídeo E(k,n) (Toussaint 2005); un segundo anillo decide cuándo avanza la melodía. T-1: como el Torso T-1, euclídeo con repeticiones, armonía y caos. GRIDS: mapa de baterías de Mutable Instruments. ANULAR: dos anillos combinados con lógica, como en Hemisphere.";
mpHelp[177] = "Pasos del anillo A.";
mpHelp[178] = "Golpes repartidos lo más uniformemente posible en el anillo A.";
mpHelp[179] = "Rotación del anillo A.";
mpHelp[180] = "Pasos del anillo B (avance de melodía en TOUSSAINT; segundo ritmo en ANULAR).";
mpHelp[181] = "Golpes del anillo B.";
mpHelp[182] = "ANULAR: cómo se combinan los anillos. OR, AND, XOR; A→NOTA = A da el ritmo y B sube la octava.";
mpHelp[183] = "GRIDS: posición X en el mapa de patrones.";
mpHelp[184] = "GRIDS: posición Y en el mapa de patrones.";
mpHelp[185] = "GRIDS: densidad de los tres carriles.";
mpHelp[186] = "GRIDS y T-1: perturbación aleatoria de los golpes, las notas y las velocidades.";
mpHelp[187] = "Notas de la melodía. En GRIDS, 1 = notas de batería GM (36 bombo, 38 caja, 42 charles; apaga ESC y ARM).";
mpHelp[188] = "T-1: repeticiones (ratchet) de cada golpe.";
mpHelp[189] = "Nota más grave del registro de la voz.";
mpHelp[190] = "Paso del anillo.";
mpHelp[191] = "T-1: notas por golpe apiladas en terceras.";
mpHelp[192] = "OMCLOUDS (OpenMusic): una frase que se corrige sola buscando la que viole menos reglas. SITUATION: acordes que cumplen reglas verticales y horizontales. CONTRAP.: contrapunto de primera especie contra la voz guía (como las restricciones de bach/cage). MUS.MOUSE (Laurie Spiegel): un cursor mueve dos pares de voces con reglas de armonía y movimiento.";
mpHelp[193] = "OMCLOUDS: longitud de la frase.";
mpHelp[194] = "OMCLOUDS: correcciones por vuelta de la frase. Pocas = la frase evoluciona despacio hacia las reglas.";
mpHelp[195] = "Intervalos permitidos (en grados): 2ª/3ª, solo 3ª, solo 4ª o LIBRE. En SITUATION es el intervalo vertical entre voces.";
mpHelp[196] = "OMCLOUDS: notas anteriores que no se pueden repetir.";
mpHelp[197] = "Salto máximo en grados (horizontal).";
mpHelp[198] = "Temperatura: perturbación aleatoria que impide que la solución se quede fija.";
mpHelp[199] = "Nota más grave del registro de la voz.";
mpHelp[200] = "Octavas de registro por encima de BASE. Las alturas que se salen rebotan dentro.";
mpHelp[201] = "Paso del ritmo.";
mpHelp[202] = "SITUATION y MUS.MOUSE: voces del acorde.";
mpHelp[203] = "MUS.MOUSE: velocidad del cursor.";
mpHelp[204] = "MUS.MOUSE: movimiento entre los dos pares de voces: PARALELO, CONTRARIO u OBLICUO.";
mpHelp[205] = "CONTRAP.: contrapunto ENCIMA o DEBAJO de la voz guía, o LIBRE desde BASE.";
mpHelp[206] = "MUS.MOUSE: tocar el ACORDE o arpegiarlo.";
mpHelp[207] = "";
mpHelp[208] = "MISHA: secuencia de intervalos (no de notas) leída con formas P/R/I/RI, como el Eventide Misha. SAMCHILL: como el teclado Samchillian, cada tecla es un intervalo desde la nota anterior.";
mpHelp[209] = "AUTO: los intervalos los genera Aurelia. ENTRADA: los tocas tú; cada tecla es un intervalo respecto a REF (D4 = sube un tono). MISHA los graba en su secuencia; SAMCHILL los toca al momento. Pon TRANSPOSICIÓN en OFF.";
mpHelp[210] = "MISHA: longitud de la secuencia de intervalos.";
mpHelp[211] = "MISHA: forma de lectura (P, R, I, RI, CICLO, AZAR).";
mpHelp[212] = "MISHA: intervalo extra al empezar cada vuelta (la secuencia deriva).";
mpHelp[213] = "SAMCHILL: intervalo máximo, en grados.";
mpHelp[214] = "SAMCHILL: preferencia por los intervalos pequeños.";
mpHelp[215] = "Al salir del registro: REBOTE (vuelve hacia dentro) o ENVOLVER (reaparece por el otro extremo).";
mpHelp[216] = "Nota más grave del registro de la voz.";
mpHelp[217] = "Octavas de registro por encima de BASE. Las alturas que se salen rebotan dentro.";
mpHelp[218] = "Paso del ritmo.";
mpHelp[219] = "Probabilidad de que cada paso suene (el intervalo se acumula igualmente).";
mpHelp[220] = "Probabilidad de desplazar una nota de octava.";
mpHelp[221] = "";
mpHelp[222] = "";
mpHelp[223] = "";
