// ---------- MEMORIAS (barra inferior) ----------
// clic corto o tecla 1-0 = recuperar · mantener 0,6 s = guardar
HOLD_T = 0.6;
function memSave(m) local(b, i)(
  b = MEM + m*MEMSTRIDE; b[0] = 1; i = 1; loop(140, b[i] = slider(i); i += 1;); memFlash[m] = nowT;
);
function memRecall(m) local(b, i)(
  b = MEM + m*MEMSTRIDE;
  b[0] ? ( i = 1; loop(140, (i <= 12 || i >= 21) ? setSlider(i, b[i]); i += 1;); curMem = m; );
);
memFlash = 68000;
while ((kch = gfx_getchar()) > 0) ( kch >= 48 && kch <= 57 ? memRecall(kch == 48 ? 9 : kch - 49); );
holdSrc ? (
  mouse_cap & 1 ? ( !holdDone && nowT - holdT >= HOLD_T ? ( memSave(holdSlot); holdDone = 1; ); )
                : ( !holdDone ? memRecall(holdSlot); holdSrc = 0; );
);
memBarY = 606; memBtnW = 76; memBtnX0 = 110;
gfx_set(0.115, 0.115, 0.125, 1); gfx_rect(12, memBarY - 4, 1256, 42);
gfx_setfont(2); gfx_set(0.5, 0.5, 0.52, 1); textAt("MEMORIA", 24, memBarY + 9);
gm = 0;
loop(NMEM,
  bx = memBtnX0 + gm*(memBtnW + 6);
  hv = hover(bx, memBarY, memBtnW, 34);
  hv ? strcpy(#help, "Memorias: clic (o teclas 1–0) para recuperar; mantén pulsado 0,6 s para guardar el estado completo de Aurelia.");
  hv && clickL ? ( holdSrc = 1; holdSlot = gm; holdT = nowT; holdDone = 0; );
  used = MEM[gm*MEMSTRIDE];
  holding = holdSrc && holdSlot == gm && !holdDone;
  flash = max(0, 1 - (nowT - memFlash[gm]) / 0.8);
  gm == curMem && used ? gfx_set(0.95, 0.80, 0.45, 0.95) : (used ? gfx_set(0.33, 0.28, 0.17, 1) : gfx_set(0.16, 0.16, 0.17, 1));
  gfx_rect(bx, memBarY, memBtnW, 34);
  hv ? ( gfx_set(1, 1, 1, 0.08); gfx_rect(bx, memBarY, memBtnW, 34); );
  holding ? ( gfx_set(1, 1, 1, 0.35); gfx_rect(bx, memBarY + 30, memBtnW*min(1, (nowT - holdT)/HOLD_T), 4); );
  flash > 0 ? ( gfx_set(1, 1, 1, 0.6*flash); gfx_rect(bx, memBarY, memBtnW, 34); );
  frame(bx, memBarY, memBtnW, 34);
  gfx_setfont(1);
  gm == curMem && used ? gfx_set(0.08, 0.08, 0.08, 1) : (used ? gfx_set(0.95, 0.95, 0.95, 1) : gfx_set(0.45, 0.45, 0.48, 1));
  textC(gm == 9 ? "0" : sprintf(#mn, "%d", gm + 1), bx + memBtnW/2, memBarY + 3);
  gfx_setfont(3);
  flash > 0 ? ( gfx_set(1, 1, 1, 1); textC("GUARDADA", bx + memBtnW/2, memBarY + 19); ) : (
    used ? ( gm == curMem ? gfx_set(0.1, 0.1, 0.1, 1) : gfx_set(0.7, 0.7, 0.72, 1); textC("recuperar", bx + memBtnW/2, memBarY + 19); )
         : ( gfx_set(0.38, 0.38, 0.40, 1); textC("vacía", bx + memBtnW/2, memBarY + 19); ) );
  gm += 1;);
gfx_setfont(3); gfx_set(0.45, 0.45, 0.48, 1);
textAt("clic / tecla 1-0: recuperar", 940, memBarY + 3);
textAt("mantener 0,6 s: guardar", 940, memBarY + 18);

lastCap = mouse_cap;

// ---- volcar el buffer a la ventana, reescalado y centrado ----
gfx_dest = -1;
gfx_set(0.06, 0.06, 0.065, 1);
gfx_rect(0, 0, gfx_w, gfx_h);
gfx_set(1, 1, 1, 1);
gfx_blit(UI_BUF, 1, 0, 0, 0, UI_W, UI_H, uiOffX, uiOffY, UI_W*uiScale, UI_H*uiScale);

