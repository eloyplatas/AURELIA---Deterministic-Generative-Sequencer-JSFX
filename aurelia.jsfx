gfx_setfont(3);
toggle(PX + 10, 362, 88, 22, slider13 == 0 ? "TRANSP OFF" : (slider13 == 1 ? "TRANSPONER" : (slider13 == 2 ? "MANTENER" : "TÓNICA")), slider13 > 0, 4) ? setSlider(13, (slider13 + 1) % 4);
hover(PX + 10, 362, 88, 22) ? strcpy(#help, gHelp[13]);
knob(PX + 126, 380, 14, 24, 96, 60, 1, "REF", noteName(slider14), 4, gHelp[14]);
slider16 < 1 ? strcpy(#kc, "OMNI") : sprintf(#kc, "ch %d", slider16); knob(PX + 176, 380, 16, 0, 16, 0, 1, "CANAL", #kc, 4, gHelp[16]);
toggle(PX + 204, 362, 52, 22, "THRU", slider15, 4) ? setSlider(15, !slider15);
hover(PX + 204, 362, 52, 22) ? strcpy(#help, gHelp[15]);
gfx_setfont(2); slider13 > 0 && gTr != 0 ? chColor(4, 1) : gfx_set(0.45, 0.45, 0.48, 1);
gTr > 0 ? sprintf(#ktr, "+%d st", gTr) : sprintf(#ktr, "%d st", gTr);
textC(#ktr, PX + 302, 364);
