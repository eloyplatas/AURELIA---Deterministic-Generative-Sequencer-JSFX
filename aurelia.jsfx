mDivK = 24700; mDivK[0]=-1; mDivK[1]=-1; mDivK[2]=4; mDivK[3]=7; mDivK[4]=-1; mDivK[5]=6; mDivK[6]=-1;
mDivK[7]=12; mDivK[8]=10; mDivK[9]=10; mDivK[10]=1; mDivK[11]=14; mDivK[12]=9; mDivK[13]=10;
// arrays por voz (desplazamientos)
