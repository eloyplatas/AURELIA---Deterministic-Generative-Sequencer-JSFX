  sprintf(#k1, "%d", slider(vb0 + 6)); knob(x0 + 28, 560, vb0 + 6, 1, 127, 96, 1, "VEL", #k1, gc, vcHelp[6]);
  sprintf(#k2, "%d%%", slider(vb0 + 7)); knob(x0 + 84, 560, vb0 + 7, 0, 100, 20, 1, "DIN", #k2, gc, vcHelp[7]);
  sprintf(#k3, "%d%%", slider(vb0 + 8)); knob(x0 + 140, 560, vb0 + 8, 5, 200, 80, 1, "GATE", #k3, gc, vcHelp[8]);
  sprintf(#k4, "%d", slider(vb0 + 9)); knob(x0 + 196, 560, vb0 + 9, 0, 999, gc + 1, 1, "SEMILLA", #k4, gc, vcHelp[9]);
  gc += 1;
);

// ---------- panel derecho ----------
PX = 920; PW = 348;
gfx_set(0.115, 0.115, 0.125, 1); gfx_rect(PX, 46, PW, 548);
chColor(4, 1); gfx_rect(PX, 46, PW, 3);
gfx_setfont(3); gfx_set(0.5, 0.5, 0.52, 1); textAt("PARTITURA  (últimos 8 tiempos)", PX + 10, 54);
SX = PX + 8; SY = 70; SW = PW - 16; SH = 110;
gfx_set(0.08, 0.08, 0.085, 1); gfx_rect(SX, SY, SW, SH);
gi = 0; loop(9, gfx_set(0.16, 0.16, 0.18, 1); gfx_rect(SX + SW - (curBeat - floor(curBeat) + gi)/8*SW, SY, 1, SH); gi += 1;);
gi = 0; loop(8, gfx_set(0.14, 0.14, 0.16, 1); gfx_rect(SX, SY + SH - (gi*12 + 12)/96*SH, SW, 1); gi += 1;);
gi = 0; ne = min(evN, 512);
loop(ne,
  bt = evN - 1 - gi; bt = bt - floor(bt/512)*512;
  evT[bt] + evD[bt] > curBeat - 8 ? (
    xx = SX + SW - (curBeat - evT[bt])/8*SW; yy = SY + SH - (evP[bt] - 24)/96*SH;
    xs = max(SX, xx); xe = min(SX + SW, xx + max(2/SW*8, evD[bt])/8*SW);
    xe > xs && yy > SY && yy < SY + SH ? ( chColor(evV[bt], 0.35 + 0.65*evVel[bt]/127); gfx_rect(xs, yy - 1, xe - xs, 3); );
  );
  gi += 1;);
hover(SX, SY, SW, SH) ? strcpy(#help, "Las cuatro voces en los últimos 8 tiempos (C1 a C9). Cada color es una voz; el brillo es la velocidad.");

// escala
gfx_setfont(5); gfx_set(0.5, 0.5, 0.52, 1); textAt("ESCALA", PX + 10, 190);
sprintf(#k5, "%s", nmNote[max(0, min(11, slider3))]); knob(PX + 30, 232, 3, 0, 11, 0, 1, "TÓNICA", #k5, 4, gHelp[3]);
r = selector(PX + 58, 214, PW - 68, nmScl[max(0, min(26, slider4))], 4);
hover(PX + 58, 214, PW - 68, 20) ? strcpy(#help, gHelp[4]);
r == -1 ? setSlider(4, (slider4 + 26) % 27);
r == 1 ? setSlider(4, (slider4 + 1) % 27);
r == 2 ? ( listMenu(nmScl, 27, slider4); rr = popup(PX + 73, 234); rr > 0 ? setSlider(4, rr - 1); );
// teclado: escala transpuesta (gris) y última nota de cada voz (color)
KX = PX + 58; KW = (PW - 68)/12;
gi = 0;
loop(12,
  rel = gi - rootEff; rel -= floor(rel/12)*12; inS = 0; gk = 0; loop(scn, soff[gk] == rel ? (inS = 1); gk += 1;);
  inS ? gfx_set(0.34, 0.34, 0.40, 1) : gfx_set(0.14, 0.14, 0.16, 1);
  gfx_rect(KX + gi*KW + 1, 240, KW - 2, 10);
  gk = 0; loop(4, lastOK[gk] && slider(21 + gk*30) && (lastNote[gk] - floor(lastNote[gk]/12)*12) == gi ? ( chColor(gk, 1); gfx_rect(KX + gi*KW + 1 + gk*(KW - 2)/4, 240, (KW - 2)/4, 10); ); gk += 1;);
  gi += 1;);
hover(KX, 240, PW - 68, 10) ? strcpy(#help, "Escala que suena (gris, ya transpuesta por la entrada MIDI) y última nota de cada voz (en su color).");

// ritmo y armonía
