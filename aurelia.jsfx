prN = 62903;
prN[0] = 256;
prN[1] = 8;

// ======================= utilidades =======================
function pmod(a b) ( a - floor(a/b)*b; );
function clamp(x lo hi) ( x < lo ? lo : (x > hi ? hi : x); );
function mirror(x lo hi) local(i)
( hi - lo < 0.0000001 ? (lo + hi)*0.5 : (
    i = 0; while ((x < lo || x > hi) && i < 64) ( x < lo ? (x = 2*lo - x) : (x = 2*hi - x); i += 1; );
    clamp(x, lo, hi); ); );
function vp(c k) local(ad) ( ad = prmv + c*40 + k; ad[0]; );
function vbase(c) ( 40000 + c*1000; );
function sget(c i) local(ad) ( ad = 34000 + c*100 + i; ad[0]; );
function sset(c i v) local(ad) ( ad = 34000 + c*100 + i; ad[0] = v; );
// parámetro de modo k de la voz c, limitado al rango de su modo actual
function mpv(c k) local(m i) ( m = clamp(vp(c,V_MODE),0,13); i = m*16 + k; clamp(vp(c, 10 + k), mpMin[i], mpMax[i]); );

// PRNG Park-Miller determinista por voz (0..3) y global (4)
function rnd(t) local(x ad)
( ad = rsg + t; x = ad[0]*16807; x -= floor(x/2147483647)*2147483647; x < 1 ? (x = 1); ad[0] = x; x/2147483647; );
function rndi(t n) ( floor(rnd(t)*n); );
function seedrng(t s) local(ad) ( ad = rsg + t; ad[0] = 1 + pmod(s*48271 + 12345 + t*99991, 2147483645); rnd(t); rnd(t); );
function gauss(t) local(u v) ( u = max(rnd(t), 0.000000001); v = rnd(t); sqrt(-2*log(u))*cos(2*$pi*v); );
function hash(x) local(s) ( s = sin(pmod(x, 100000)*12.9898 + 78.233)*43758.5453; s - floor(s); );

// leyes de GENDYN (las de Gendy1 de SuperCollider, a partir de Xenakis): devuelven aprox. [-1, 1]
function gdist(which a f) local(c tmp)
( a = clamp(a, 0.0001, 1); f = clamp(f, 0.000001, 0.999999); tmp = 2*f - 1;
  which == 1 ? ( c = atan(10*a); tmp = (1/(10*a))*tan(c*(2*f - 1)); );
  which == 2 ? ( c = 0.5 + 0.499*a; c = log((1 - c)/c); f = (f - 0.5)*0.998*a + 0.5; tmp = log((1 - f)/f)/c; );
  which == 3 ? ( c = tan(1.5692255*a); tmp = tan(1.5692255*a*f)/c; tmp = log(tmp*0.999 + 0.001)*(-0.1447648); tmp = 2*tmp - 1; );
  which == 4 ? ( c = sin(1.5707963*a); tmp = sin($pi*(f - 0.5)*a)/c; );
  which == 5 ? ( c = log(1 - 0.999*a); tmp = log(1 - f*0.999*a)/c; tmp = 2*tmp - 1; );
  tmp; );
// leyes del modo estocástico
function xdist(c ley a) local(u s)
( u = rnd(c);
  ley == 0 ? 2*u - 1 : (
  ley == 1 ? ( s = rnd(c) < 0.5 ? -1 : 1; s*(1 - sqrt(u)); ) : (       // ley lineal de intervalos de Xenakis
  ley == 2 ? clamp(gauss(c)*(0.12 + a*0.5), -3, 3) :
             gdist(ley - 2, a, u) ) ); );

// ======================= escala y armonía =======================
function loadScale() local(bk i)
( bk = sct + clamp(gScale,0,26)*13; scn = bk[0]; i = 0; loop(scn, soff[i] = bk[1 + i]; i += 1;); );
function inScale(n) local(rel i f)
( rel = pmod(n - gRoot, 12); f = 0; i = 0; loop(scn, soff[i] == rel ? (f = 1); i += 1;); f; );
// escala con la transposición de la entrada MIDI aplicada (para la altura final)
function inScaleR(n) local(rel i f)
( rel = pmod(n - rootEff, 12); f = 0; i = 0; loop(scn, soff[i] == rel ? (f = 1); i += 1;); f; );
function snapScale(n) local(d r)
( r = n; d = 0;
  while (d <= 6) ( inScaleR(n + d) ? ( r = n + d; d = 99; ) : ( inScaleR(n - d) ? ( r = n - d; d = 99; ) : (d += 1); ); );
  r; );
// avanza k grados de la escala (sin transponer) desde p
function scaleWalk(p k) local(st g)
( st = k < 0 ? -1 : 1; loop(abs(k), p += st; g = 0; while (!inScale(p) && g < 12) ( p += st; g += 1; ); ); p; );
function hdOf(a b) local(iv) ( iv = abs(a - b); hdTab[pmod(iv, 12)] + floor(iv/12); );
// mueve n a la nota más cercana cuya distancia armónica con las referencias no supere gHD
function harmSnap(c n esc) local(g nref r0 r1 r2 r3 j d k m ok worst bestW best bn)
( nref = 0; best = n; g = clamp(gGuide - 1, 0, 3);
  gContra == 0 ? (
    (g != c && lastOK[g]) ? ( r0 = lastNote[g]; nref = 1; );
  ) : (
    j = 0; loop(4, (j != c && lastOK[j] && vp(j,V_ON)) ? ( nref == 0 ? (r0 = lastNote[j]) : (nref == 1 ? (r1 = lastNote[j]) : (r2 = lastNote[j])); nref += 1; ); j += 1;);
  );
  nref == 0 ? n : (
    bn = n; bestW = 1000; d = 0;
    while (d <= 12) (
      k = 0;
      loop(d == 0 ? 1 : 2,
        m = k == 0 ? n + d : n - d;
        (!esc || inScaleR(m)) ? (
          worst = hdOf(m, r0); nref > 1 ? (worst = max(worst, hdOf(m, r1))); nref > 2 ? (worst = max(worst, hdOf(m, r2)));
          worst <= gHD + 0.0001 ? ( bn = m; d = 99; k = 2; ) : ( worst < bestW ? ( bestW = worst; best = m; ); );
        );
        k += 1;);
      d += 1;
    );
    d >= 99 ? bn : best;
  ); );
// altura final: escala, armonía; deja en g_micro la fracción microtonal (semitonos)
function finalize(c pf) local(n esc)
( esc = vp(c,V_ESC); g_micro = 0; pf += gTr;
  esc ? ( n = snapScale(floor(pf + 0.5)); ) : ( n = floor(pf + 0.5); g_micro = pf - n; );
  (vp(c,V_ARM) && !(gContra == 0 && c == clamp(gGuide-1,0,3))) ? ( n = harmSnap(c, n, esc); );
  n = clamp(n, 0, 127); n; );

// ======================= salida MIDI =======================
function qpush(tm st d1 d2) ( qn < 4900 ? ( qut[qn] = tm; qus[qn] = st; qud1[qn] = d1; qud2[qn] = d2; qn += 1; ); );
function bendAt(tm ch semis) local(bv)
( bv = clamp(floor(8192 + semis/max(1,gBendR)*8192 + 0.5), 0, 16383); qpush(tm, 0xE0|ch, bv & 127, (bv >> 7) & 127); );
function logEv(c bt p d v) local(i)
( i = pmod(evN, 512); evT[i] = bt; evP[i] = p; evD[i] = d; evV[i] = c; evVel[i] = v; evN += 1; );
function qTime(c t) local(g tg)
( vp(c,V_RIT) ? ( g = divt[clamp(gGrid,0,16)]; tg = floor(t/g + 0.5)*g; t + (tg - t)*gQ/100; ) : t; );
function qDur(c d) local(g dg)
( vp(c,V_RIT) ? ( g = divt[clamp(gGrid,0,16)]; dg = max(g, floor(d/g + 0.5)*g); d + (dg - d)*gQ/100; ) : d; );
// toca una nota. gm: 0 sin glissando, 1 llega deslizándose desde la nota anterior, 2 sale deslizándose hacia gto
function playNote(c t pf d vel gm gto gdur) local(tq dq n mic s0 s1 ch v0 v1 nt gq)
( tq = qTime(c, t); tq < bStart ? ( vp(c,V_RIT) ? ( gq = divt[clamp(gGrid,0,16)]; tq += gq*ceil((bStart - tq)/gq - 0.0000001); ) : (tq = bStart); ); dq = qDur(c, d);
  n = finalize(c, pf); mic = g_micro;
  v0 = mic; v1 = mic;
  gm == 1 && lastOK[c] ? ( v0 = lastPF[c] - n; );
  gm == 2 ? ( nt = finalize(c, gto); v1 = nt + g_micro - n; g_micro = mic; );
  v0 = clamp(v0, -gBendR, gBendR); v1 = clamp(v1, -gBendR, gBendR);
  ch = clamp(vp(c,V_CH) - 1, 0, 15);
  s0 = absS + (tq - bStart)*spb;
  vp(c,V_CC) ? (
    // salida CC: la altura (0-127, ya cuantizada) se convierte en el valor del controlador; no hay nota ni pitch bend
    qpush(s0, 0xB0|ch, clamp(floor(vp(c,V_CCN)), 0, 127), n);
  ) : (
  s1 = s0 + max(dq*spb*vp(c,V_GATE)/100, srate*0.005);
  (bendUsed[c] || v0 != 0 || v1 != 0) ? ( bendAt(s0, ch, v0); bendUsed[c] = (v0 != 0 || v1 != 0); );
  v1 != v0 ? ( rS0[c] = s0; rS1[c] = s0 + max(gdur, 0.01)*spb; rV0[c] = v0; rV1[c] = v1; rAct[c] = 1; ) : ( rAct[c] = 0; );
  qpush(s0, 0x90|ch, n, clamp(floor(vel), 1, 127)); qpush(s1, 0x80|ch, n, 0);
  );
  lastNote[c] = n; lastOK[c] = 1; lastPF[c] = n + mic;
  hitTime[c] = time_precise(); hitVel[c] = vel;
  logEv(c, tq, n + mic, dq, vel); );
function velOf(c) ( clamp(floor(vp(c,V_VEL) + (rnd(c)*2 - 1)*vp(c,V_DIN)/100*64), 1, 127); );
function prio(st) local(h) ( h = st & 0xF0; h == 0x80 ? 0 : (h == 0xE0 ? 1 : 2); );
function sendEv(ofs st d1 d2) local(h ch idx)
( h = st & 0xF0; ch = st & 15; idx = ch*128 + d1;
  h == 0x90 ? ( nct[idx] > 0 ? midisend(ofs, 0x80|ch, d1, 0); nct[idx] += 1; midisend(ofs, st, d1, d2); ) : (
  h == 0x80 ? ( nct[idx] -= 1; nct[idx] <= 0 ? ( nct[idx] = 0; midisend(ofs, st, d1, 0); ); ) :
              ( midisend(ofs, st, d1, d2); ) ); );
function processQueue(bs bl) local(i w nd j t1 t2 t3 t4 key ofs)
( nd = 0; w = 0; i = 0;
  loop(qn,
    (qut[i] < bs + bl && nd < 990) ? ( dut[nd] = qut[i]; dus[nd] = qus[i]; dud1[nd] = qud1[i]; dud2[nd] = qud2[i]; nd += 1; )
    : ( qut[w] = qut[i]; qus[w] = qus[i]; qud1[w] = qud1[i]; qud2[w] = qud2[i]; w += 1; );
    i += 1;);
  qn = w;
  i = 1; while (i < nd) (
    t1 = dut[i]; t2 = dus[i]; t3 = dud1[i]; t4 = dud2[i]; key = floor(t1)*4 + prio(t2); j = i - 1;
    while (j >= 0 && (floor(dut[j])*4 + prio(dus[j])) > key) ( dut[j+1] = dut[j]; dus[j+1] = dus[j]; dud1[j+1] = dud1[j]; dud2[j+1] = dud2[j]; j -= 1; );
    dut[j+1] = t1; dus[j+1] = t2; dud1[j+1] = t3; dud2[j+1] = t4; i += 1;
  );
  i = 0; loop(nd, ofs = clamp(floor(dut[i] - bs), 0, bl - 1); sendEv(ofs, dus[i], dud1[i], dud2[i]); i += 1;); );
// rampas de pitch bend (glissandi): se convierten en mensajes dentro del bloque
function rampBlock(bs bl) local(c ch t te v)
( c = 0;
  loop(4,
    rAct[c] ? (
      ch = clamp(vp(c,V_CH) - 1, 0, 15);
      t = max(rS0[c], bs); te = min(rS1[c], bs + bl);
      while (t < te) ( v = rV0[c] + (rV1[c] - rV0[c])*(t - rS0[c])/max(1, rS1[c] - rS0[c]); bendAt(t, ch, v); t += 192; );
      rS1[c] < bs + bl ? ( bendAt(max(rS1[c], bs), ch, rV1[c]); rAct[c] = 0; );
    );
    c += 1;); );
function flushAll() local(i)
( qn = 0; i = 0; loop(4, rAct[i] = 0; i += 1;);
  i = 0; loop(2048, nct[i] > 0 ? midisend(0, 0x80 | floor(i/128), i & 127, 0); nct[i] = 0; i += 1;); );

// ======================= arquitectura (secciones de Xenakis) =======================
function archGate(c t secc act) local(len)
( secc <= 0 ? 1 : (
    t >= sget(c,S_SECTEND) ? (
      len = max(1, -log(max(1 - rnd(c), 0.000001))*secc*barQ);
      sset(c, S_SECTEND, t + len); sset(c, S_SECTON, rnd(c) < act/100);
    );
    sget(c,S_SECTON); ); );

// ======================= ESTOCÁSTICO =======================
function genEstoc(c t) local(dens der ley a cen an derc pas mic dur nube gl secc act dm lam dt co k nn x prev pa pr p d)
( dens = mpv(c,0); der = mpv(c,1); ley = floor(mpv(c,2)); a = mpv(c,3)/100; cen = mpv(c,4); an = mpv(c,5);
  derc = mpv(c,6); pas = mpv(c,7)/100; mic = mpv(c,8); dur = mpv(c,9); nube = floor(mpv(c,10)); gl = mpv(c,11);
  secc = mpv(c,12); act = mpv(c,13);
  dm = mirror(sget(c,S_DM) + gauss(c)*der/100*0.25, -2, 2); sset(c, S_DM, dm);
  lam = max(0.01, dens*pow(2, dm));
  dt = -log(max(1 - rnd(c), 0.000001))/lam;
  !archGate(c, t, secc, act) ? ( sset(c, S_NEXT, max(sget(c,S_SECTEND), t + 0.001)); ) : (
    co = mirror(sget(c,S_COFF) + gauss(c)*derc/100*1.5, -an, an); sset(c, S_COFF, co);
    nn = 1 + rndi(c, max(1, nube)); k = 0;
    loop(nn,
      x = xdist(c, ley, a);
      prev = sget(c,S_PREVP);
      pa = cen + co + x*an; pr = prev + x*an*0.5;
      p = mirror((1 - pas)*pa + pas*pr, cen + co - an, cen + co + an);
      k == 0 ? sset(c, S_PREVP, p);
      (mic > 0 && !vp(c,V_ESC)) ? (p += (rnd(c)*2 - 1)*mic/100);
      d = max(0.03, -log(max(1 - rnd(c), 0.000001))*dur);
      playNote(c, t, p, d, velOf(c), (k == 0 && rnd(c) < gl/100) ? 1 : 0, 0, min(d, dt)*0.8);
      k += 1;);
    sset(c, S_NEXT, t + max(dt, 0.001));
  ); );

// ======================= GENDYN =======================
// actualiza el punto j: paseos de amplitud y duración (1.er orden) o primarios + secundarios (2.º orden, GENDY3)
function updBP(c j ord la ld pa pd a bar) local(vb ga gd gpa gpd)
( vb = vbase(c); ga = vb + O_GA; gd = vb + O_GD; gpa = vb + O_GPA; gpd = vb + O_GPD;
  ord < 2 ? (
    ga[j] = mirror(ga[j] + pa*gdist(la, a, rnd(c)), -bar, bar);
    gd[j] = mirror(gd[j] + pd*gdist(ld, a, rnd(c)), 0, 1);
  ) : (
    gpa[j] = mirror(gpa[j] + pa*0.5*gdist(la, a, rnd(c)), -pa, pa);
    ga[j]  = mirror(ga[j] + gpa[j], -bar, bar);
    gpd[j] = mirror(gpd[j] + pd*0.5*gdist(ld, a, rnd(c)), -pd, pd);
    gd[j]  = mirror(gd[j] + gpd[j], 0, 1);
  ); );
function genGendyn(c t) local(nn ord la ld pa pd a bar cen an tmin tmax per gl secc act vb ga gd idx j pi pj s k d)
( nn = clamp(floor(mpv(c,0)), 3, 32); ord = mpv(c,1); la = floor(mpv(c,2)); ld = floor(mpv(c,3));
  pa = mpv(c,4)/100; pd = mpv(c,5)/100; a = mpv(c,6)/100; bar = mpv(c,7)/100; cen = mpv(c,8); an = mpv(c,9);
  tmin = mpv(c,10); tmax = max(tmin, mpv(c,11)); per = mpv(c,12); gl = mpv(c,13); secc = mpv(c,14); act = mpv(c,15);
  vb = vbase(c); ga = vb + O_GA; gd = vb + O_GD;
  idx = pmod(sget(c,S_GIDX), nn);
  !archGate(c, t, secc, act) ? ( sset(c, S_NEXT, max(sget(c,S_SECTEND), t + 0.001)); ) : (
    j = pmod(idx + 1, nn);
    updBP(c, j, ord, la, ld, pa, pd, a, bar);
    pi = cen + ga[idx]*an; pj = cen + ga[j]*an;
    per > 0 ? ( s = 0; k = 0; loop(nn, s += gd[k] + 0.02; k += 1;); d = per*(gd[idx] + 0.02)/s; )
            : ( d = tmin + (tmax - tmin)*gd[idx]; );
    d = max(d, 0.01);
    playNote(c, t, pi, d, velOf(c), gl ? 2 : 0, pj, d);
    sset(c, S_GIDX, j); sset(c, S_NEXT, t + d);
  ); );

// ======================= TURING MACHINE =======================
function genTuring(c t) local(lock len rng base dv pul sl reg b i v k gt)
( lock = mpv(c,0); len = clamp(floor(mpv(c,1)), 2, 16); rng = mpv(c,2); base = mpv(c,3);
  dv = divt[clamp(floor(mpv(c,4)), 0, 16)]; pul = clamp(floor(mpv(c,5)), 0, 8); sl = mpv(c,6);
  reg = vbase(c) + O_REG;
  b = reg[len - 1]; rnd(c) < 1 - lock/100 ? (b = 1 - b);
  i = 15; while (i > 0) ( reg[i] = reg[i - 1]; i -= 1; ); reg[0] = b;
  v = 0; k = 0; loop(8, v = v*2 + reg[k]; k += 1;); v /= 255;
  gt = pul == 0 ? 1 : reg[pul - 1];
  gt ? playNote(c, t, base + v*rng, dv, velOf(c), rnd(c) < sl/100 ? 1 : 0, 0, dv*0.5);
  sset(c, S_TCNT, sget(c,S_TCNT) + 1); sset(c, S_NEXT, t + dv); );

// ======================= BLOOM =======================
function bloomSpan(c) ( clamp(floor(mpv(c,5)), 1, 4)*(vp(c,V_ESC) ? scn : 12); );
function bloomStep(c i span) local(tv)
( tv = vbase(c) + O_TV; tv[i] = rndi(c, span); );
function saveUndo(c) local(vb a b k i)
( vb = vbase(c); k = 0;
  loop(5, a = vb + O_TV + k*40; b = vb + O_UV + k*40; i = 0; loop(32, b[i] = a[i]; i += 1;); k += 1;); );
function undoTrunk(c) local(vb a b k i)
( vb = vbase(c); k = 0;
  loop(5, a = vb + O_UV + k*40; b = vb + O_TV + k*40; i = 0; loop(32, b[i] = a[i]; i += 1;); k += 1;); );
function newTrunk(c) local(vb tv tg tr ts tn i span)
( vb = vbase(c); span = bloomSpan(c);
  tv = vb + O_TV; tg = vb + O_TG; tr = vb + O_TR; ts = vb + O_TS; tn = vb + O_TN;
  i = 0; loop(32, tv[i] = rndi(c, span); tg[i] = rnd(c); tr[i] = rnd(c); ts[i] = rnd(c); tn[i] = 2 + rndi(c, 3); i += 1;); );
// rama de profundidad d por el camino path: cada nivel aplica una transformación (transposición, inversión,
// retrógrado o mutación) elegida de forma determinista por el nodo del árbol
function buildBranch(c d path len) local(vb sv sg sr ss sn i k lvl bit pre h ty amt sgn mn mx tmp nst sd)
( vb = vbase(c); sv = vb + O_SV; sg = vb + O_SG; sr = vb + O_SR; ss = vb + O_SS; sn = vb + O_SN;
  i = 0; loop(5, mn = vb + O_TV + i*40; mx = vb + O_SV + i*40; k = 0; loop(len, mx[k] = mn[k]; k += 1;); i += 1;);
  nst = vp(c,V_ESC) ? scn : 12; sd = vp(c,V_SEED) + gSeed*1000;
  lvl = 1;
  loop(d,
    bit = (path >> (lvl - 1)) & 1; pre = path & ((1 << lvl) - 1);
    h = hash(sd*131 + lvl*977 + pre*7919 + bit*31 + 17);
    ty = floor(h*4);
    ty == 0 ? ( amt = 1 + floor(hash(h*1000 + 3)*nst); sgn = hash(h*1000 + 5) < 0.5 ? -1 : 1; i = 0; loop(len, sv[i] += sgn*amt; i += 1;); );
    ty == 1 ? ( mn = sv[0]; mx = sv[0]; i = 0; loop(len, mn = min(mn, sv[i]); mx = max(mx, sv[i]); i += 1;);
                i = 0; loop(len, sv[i] = mn + mx - sv[i]; i += 1;); );
    ty == 2 ? ( i = 0; loop(floor(len/2),
                  tmp = sv[i]; sv[i] = sv[len-1-i]; sv[len-1-i] = tmp; tmp = sg[i]; sg[i] = sg[len-1-i]; sg[len-1-i] = tmp;
                  tmp = sr[i]; sr[i] = sr[len-1-i]; sr[len-1-i] = tmp; tmp = ss[i]; ss[i] = ss[len-1-i]; ss[len-1-i] = tmp;
                  tmp = sn[i]; sn[i] = sn[len-1-i]; sn[len-1-i] = tmp; i += 1;); );
    ty == 3 ? ( i = 0; loop(len, hash(h*977 + i*13) < 0.3 ? ( sv[i] += (hash(h*991 + i*7) < 0.5 ? -1 : 1)*(1 + floor(hash(h*997 + i)*2)); ); i += 1;); );
    lvl += 1;); );
function bloomPitch(c raiz v) local(k n0 rel di tot)
( vp(c,V_ESC) ? (
    n0 = raiz; k = 0; while (k < 12 && !inScale(raiz + k)) ( k += 1; ); n0 = raiz + k;
    rel = pmod(n0 - gRoot, 12); di = 0; k = 0; loop(scn, soff[k] == rel ? (di = k); k += 1;);
    tot = di + v; n0 - soff[di] + 12*floor(tot/scn) + soff[pmod(tot, scn)];
  ) : ( raiz + v; ); );
function genBloom(c t) local(len br path mut raiz ord dv sil rat sld total bc p d s i vb idx v span nr k sv sg sr ss sn)
( len = clamp(floor(mpv(c,0)), 1, 32); br = clamp(floor(mpv(c,1)), 0, 7); path = clamp(floor(mpv(c,2)), 0, 127);
  mut = mpv(c,3); raiz = mpv(c,4); ord = clamp(floor(mpv(c,6)), 0, 3); dv = divt[clamp(floor(mpv(c,7)), 0, 16)];
  sil = mpv(c,8); rat = mpv(c,9); sld = mpv(c,10);
  total = len*(br + 1); bc = sget(c,S_BCNT); p = pmod(bc, total); d = floor(p/len); s = pmod(p, len);
  vb = vbase(c); sv = vb + O_SV; sg = vb + O_SG; sr = vb + O_SR; ss = vb + O_SS; sn = vb + O_SN;
  (p == 0 && bc > 0 && mut > 0) ? ( span = bloomSpan(c); i = 0; loop(32, rnd(c) < mut/100 ? bloomStep(c, i, span); i += 1;); );
  buildBranch(c, d, path, len);
  idx = ord == 0 ? s : (ord == 1 ? len - 1 - s : (ord == 2 ? (pmod(floor(bc/len), 2) == 0 ? s : len - 1 - s) : rndi(c, len)));
  v = sv[idx];
  sg[idx] >= sil/100 ? (
    nr = sr[idx] < rat/100 ? sn[idx] : 1;
    k = 0; loop(nr, playNote(c, t + k*dv/nr, bloomPitch(c, raiz, v), dv/nr, velOf(c), (k == 0 && ss[idx] < sld/100) ? 1 : 0, 0, dv*0.5); k += 1;);
  );
  sset(c, S_BIDX, idx); sset(c, S_BDEPTH, d);
  sset(c, S_BCNT, bc + 1); sset(c, S_NEXT, t + dv); );

// ======================= ANALOGIQUE A =======================
// Cada pantalla (A..H) es una combinación de altura (f0/f1), dinámica (g0/g1) y densidad (d0/d1) y dura ΔT.
// Modelo GTPM: la matriz 8x8 de la obra. Modelo ACOPLADO: tres cadenas de 2 estados cuyas matrices (alfa/beta)
// elige el estado de otro parámetro, como en Xenakis. El protocolo alterna secciones de 30 pantallas en
// equilibrio o perturbadas (fijadas en una pantalla).
function genAnalog(c t) local(dT mdl pert tgt prot dens oct sub durp leg s f g d r j acc k i reg dyn lv cnt pos p dur vel scount hv mf mg md2 nf ng nd ah)
( dT = mpv(c,0); mdl = floor(mpv(c,1)); pert = mpv(c,2)/100; tgt = clamp(floor(mpv(c,3)), 0, 7); prot = mpv(c,4);
  dens = mpv(c,5)/100; oct = floor(mpv(c,6)); sub = mpv(c,7); durp = mpv(c,8)/100; leg = mpv(c,9)/100;
  s = sget(c,S_SCR); f = sget(c,S_F); g = sget(c,S_G); d = sget(c,S_D); scount = sget(c,S_SCNT);
  (prot >= 0.5 && pmod(scount, 30) == 0) ? ( sset(c, S_SECP, rnd(c) < 0.7); sset(c, S_SECT, rndi(c, 8)); );
  scount > 0 ? (
    mdl == 0 ? (
      r = rnd(c); j = 0; acc = 0; while (j < 7 && r >= acc + gtpm[j*8 + s]) ( acc += gtpm[j*8 + s]; j += 1; ); s = j;
      f = floor(s/4); g = floor(s/2) & 1; d = s & 1;
    ) : (
      mf = d; md2 = f; mg = (f == d) ? f : (rnd(c) < 0.5 ? f : d);
      nf = rnd(c) < aP[mf*4 + f*2 + 1] ? 1 : 0;
      ng = rnd(c) < aP[mg*4 + g*2 + 1] ? 1 : 0;
      nd = rnd(c) < aP[md2*4 + d*2 + 1] ? 1 : 0;
      f = nf; g = ng; d = nd; s = f*4 + g*2 + d;
    );
    hv = prot >= 0.5 ? (sget(c,S_SECP) ? 0.85 : 0) : pert;
    rnd(c) < hv ? ( s = prot >= 0.5 ? sget(c,S_SECT) : tgt; f = floor(s/4); g = floor(s/2) & 1; d = s & 1; );
  );
  sset(c,S_SCR,s); sset(c,S_F,f); sset(c,S_G,g); sset(c,S_D,d); sset(c,S_SCNT, scount + 1);
  ah = vbase(c) + O_AH; ah[pmod(scount, 32)] = s;
  k = 0;
  loop(4,
    reg = f ? aFS[4 + pmod(k,2)] : aFS[k];
    dyn = g ? aGS[4 + pmod(k,2)] : aGS[k];
    lv = d ? aDS[4 + k] : aDS[k];
    cnt = floor(aLev[lv]*dens + rnd(c));
    i = 0;
    loop(cnt,
      pos = sub < 0.5 ? aGrid[rndi(c,12)] : rnd(c);
      p = aRegLo[reg] + rnd(c)*(aRegHi[reg] - aRegLo[reg]) + 12*oct;
      dur = rnd(c) < leg ? 0.06 : max(0.05, dT*durp*(0.3 + 0.7*rnd(c)));
      vel = clamp(floor(aVel[dyn]*1.27*vp(c,V_VEL) + (rnd(c)*2 - 1)*vp(c,V_DIN)/100*40), 1, 127);
      playNote(c, t + pos*dT, p, dur, vel, 0, 0, 0);
      i += 1;);
    k += 1;);
  sset(c, S_NEXT, t + dT); );

// ======================= SUBSEQ (a partir de Subsequence) =======================
// Grafo de acordes con pesos y gravedad hacia la tónica, conducción de voces, ritmo euclídeo reconstruido en
// cada ciclo (se aclara con la tensión de la sección), secciones congeladas (freeze) e inercia melódica de Narmour.
function ssWeight(gr from to n) local(w dd)
( dd = abs(to - from); dd = min(dd, n - dd);
  gr == 0 ? ( w = n == 7 ? ssF[from*7 + to] + 0.01 : (dd == 0 ? 0.02 : (dd == 1 ? 0.3 : (dd == 2 ? 0.15 : 0.05))); );
  gr == 1 ? ( w = dd == 0 ? 0.02 : (dd == 1 ? 0.3 : (dd == 2 ? 0.15 : 0.05)); );
  gr == 3 ? ( w = from == 0 ? (to == 0 ? 0.05 : 1) : (to == 0 ? 3 : 0.3); );
  w; );
function ssNext(c gr gv) local(n from to w sum r q root op)
( gr == 2 ? (
    root = sget(c,S_CROOT); q = sget(c,S_CQ);
    r = rnd(c)*(1 + gv*1.5);
    r >= 1 ? ( root = gRoot; q = inScale(root + 4) ? 0 : 1; ) : (
      op = floor(r*4);
      op == 0 ? ( q = 1 - q; );
      op == 1 ? ( q == 0 ? ( root += 4; q = 1; ) : ( root -= 4; q = 0; ); );
      op == 2 ? ( q == 0 ? ( root -= 3; q = 1; ) : ( root += 3; q = 0; ); );
      op == 3 ? ( q == 0 ? ( root += 1; q = 1; ) : ( root -= 1; q = 0; ); );
    );
    sset(c, S_CROOT, pmod(root, 12)); sset(c, S_CQ, q);
  ) : (
    n = min(scn, 7); from = pmod(sget(c,S_CD), n);
    sum = 0; to = 0; loop(n, w = ssWeight(gr, from, to, n)*(to == 0 ? 1 + 3*gv : 1 - 0.4*gv); sum += w; to += 1;);
    r = rnd(c)*sum; to = 0; w = ssWeight(gr, from, 0, n)*(1 + 3*gv);
    while (to < n - 1 && r >= w) ( r -= w; to += 1; w = ssWeight(gr, from, to, n)*(to == 0 ? 1 + 3*gv : 1 - 0.4*gv); );
    sset(c, S_CD, to);
  ); );
function ssApply(c gr nn) local(cht k deg root q stp)
( cht = vbase(c) + O_CHT;
  gr == 2 ? (
    root = sget(c,S_CROOT); q = sget(c,S_CQ);
    cht[0] = root; cht[1] = pmod(root + (q ? 3 : 4), 12); cht[2] = pmod(root + 7, 12); cht[3] = pmod(root + (q ? 10 : 11), 12);
  ) : (
    deg = sget(c,S_CD); stp = scn >= 5 ? 2 : 1;
    k = 0; loop(4, cht[k] = pmod(gRoot + soff[pmod(deg + k*stp, scn)], 12); k += 1;);
    sset(c, S_CROOT, cht[0]);
  );
  sset(c, S_CHN, clamp(nn, 3, 4)); );
function ssState(c gr) ( gr == 2 ? sget(c,S_CROOT)*2 + sget(c,S_CQ) : sget(c,S_CD); );
function ssSet(c gr v) ( gr == 2 ? ( sset(c,S_CROOT, floor(v/2)); sset(c,S_CQ, v & 1); ) : sset(c,S_CD, v); );
function ssTonic(c gr) ( sset(c,S_CD,0); sset(c,S_CROOT,gRoot); sset(c,S_CQ, inScale(gRoot + 4) ? 0 : 1); );
function nearChord(c p) local(cht n d r k f)
( cht = vbase(c) + O_CHT; n = sget(c,S_CHN); r = p; d = 0;
  while (d <= 6) (
    f = 0; k = 0; loop(n, pmod(p + d, 12) == cht[k] ? (f = 1); k += 1;);
    f ? ( r = p + d; d = 99; ) : (
      f = 0; k = 0; loop(n, pmod(p - d, 12) == cht[k] ? (f = 1); k += 1;);
      f ? ( r = p - d; d = 99; ) : (d += 1); );
  );
  r; );
function genSubseq(c t) local(role gr gv cl form base dv hits ten iner var nn st bt ci sec fz k i h hit vv cht p prev li dir r kk tension root vel n rel tmp j)
( role = floor(mpv(c,0)); gr = floor(mpv(c,1)); gv = mpv(c,2)/100; cl = max(0.25, mpv(c,3)); form = floor(mpv(c,4));
  base = mpv(c,5); dv = divt[clamp(floor(mpv(c,6)),0,16)]; hits = mpv(c,7); ten = mpv(c,8)/100; iner = mpv(c,9)/100;
  var = mpv(c,10)/100; nn = floor(mpv(c,11));
  st = sget(c,S_TCNT); bt = st*dv; ci = floor(bt/cl + 0.000001);
  fz = vbase(c) + O_FZ;
  sget(c,S_FZGR) != gr + 1 ? (
    ssTonic(c, gr); fz[0] = ssState(c, gr);
    k = 1; loop(3, ssNext(c, gr, gv); fz[k] = ssState(c, gr); k += 1;);
    ssTonic(c, gr); sset(c, S_FZGR, gr + 1); sset(c, S_CHI, -1);
  );
  (st == 0 || ci != sget(c,S_CHI)) ? (
    sec = floor(ci/4);
    (form == 1 || (form == 2 && pmod(sec, 4) != 2)) ? ssSet(c, gr, fz[pmod(ci, 4)]) : ( ci == 0 ? ssTonic(c, gr) : ssNext(c, gr, gv) );
    ssApply(c, gr, nn); sset(c, S_CHI, ci);
  );
  pmod(st, 16) == 0 ? (
    tension = pmod(bt, 4*cl)/(4*cl);
    sset(c, S_HITS, clamp(floor(hits*(1 - ten*tension) + 0.5), 1, 16));
    rnd(c) < var ? sset(c, S_ROT, rndi(c, 16));
  );
  i = pmod(pmod(st, 16) + sget(c,S_ROT), 16); h = sget(c,S_HITS);
  hit = pmod(i*h, 16) < h;
  hit ? (
    vel = clamp(velOf(c) + (pmod(st,4) == 0 ? 8 : 0), 1, 127);
    cht = vbase(c) + O_CHT; vv = vbase(c) + O_VV; n = sget(c,S_CHN); root = sget(c,S_CROOT);
    role == 0 ? (
      k = 0;
      loop(n,
        prev = vv[k] > 0 ? vv[k] : base + k*4;
        p = prev + pmod(cht[k] - prev + 6, 12) - 6;
        p < base - 5 ? (p += 12); p > base + 19 ? (p -= 12);
        vv[k] = p; playNote(c, t, p, dv*2, vel, 0, 0, 0);
        k += 1;);
    );
    role == 1 ? (
      p = base + pmod(root - base, 12);
      (pmod(st,4) != 0 && rnd(c) < 0.3) ? (p += 7);
      playNote(c, t, p, dv*1.5, vel, 0, 0, 0);
    );
    role == 2 ? (
      prev = sget(c,S_PREVP); prev < 1 ? (prev = base + 7); li = sget(c,S_LINT); r = rnd(c);
      (abs(li) >= 5 && r < iner) ? ( dir = li > 0 ? -1 : 1; kk = 1 + rndi(c, 2); ) : (
      (abs(li) > 0 && abs(li) <= 2 && r < iner) ? ( dir = li > 0 ? 1 : -1; kk = 1 + rndi(c, 2); ) :
        ( dir = rnd(c) < 0.5 ? -1 : 1; kk = 1 + rndi(c, 5); ) );
      p = scaleWalk(prev, dir*kk);
      (pmod(st,4) == 0 && rnd(c) < 0.7) ? (p = nearChord(c, p));
      p < base ? (p += 12); p > base + 24 ? (p -= 12);
      sset(c, S_LINT, p - prev); sset(c, S_PREVP, p);
      playNote(c, t, p, dv*1.2, vel, 0, 0, 0);
    );
    role == 3 ? (
      k = sget(c,S_ARP); j = pmod(k, n);
      rel = pmod(cht[j] - root, 12);
      p = base + pmod(root - base, 12) + 12*floor(k/n) + rel;
      sset(c, S_ARP, pmod(k + 1, n*2));
      playNote(c, t, p, dv*0.9, vel, 0, 0, 0);
    );
  );
  sset(c, S_TCNT, st + 1); sset(c, S_NEXT, t + dv); );

// ======================= MARKOV (aprendido, a lo Max for Live) =======================
// Cadenas de orden variable sobre un corpus: la entrada MIDI, lo que tocan las otras voces o un corpus al azar.
// Cadenas separadas de altura y de ritmo; temperatura (exploración), reinicio de cadena y congelado del corpus.
function quantDur(x) local(i b bd e)
( b = 8; bd = 1000; i = 0; loop(14, e = abs(log(max(x, 0.001)/dtab[i])); e < bd ? ( bd = e; b = i; ); i += 1;); b; );
function corpusAdd(note vel ofs) local(now ioi pos)
( now = (absS + ofs)/srate;
  inN > 0 ? ( ioi = (now - inLastT)*max(btempo, 1)/60; inD[pmod(inN - 1, 512)] = ioi > 4 ? 11 : quantDur(ioi); );
  inLastT = now; pos = pmod(inN, 512); inP[pos] = note; inV[pos] = vel; inD[pos] = 8; inN += 1; );
function mkBuild(c src win frz) local(i n end j pos last k rc)
( cpn = 0;
  src == 0 ? (
    frz ? ( sget(c,S_FRZ) <= 0 ? sset(c, S_FRZ, max(1, inN)); end = min(sget(c,S_FRZ), inN); ) : ( sset(c, S_FRZ, 0); end = inN; );
    n = min(min(end, 512), win);
    i = 0; loop(n, pos = pmod(end - n + i, 512); cpP[i] = inP[pos]; cpD[i] = inD[pos]; cpV[i] = inV[pos]; i += 1;);
    cpn = n;
  );
  src == 1 ? (
    n = min(evN, 512); j = 0; last = -1;
    i = 0;
    loop(n,
      pos = pmod(evN - n + i, 512);
      evV[pos] != c ? (
        cpP[j] = floor(evP[pos] + 0.5); cpV[j] = evVel[pos];
        j > 0 ? ( cpD[j - 1] = quantDur(max(0.01, evT[pos] - last)); );
        cpD[j] = 8; last = evT[pos]; j += 1;
      );
      i += 1;);
    k = j - win;
    k > 0 ? ( i = 0; loop(win, cpP[i] = cpP[i + k]; cpD[i] = cpD[i + k]; cpV[i] = cpV[i + k]; i += 1;); j = win; );
    cpn = j;
  );
  (src == 2 || cpn < 3) ? (
    rc = 50000 + c*200; i = 0; loop(64, cpP[i] = rc[i]; cpD[i] = rc[64 + i]; cpV[i] = rc[128 + i]; i += 1;); cpn = 64;
  );
  sset(c, S_CPN, cpn); );
function mkSym(kind i) ( kind == 1 ? cpP[i] - cpP[i - 1] : (kind == 0 ? cpP[i] : cpD[i]); );
function mkNext(c kind ord hist hcnt temp) local(lo o i k ok nc pick)
( lo = kind == 1 ? 1 : 0; pick = -1; g_cands = 0;
  rnd(c) < temp ? ( pick = lo + rndi(c, cpn - lo); ) : (
    o = min(ord, hcnt);
    while (o >= 0 && pick < 0) (
      nc = 0; i = lo + o;
      loop(max(0, cpn - lo - o),
        ok = 1; k = 0; loop(o, mkSym(kind, i - o + k) != hist[8 - o + k] ? (ok = 0); k += 1;);
        ok ? ( nc += 1; rnd(c) < 1/nc ? (pick = i); );
        i += 1;);
      g_cands = nc; o -= 1;
    );
    pick < 0 ? (pick = lo + rndi(c, cpn - lo));
  );
  pick; );
function genMarkov(c t) local(src ko kr md temp win frz dv tr sil rein vb hp hr hpc hrc pi di p dur vel prev k)
( src = floor(mpv(c,0)); ko = floor(mpv(c,1)); kr = floor(mpv(c,2)); md = floor(mpv(c,3)); temp = mpv(c,4)/100;
  win = floor(mpv(c,5)); frz = mpv(c,6) >= 0.5; dv = divt[clamp(floor(mpv(c,7)),0,16)]; tr = mpv(c,8); sil = mpv(c,9)/100; rein = mpv(c,10)/100;
  mkBuild(c, src, max(4, win), frz);
  vb = vbase(c); hp = vb + O_MH; hr = vb + O_MR; hpc = sget(c,S_MKN); hrc = sget(c,S_MKR);
  rnd(c) < rein ? ( hpc = 0; hrc = 0; );
  pi = mkNext(c, md == 1 ? 1 : 0, ko, hp, hpc, temp); sset(c, S_CAND, g_cands);
  md == 1 ? ( prev = sget(c,S_PREVP); prev < 1 ? (prev = cpP[pi]); p = mirror(prev + cpP[pi] - cpP[pi - 1], 24, 108); ) : ( p = cpP[pi]; );
  k = 0; loop(7, hp[k] = hp[k + 1]; k += 1;); hp[7] = mkSym(md == 1 ? 1 : 0, pi); sset(c, S_MKN, min(8, hpc + 1));
  kr > 0 ? (
    di = mkNext(c, 2, kr, hr, hrc, temp); dur = dtab[clamp(cpD[di], 0, 13)];
    k = 0; loop(7, hr[k] = hr[k + 1]; k += 1;); hr[7] = cpD[di]; sset(c, S_MKR, min(8, hrc + 1));
  ) : ( dur = dv; );
  vel = clamp(floor(cpV[pi]*vp(c,V_VEL)/100 + (rnd(c)*2 - 1)*vp(c,V_DIN)/100*30), 1, 127);
  sset(c, S_PREVP, p);
  rnd(c) >= sil ? playNote(c, t, p + tr, dur, vel, 0, 0, 0);
  sset(c, S_NEXT, t + max(dur, 0.03)); );

// ======================= transposición por la entrada MIDI =======================
function trUpdate() local(i n)
( gTrMode == 0 ? ( gTr = 0; ) : (
    n = inLast;
    gTrMode == 2 ? ( (n >= 0 && inHeld[n]) ? 0 : ( n = -1; i = 0; loop(128, (n < 0 && inHeld[i]) ? (n = i); i += 1;); ); );
    n < 0 ? ( gTr = 0; ) : (
      gTrMode == 3 ? ( gTr = pmod(n - gRef, 12); gTr > 6 ? (gTr -= 12); ) : ( gTr = n - gRef; );
    );
  );
  rootEff = pmod(gRoot + gTr, 12); );


// =====================================================================================
// FAMILIAS 1.2: SERIAL, FRACTAL, AUTÓMATA, ESPACIAL, EUCLÍDEO, REGLAS, INTERVÁLICO
// =====================================================================================
function xb(c) ( 120000 + c*3000; );
function nstep(c) ( vp(c,V_ESC) ? scn : 12; );
function foldi(x n) local(m p) ( n <= 1 ? 0 : ( m = 2*(n - 1); p = pmod(floor(x + 0.5), m); p >= n ? m - p : p; ); );
function wrapi(x n) ( pmod(floor(x + 0.5), max(1, n)); );
function dP(c base d) ( bloomPitch(c, base, d); );
function divOf(c k) ( divt[clamp(floor(mpv(c,k)),0,16)]; );
function permute(a n c) local(i j t)
( i = 0; loop(n, a[i] = i; i += 1;); i = n - 1; while (i > 0) ( j = rndi(c, i + 1); t = a[i]; a[i] = a[j]; a[j] = t; i -= 1; ); );
function euclid(k n r i) local(j kk) ( n < 1 ? 0 : ( kk = clamp(floor(k), 0, n); j = pmod(i + r, n); pmod(j*kk, n) < kk; ); );
function binom(a b) local(r i) ( r = 1; i = 0; loop(b, r = r*(a - i)/(i + 1); i += 1;); floor(r + 0.5); );
function nextPerm(a n) local(i j t l r)
( i = n - 2; while (i >= 0 && a[i] >= a[i + 1]) ( i -= 1; );
  i >= 0 ? ( j = n - 1; while (a[j] <= a[i]) ( j -= 1; ); t = a[i]; a[i] = a[j]; a[j] = t; );
  l = i + 1; r = n - 1; while (l < r) ( t = a[l]; a[l] = a[r]; a[r] = t; l += 1; r -= 1; ); );
// elemento k de la combinación número rank (orden lexicográfico) de m elementos entre n
function combElem(n m rank k) local(x i cnt el b)
( x = pmod(rank, max(1, binom(n, m))); cnt = 0; el = 0; i = 0;
  while (i < n && cnt <= k) ( b = binom(n - 1 - i, m - 1 - cnt); x < b ? ( cnt == k ? (el = i); cnt += 1; ) : (x -= b); i += 1; );
  el; );
function norgard(i) local(hb s b)
( hb = 1; while (hb*2 <= i) ( hb *= 2; ); s = 0;
  while (hb >= 1) ( b = floor(i/hb) & 1; s = b ? s + 1 : -s; hb = floor(hb/2); ); s; );

function lsapp(b v) ( lsn < 600 ? ( b[lsn] = v; lsn += 1; ); );
// planta de Lindenmayer: X -> F+[[X]-X]-F[-FX]+X, F -> FF  (7 = X, 2 = F, 3 = +, 4 = -, 5 = [, 6 = ])
function lsplant(b) ( lsapp(b,2); lsapp(b,3); lsapp(b,5); lsapp(b,5); lsapp(b,7); lsapp(b,6); lsapp(b,4); lsapp(b,7); lsapp(b,6);
  lsapp(b,4); lsapp(b,2); lsapp(b,5); lsapp(b,4); lsapp(b,2); lsapp(b,7); lsapp(b,6); lsapp(b,3); lsapp(b,7); );
function caseed(e n dens c) local(i) ( i = 0; loop(n, e[i] = rnd(c) < max(0.05, dens/100); i += 1;); );
// ======================= SERIAL / COMBINATORIA =======================
// PR1 (Koenig, 1964): cada parámetro tiene un nivel de 1 (regular: serie en orden y grupos de repetición)
// a 7 (irregular: elección aleatoria sin repetición).
function pr1Sel(c row n lvl kPos kLast kGrp grp) local(idx g)
( g = sget(c,kGrp);
  (lvl <= 2 && g > 0) ? ( sset(c, kGrp, g - 1); idx = sget(c,kLast); ) : (
    rnd(c) < (7 - lvl)/6 ? ( idx = row[pmod(sget(c,kPos), n)]; sset(c, kPos, sget(c,kPos) + 1); )
                        : ( idx = rndi(c, n); (idx == sget(c,kLast) && n > 1) ? (idx = pmod(idx + 1 + rndi(c, n - 1), n)); );
    lvl <= 2 ? sset(c, kGrp, rndi(c, max(1, grp)));
  );
  sset(c, kLast, idx); idx; );
// PR2 (Koenig, 1966): métodos de selección ALEA, SERIE, SECUENCIA, GRUPO, TENDENCIA (máscara) y RATIO
function pr2Sel(c row n meth kPos kLast kGrp used grp t tp) local(idx g k i ph lo hi cnt w s r)
( idx = 0;
  meth == 0 ? ( idx = rndi(c, n); );
  meth == 1 ? (
    cnt = 0; i = 0; loop(n, !used[i] ? (cnt += 1); i += 1;);
    cnt == 0 ? ( i = 0; loop(n, used[i] = 0; i += 1;); cnt = n; );
    k = rndi(c, cnt); i = 0; while (i < n) ( !used[i] ? ( k == 0 ? ( idx = i; i = n; ) : (k -= 1); ); i += 1; ); used[idx] = 1;
  );
  meth == 2 ? ( idx = row[pmod(sget(c,kPos), n)]; sset(c, kPos, sget(c,kPos) + 1); );
  meth == 3 ? ( g = sget(c,kGrp); g > 0 ? ( sset(c, kGrp, g - 1); idx = sget(c,kLast); ) : ( idx = rndi(c, n); sset(c, kGrp, rndi(c, max(1, grp))); ); );
  meth == 4 ? ( ph = pmod(t, tp)/tp; ph = ph < 0.5 ? ph*2 : 2 - ph*2;
                lo = ph*(n - 1)*0.6; hi = min(n - 1, lo + 1 + (n - 1)*(0.25 + 0.75*ph)); idx = floor(lo + rnd(c)*(hi - lo + 0.999)); );
  meth == 5 ? ( s = n*(n + 1)/2; r = rnd(c)*s; w = n; while (idx < n - 1 && r >= w) ( r -= w; idx += 1; w = n - idx; ); );
  idx = clamp(idx, 0, n - 1); sset(c, kLast, idx); idx; );
function genSerial(c t) local(ty n form sh lp lr ld mp mr md base oct un tp pj grp xr row rrow drow used perm ns pos k pass v r d f dur vel m kk pss)
( ty = floor(mpv(c,0)); n = clamp(floor(mpv(c,1)), 3, 12); form = floor(mpv(c,2)); sh = floor(mpv(c,3));
  lp = floor(mpv(c,4)); lr = floor(mpv(c,5)); ld = floor(mpv(c,6)); mp = floor(mpv(c,7)); mr = floor(mpv(c,8)); md = floor(mpv(c,9));
  base = mpv(c,10); oct = clamp(floor(mpv(c,11)), 1, 4); un = divOf(c,12); tp = max(1, mpv(c,13))*barQ; pj = mpv(c,14)/100; grp = floor(mpv(c,15));
  xr = xb(c); row = xr; rrow = xr + 32; drow = xr + 64; used = xr + 96; perm = xr + 140;
  sget(c,S_XN) != n ? ( permute(row, n, c); k = 0; loop(n, perm[k] = k; k += 1;); sset(c, S_XN, n); sset(c, S_XP, 0); );
  ns = nstep(c); pos = sget(c,S_XP); k = pmod(pos, n); pass = floor(pos/n);
  dur = un; vel = velOf(c);
  ty <= 1 ? (
    v = ty == 0 ? pr1Sel(c, row, n, lp, S_XP, S_XL1, S_XG1, grp) : pr2Sel(c, row, n, mp, S_XP, S_XL1, S_XG1, used, grp, t, tp);
    r = ty == 0 ? pr1Sel(c, rrow, 6, lr, S_XR, S_XL2, S_XG2, grp) : pr2Sel(c, rrow, 6, mr, S_XR, S_XL2, S_XG2, used + 16, grp, t, tp);
    d = ty == 0 ? pr1Sel(c, drow, 6, ld, S_XD, S_XL3, S_XG3, grp) : pr2Sel(c, drow, 6, md, S_XD, S_XL3, S_XG3, used + 24, grp, t, tp);
    dur = un*(r + 1);
    vel = clamp(floor((25 + d*20)*vp(c,V_VEL)/100 + (rnd(c)*2 - 1)*vp(c,V_DIN)*0.3), 1, 127);
    sset(c, S_XF, v);
  ) : (
    ty == 2 ? (
      f = form == 4 ? pmod(pass, 4) : (form == 5 ? ( k == 0 ? sset(c, S_XF, rndi(c, 4)); sget(c,S_XF); ) : min(form, 3));
      v = f == 0 ? row[k] : (f == 1 ? row[n - 1 - k] : (f == 2 ? pmod(2*row[0] - row[k], n) : pmod(2*row[0] - row[n - 1 - k], n)));
      v += pass*sh;
    ) : (
      ty == 3 ? ( v = row[pmod(k + pass, n)] + pass*sh; ) : (
      ty == 4 ? ( (k == 0 && pos > 0) ? nextPerm(perm, n); v = row[perm[k]] + pass*sh; ) : (
        m = max(3, floor(n/2)); kk = pmod(pos, m); pss = floor(pos/m);
        v = row[combElem(n, m, pss, kk)] + pss*sh;
      ) ) );
    sset(c, S_XP, pos + 1);
  );
  rnd(c) < pj ? ( v += (rnd(c) < 0.5 ? -1 : 1)*ns; );
  playNote(c, t, dP(c, base, foldi(v, oct*ns + 1)), dur, vel, 0, 0, 0);
  sset(c, S_NEXT, t + dur); );

// ======================= FRACTAL =======================
function lsysStep(c rs it step) local(key ls ls2 len i k sym pos pp spp stk played guard outp)
( key = rs*100 + it; ls = xb(c) + 1000; ls2 = xb(c) + 1600; stk = xb(c) + 2700; lsRest = 0;
  key != sget(c,S_XK) ? (
    ls[0] = rs == 3 ? 7 : 0; len = 1; k = 0;
    while (k < it && len < 300) (
      lsn = 0; i = 0;
      loop(len, sym = ls[i];
        rs == 0 ? ( sym == 0 ? ( lsapp(ls2,0); lsapp(ls2,1); ) : lsapp(ls2,0); );
        rs == 1 ? ( sym == 0 ? ( lsapp(ls2,0); lsapp(ls2,1); ) : ( lsapp(ls2,1); lsapp(ls2,0); ); );
        rs == 2 ? ( sym == 0 ? ( lsapp(ls2,0); lsapp(ls2,1); lsapp(ls2,0); ) : ( lsapp(ls2,1); lsapp(ls2,1); lsapp(ls2,1); ); );
        rs == 3 ? ( sym == 7 ? lsplant(ls2) : ( sym == 2 ? ( lsapp(ls2,2); lsapp(ls2,2); ) : lsapp(ls2,sym); ); );
        i += 1;);
      len = lsn; i = 0; loop(len, ls[i] = ls2[i]; i += 1;); k += 1;
    );
    sset(c,S_XLEN,len); sset(c,S_XLP,0); sset(c,S_XPP,0); sset(c,S_XSP,0); sset(c,S_XK,key);
  );
  len = max(1, sget(c,S_XLEN)); pos = sget(c,S_XLP); pp = sget(c,S_XPP); spp = sget(c,S_XSP);
  played = 0; guard = 0; outp = pp;
  while (!played && guard < len + 2) (
    sym = ls[pos]; pos += 1;
    rs <= 1 ? ( sym == 0 ? (pp += step) : (pp -= step); played = 1; outp = pp; );
    rs == 2 ? ( sym == 0 ? (pp += step) : (lsRest = 1); played = 1; outp = pp; );
    rs == 3 ? (
      sym == 2 ? ( played = 1; outp = pp; );
      sym == 3 ? (pp += step); sym == 4 ? (pp -= step);
      sym == 5 ? ( spp < 60 ? ( stk[spp] = pp; spp += 1; ); );
      sym == 6 ? ( spp > 0 ? ( spp -= 1; pp = stk[spp]; ); );
    );
    pos >= len ? ( pos = 0; pp = 0; spp = 0; );
    guard += 1;
  );
  sset(c,S_XLP,pos); sset(c,S_XPP,pp); sset(c,S_XSP,spp);
  outp; );
function genFractal(c t) local(ty itv ini nd bl gr it ps base oct dv rf pr ns span pc v x dur m vs cnt k)
( ty = floor(mpv(c,0)); itv = floor(mpv(c,1)); ini = floor(mpv(c,2)); nd = clamp(floor(mpv(c,3)), 2, 12); bl = mpv(c,4)/100;
  gr = floor(mpv(c,5)); it = floor(mpv(c,6)); ps = floor(mpv(c,7)); base = mpv(c,8); oct = clamp(floor(mpv(c,9)), 1, 4);
  dv = divOf(c,10); rf = mpv(c,11)/100; pr = mpv(c,12)/100;
  ns = nstep(c); span = oct*ns + 1; pc = sget(c,S_XP); v = 0;
  ty == 0 ? ( v = floor(span/2) + norgard(pc + ini)*itv; );
  ty == 1 ? (
    vs = xb(c) + 170; cnt = pmod(sget(c,S_XV), 65536) + 1; sset(c, S_XV, cnt);
    x = 0; k = 0; loop(nd, (((cnt >> k) & 1) != (((cnt - 1) >> k) & 1)) ? (vs[k] = rnd(c)); x += vs[k]; k += 1;);
    x /= nd; x = x*(1 - bl) + rnd(c)*bl; x = clamp(0.5 + (x - 0.5)*(1 + nd*0.15), 0, 0.999); v = floor(x*span);
  );
  ty == 2 ? ( lsRest = 0; v = floor(span/2) + lsysStep(c, gr, it, ps); );
  dur = dv;
  rnd(c) < rf ? ( m = 1 + pmod(abs(norgard(pc*3 + 1 + ini)), 3); dur = dv*m; );
  (rnd(c) < pr && !(ty == 2 && lsRest)) ? playNote(c, t, dP(c, base, foldi(v, span)), dur, velOf(c), 0, 0, 0);
  sset(c, S_XP, pc + 1); sset(c, S_NEXT, t + dur); );

// ======================= AUTÓMATAS CELULARES =======================
function initOto(c nc) local(a i)
( a = xb(c) + 200; i = 0; loop(16, a[i*3] = rndi(c, 9); a[i*3 + 1] = rndi(c, 9); a[i*3 + 2] = rndi(c, 4); i += 1;); sset(c, S_XN, nc + 100); );
function genAuto(c t) local(ty rule var nc dens mut poly lec base oct dv ns span a fl i j x y d nx ny hits e tmp r rl lft mid rgt alive old w v k)
( ty = floor(mpv(c,0)); rule = floor(mpv(c,1)); var = floor(mpv(c,2)); nc = clamp(floor(mpv(c,3)), 1, 16); dens = mpv(c,4);
  mut = mpv(c,5)/100; poly = clamp(floor(mpv(c,6)), 1, 4); lec = floor(mpv(c,7)); base = mpv(c,8); oct = clamp(floor(mpv(c,9)), 1, 4);
  dv = divOf(c,10); ns = nstep(c); span = oct*ns + 1; hits = 0;
  ty == 0 ? (
    // OTOMATA: celdas que viajan por una rejilla 9x9; al chocar con la pared suenan (columna o fila) y dan la vuelta;
    // si dos celdas coinciden, giran en sentido horario
    a = xb(c) + 200; fl = xb(c) + 260;
    sget(c,S_XN) != nc + 100 ? initOto(c, nc);
    rnd(c) < mut ? ( a[rndi(c, nc)*3 + 2] = rndi(c, 4); );
    i = 0;
    loop(nc,
      x = a[i*3]; y = a[i*3 + 1]; d = a[i*3 + 2];
      nx = x + (d == 1 ? 1 : (d == 3 ? -1 : 0)); ny = y + (d == 2 ? 1 : (d == 0 ? -1 : 0));
      (nx < 0 || nx > 8 || ny < 0 || ny > 8) ? (
        hits < poly ? ( v = (d == 0 || d == 2) ? x : y; playNote(c, t, dP(c, base, foldi(v*oct, span)), dv, velOf(c), 0, 0, 0); hits += 1; );
        a[i*3 + 2] = pmod(d + 2, 4);
      ) : ( a[i*3] = nx; a[i*3 + 1] = ny; );
      i += 1;);
    i = 0; loop(nc, fl[i] = 0; j = 0; loop(nc, (j != i && a[i*3] == a[j*3] && a[i*3 + 1] == a[j*3 + 1]) ? (fl[i] = 1); j += 1;); i += 1;);
    i = 0; loop(nc, fl[i] ? ( a[i*3 + 2] = pmod(a[i*3 + 2] + 1, 4); ); i += 1;);
  );
  ty == 1 ? (
    // ECA-256: cuatro filas de 8 células, cada una con su regla; cada célula que nace es una nota
    e = xb(c) + 300; tmp = xb(c) + 340;
    r = 0;
    loop(4,
      rl = pmod(rule + r*var, 256);
      i = 0; loop(8, lft = e[r*8 + pmod(i - 1, 8)]; mid = e[r*8 + i]; rgt = e[r*8 + pmod(i + 1, 8)]; tmp[i] = (rl >> (lft*4 + mid*2 + rgt)) & 1; i += 1;);
      alive = 0;
      i = 0; loop(8,
        old = e[r*8 + i]; e[r*8 + i] = tmp[i]; alive += tmp[i];
        (tmp[i] && !old && hits < poly) ? ( playNote(c, t, dP(c, base, foldi(i + r*3, span)), dv, velOf(c), 0, 0, 0); hits += 1; );
        i += 1;);
      alive == 0 ? ( e[r*8 + rndi(c, 8)] = 1; );
      rnd(c) < mut ? ( k = r*8 + rndi(c, 8); e[k] = 1 - e[k]; );
      r += 1;);
  );
  ty == 2 ? (
    // WOLFRAM: una fila de 16 células; su estado se lee como altura
    e = xb(c) + 380; tmp = xb(c) + 400;
    i = 0; loop(16, lft = e[pmod(i - 1, 16)]; mid = e[i]; rgt = e[pmod(i + 1, 16)]; tmp[i] = (rule >> (lft*4 + mid*2 + rgt)) & 1; i += 1;);
    alive = 0; i = 0; loop(16, e[i] = tmp[i]; alive += e[i]; i += 1;);
    alive == 0 ? caseed(e, 16, dens, c);
    rnd(c) < mut ? ( k = rndi(c, 16); e[k] = 1 - e[k]; );
    lec == 1 ? ( v = floor(alive/16*span); ) : ( w = 0; i = 0; loop(6, w = w*2 + e[5 + i]; i += 1;); v = floor(w/64*span); );
    (lec != 2 || e[8]) ? playNote(c, t, dP(c, base, foldi(v, span)), dv, velOf(c), 0, 0, 0);
  );
  sset(c, S_NEXT, t + dv); );

// ======================= ESPACIAL / GEOMÉTRICA =======================
function genSpace(c t) local(ty dv dvy rec pag gat mut base oct lt ln lo ld lines pr ns span pos x y z idx pit gts kr v d o i ob p m s cnt)
( ty = floor(mpv(c,0)); dv = divOf(c,1); dvy = divOf(c,2); rec = floor(mpv(c,3)); pag = clamp(floor(mpv(c,4)), 1, 4);
  gat = mpv(c,5)/100; mut = mpv(c,6)/100; base = mpv(c,7); oct = clamp(floor(mpv(c,8)), 1, 4);
  lt = clamp(floor(mpv(c,9)), 1, 16); ln = clamp(floor(mpv(c,10)), 1, 16); lo = clamp(floor(mpv(c,11)), 1, 16); ld = clamp(floor(mpv(c,12)), 1, 16);
  lines = clamp(floor(mpv(c,13)), 1, 8); pr = mpv(c,14)/100;
  ns = nstep(c); span = oct*ns + 1; pos = sget(c,S_XP);
  ty == 0 ? (
    // RENÉ: rejilla cartesiana 4x4; X e Y con relojes propios; Z recorre páginas guardadas
    pit = xb(c) + 450; gts = xb(c) + 520;
    rec == 0 ? ( x = pmod(pos, 4); y = pmod(floor(pos/4), 4); );
    rec == 1 ? ( y = pmod(floor(pos/4), 4); x = pmod(y, 2) == 0 ? pmod(pos, 4) : 3 - pmod(pos, 4); );
    rec == 2 ? ( x = pmod(pos, 4); y = pmod(floor(t/dvy + 0.0001), 4); );
    rec == 3 ? ( x = pmod(pos, 4); y = pmod(pos + floor(pos/4), 4); );
    rec == 4 ? ( x = sget(c,S_XX); y = sget(c,S_XY); d = rndi(c, 4);
                 d == 0 ? (x = pmod(x + 1, 4)); d == 1 ? (x = pmod(x - 1, 4)); d == 2 ? (y = pmod(y + 1, 4)); d == 3 ? (y = pmod(y - 1, 4)); );
    sset(c,S_XX,x); sset(c,S_XY,y);
    z = pmod(floor(pos/16), pag); sset(c, S_XF, z);
    idx = z*16 + y*4 + x;
    rnd(c) < mut*0.25 ? ( i = rndi(c, 64); pit[i] = rndi(c, span); );
    (gts[idx] < gat && rnd(c) < pr) ? playNote(c, t, dP(c, base, foldi(pit[idx], span)), dv, velOf(c), 0, 0, 0);
  );
  ty == 1 ? (
    // KRIA: disparo, nota, octava y duración son bucles de longitudes distintas (polimetría por parámetro)
    kr = xb(c) + 600;
    rnd(c) < mut*0.25 ? ( i = rndi(c, 4); kr[i*16 + rndi(c, 16)] = i == 0 ? rnd(c) : (i == 1 ? rndi(c, ns) : (i == 2 ? rnd(c) : 1 + rndi(c, 4))); );
    (kr[pmod(pos, lt)] < gat && rnd(c) < pr) ? (
      v = kr[16 + pmod(pos, ln)] + floor(kr[32 + pmod(pos, lo)]*oct)*ns;
      d = dv*kr[48 + pmod(pos, ld)]*0.5;
      playNote(c, t, dP(c, base, foldi(v, span)), max(d, dv*0.25), velOf(c), 0, 0, 0);
    );
  );
  ty == 2 ? (
    // ORCA (adaptado): líneas con operador D (reloj de periodo p), I (incremento de paso s módulo m) y R (azar)
    ob = xb(c) + 700; i = 0;
    loop(lines,
      p = ob[i*5]; m = ob[i*5 + 1]; s = ob[i*5 + 2]; o = ob[i*5 + 3];
      pmod(pos, p) == 0 ? (
        cnt = pmod(ob[i*5 + 4] + s, m); ob[i*5 + 4] = cnt;
        v = rnd(c) < mut ? rndi(c, span) : o + cnt*2;
        rnd(c) < pr ? playNote(c, t, dP(c, base, foldi(v, span)), dv*p*0.8, velOf(c), 0, 0, 0);
      );
      i += 1;);
  );
  sset(c, S_XP, pos + 1); sset(c, S_NEXT, t + dv); );

// ======================= EUCLÍDEO / DISTRIBUCIÓN =======================
function genEuclid(c t) local(ty n1 k1 rot n2 k2 lg gx gy dens chaos nn rep base dv harm ns span pos hit a b mel pt mp w i lane dl thr v k nr p g)
( ty = floor(mpv(c,0)); n1 = clamp(floor(mpv(c,1)), 1, 32); k1 = floor(mpv(c,2)); rot = floor(mpv(c,3));
  n2 = clamp(floor(mpv(c,4)), 1, 32); k2 = floor(mpv(c,5)); lg = floor(mpv(c,6)); gx = mpv(c,7)/100; gy = mpv(c,8)/100;
  dens = mpv(c,9)/100; chaos = mpv(c,10)/100; nn = clamp(floor(mpv(c,11)), 1, 8); rep = clamp(floor(mpv(c,12)), 1, 4);
  base = mpv(c,13); dv = divOf(c,14); harm = clamp(floor(mpv(c,15)), 1, 4);
  ns = nstep(c); span = 2*ns + 1; pos = sget(c,S_XP); mel = xb(c) + 2200; pt = xb(c) + 2210; mp = xb(c) + 2300;
  ty == 0 ? (
    // TOUSSAINT: E(k, n) con rotación; un segundo anillo euclídeo decide cuándo avanza la melodía
    hit = euclid(k1, n1, rot, pos);
    euclid(k2, n2, 0, pos) ? sset(c, S_XPID, sget(c,S_XPID) + 1);
    hit ? playNote(c, t, dP(c, base, mel[pmod(sget(c,S_XPID), nn)]), dv, velOf(c), 0, 0, 0);
  );
  ty == 1 ? (
    // T-1 (Torso): euclídeo + generador de melodía de NOTAS alturas + repeticiones + armonía + modulación aleatoria
    hit = euclid(k1, n1, rot, pos);
    hit ? (
      v = mel[pmod(pt[pmod(pos, 32)], nn)];
      rnd(c) < chaos ? ( v = mel[rndi(c, nn)] + (rnd(c) < 0.5 ? ns : 0); );
      nr = rep; k = 0;
      loop(nr,
        i = 0; loop(harm, playNote(c, t + k*dv/nr, dP(c, base, v + i*2), dv/nr*0.9, clamp(velOf(c) - k*8 + (rnd(c) < chaos ? rndi(c, 30) - 15 : 0), 1, 127), 0, 0, 0); i += 1;);
        k += 1;);
    );
  );
  ty == 2 ? (
    // GRIDS: tres carriles (bombo, caja, charles) leídos de un mapa 2D interpolado por X e Y
    i = pmod(pos, 32); lane = 0;
    loop(3,
      w = (mp[lane*128 + i]*(1 - gx) + mp[lane*128 + 32 + i]*gx)*(1 - gy) + (mp[lane*128 + 64 + i]*(1 - gx) + mp[lane*128 + 96 + i]*gx)*gy;
      dl = lane == 0 ? dens : (lane == 1 ? dens*0.8 : min(1, dens*1.25));
      thr = 1 - dl; w += (rnd(c) - 0.5)*chaos*0.6;
      w > thr ? (
        nn <= 1 ? ( p = lane == 0 ? 36 : (lane == 1 ? 38 : 42); playNote(c, t, p - gTr, dv*0.5, clamp(floor(velOf(c)*(0.6 + 0.4*w)), 1, 127), 0, 0, 0); )
                : playNote(c, t, dP(c, base, lane*2), dv*0.5, clamp(floor(velOf(c)*(0.6 + 0.4*w)), 1, 127), 0, 0, 0);
      );
      lane += 1;);
  );
  ty == 3 ? (
    // ANULAR (Hemisphere: Annular Fusion + Logic): dos anillos euclídeos combinados con OR, AND, XOR o A→NOTA
    a = euclid(k1, n1, rot, pos); b = euclid(k2, n2, 0, pos);
    hit = lg == 0 ? (a || b) : (lg == 1 ? (a && b) : (lg == 2 ? (a != b) : a));
    hit ? (
      g = sget(c,S_XPID); sset(c, S_XPID, g + 1);
      v = lg == 3 ? (b ? mel[pmod(g, nn)] + ns : mel[pmod(g, nn)]) : mel[pmod(g, nn)] + (b ? 2 : 0);
      playNote(c, t, dP(c, base, v), dv, velOf(c), 0, 0, 0);
    );
  );
  sset(c, S_XP, pos + 1); sset(c, S_NEXT, t + dv); );

// ======================= REGLAS / RESTRICCIONES =======================
function intOK(d mode) local(ad) ( ad = abs(d); mode == 0 ? ad <= 2 : (mode == 1 ? (ad == 2 || ad == 4 || ad == 0) : (mode == 2 ? (ad == 3 || ad == 0) : 1)); );
// coste de la nota i de la frase (OMClouds): intervalos permitidos, salto máximo, repeticiones, triada en tiempo fuerte
function omcCost(ph L i v imode smax rep ns span) local(cst p n j)
( cst = 0; p = ph[pmod(i - 1, L)]; n = ph[pmod(i + 1, L)];
  !intOK(v - p, imode) ? (cst += 2); !intOK(n - v, imode) ? (cst += 1);
  abs(v - p) > smax ? (cst += 3); abs(n - v) > smax ? (cst += 1.5);
  j = 1; loop(rep, ph[pmod(i - j, L)] == v ? (cst += 2); j += 1;);
  (pmod(i, 4) == 0 && pmod(v, ns) != 0 && pmod(v, ns) != 2 && pmod(v, ns) != 4) ? (cst += 0.5);
  (v < 0 || v >= span) ? (cst += 10);
  cst; );
function genRules(c t) local(ty L iter imode rep smax temp base oct dv nv mov movm posi pat ns span pos ph i k best bi bv cst v sv prev g cf pcf piv ivc cand bc dir dcf mx my vx vy xd yd voices n dur w tq)
( ty = floor(mpv(c,0)); L = clamp(floor(mpv(c,1)), 4, 16); iter = floor(mpv(c,2)); imode = floor(mpv(c,3)); rep = floor(mpv(c,4));
  smax = mpv(c,5); temp = mpv(c,6)/100; base = mpv(c,7); oct = clamp(floor(mpv(c,8)), 1, 4); dv = divOf(c,9);
  nv = clamp(floor(mpv(c,10)), 2, 4); mov = mpv(c,11)/100; movm = floor(mpv(c,12)); posi = floor(mpv(c,13)); pat = floor(mpv(c,14));
  ns = nstep(c); span = oct*ns + 1; pos = sget(c,S_XP); ph = xb(c) + 800;
  ty == 0 ? (
    // OMCLOUDS: búsqueda local adaptativa; en cada vuelta corrige las notas con más conflictos
    pmod(pos, L) == 0 ? (
      rnd(c) < temp ? ( ph[rndi(c, L)] = rndi(c, span); );
      loop(iter,
        best = -1; bi = 0; i = 0;
        loop(L, cst = omcCost(ph, L, i, ph[i], imode, smax, rep, ns, span) + rnd(c)*0.01; cst > best ? ( best = cst; bi = i; ); i += 1;);
        best = 1000; bv = ph[bi]; v = 0;
        loop(span, cst = omcCost(ph, L, bi, v, imode, smax, rep, ns, span) + rnd(c)*0.3; cst < best ? ( best = cst; bv = v; ); v += 1;);
        ph[bi] = bv;
      );
    );
    playNote(c, t, dP(c, base, ph[pmod(pos, L)]), dv, velOf(c), 0, 0, 0);
  );
  ty == 1 ? (
    // SITUATION: acordes con intervalos verticales permitidos y movimiento horizontal limitado
    sv = xb(c) + 840; best = 100000; bc = xb(c) + 846; tq = xb(c) + 860;
    loop(64,
      v = clamp(sv[0] + rndi(c, 2*smax + 1) - smax, 0, span - 1); k = 0; cst = 0;
      loop(nv,
        k > 0 ? ( v += imode == 0 ? 1 + rndi(c, 2) : (imode == 1 ? 2 : (imode == 2 ? 3 : 1 + rndi(c, 4))); );
        tq[k] = v; cst += abs(v - sv[k]) + (v >= span + ns ? 20 : 0); k += 1;);
      cst += rnd(c)*2*(1 + temp*8);
      cst < best ? ( best = cst; k = 0; loop(nv, bc[k] = tq[k]; k += 1;); );
    );
    k = 0; loop(nv, sv[k] = bc[k]; playNote(c, t, dP(c, base, bc[k]), dv*1.5, velOf(c), 0, 0, 0); k += 1;);
  );
  ty == 2 ? (
    // CONTRAPUNTO (al estilo de las restricciones de bach/cage): contra la última nota de la voz guía
    g = clamp(gGuide - 1, 0, 3);
    (g == c || !lastOK[g]) ? ( playNote(c, t, dP(c, base, ph[pmod(pos, L)]), dv, velOf(c), 0, 0, 0); ) : (
      cf = lastNote[g]; pcf = sget(c,S_XPCF); prev = sget(c,S_XPREV); prev < 1 ? (prev = cf + 7); piv = sget(c,S_XPI);
      best = 100000; bv = prev; cand = posi == 0 ? cf : (posi == 1 ? cf - 19 : base);
      loop(posi == 2 ? oct*12 + 1 : 20,
        (!vp(c,V_ESC) || inScaleR(cand)) && cand != cf - 0.5 ? (
          ivc = pmod(abs(cand - cf), 12); cst = 0;
          (ivc != 0 && ivc != 3 && ivc != 4 && ivc != 7 && ivc != 8 && ivc != 9) ? (cst += 10);
          dir = sign(cand - prev); dcf = sign(cf - pcf);
          ((ivc == 0 || ivc == 7) && ivc == piv && dir == dcf && dir != 0) ? (cst += 8);
          (dir != 0 && dcf != 0) ? ( dir == -dcf ? (cst -= 1) : (cst += 1); );
          abs(cand - prev) > 4 ? (cst += (abs(cand - prev) - 4)*0.5); cand == prev ? (cst += 1.5);
          cst += rnd(c)*(0.3 + temp*2);
          cst < best ? ( best = cst; bv = cand; );
        );
        cand += 1;);
      sset(c,S_XPI, pmod(abs(bv - cf), 12)); sset(c,S_XPCF, cf); sset(c,S_XPREV, bv);
      playNote(c, t, bv - gTr, dv, velOf(c), 0, 0, 0);
    );
  );
  ty == 3 ? (
    // MUSIC MOUSE (Spiegel): un cursor X/Y mueve dos pares de voces con reglas de armonía y movimiento
    mx = sget(c,S_XX); my = sget(c,S_XY); vx = sget(c,S_XVX); vy = sget(c,S_XVY);
    pos == 0 ? ( mx = 0.5; my = 0.4; );
    vx = clamp(vx*0.9 + gauss(c)*mov*0.06, -0.2, 0.2); vy = clamp(vy*0.9 + gauss(c)*mov*0.06, -0.2, 0.2);
    mx = mirror(mx + vx, 0, 1); my = mirror(my + vy*(movm == 2 ? 0.25 : 1), 0, 1);
    sset(c,S_XX,mx); sset(c,S_XY,my); sset(c,S_XVX,vx); sset(c,S_XVY,vy);
    xd = floor(mx*span*0.8) + floor(ns/2); yd = floor((movm == 0 ? mx : (movm == 1 ? 1 - mx : my))*span*0.8) - floor(ns/2);
    voices = xb(c) + 870; voices[0] = xd; voices[1] = yd; voices[2] = xd + 2; voices[3] = yd + 2;
    pat == 0 ? ( k = 0; loop(nv, playNote(c, t, dP(c, base, voices[k]), dv*0.95, velOf(c), 0, 0, 0); k += 1;); ) : (
      k = sget(c,S_XARP); n = pat == 3 ? (pmod(k, 2) ? 1 + 2*pmod(floor(k/2), 2) : 2*pmod(floor(k/2), 2)) :
          (pat == 1 ? pmod(k, nv) : nv - 1 - pmod(k, nv));
      w = voices[clamp(n, 0, nv - 1)];
      playNote(c, t, dP(c, base, w), dv*0.9, velOf(c), 0, 0, 0);
      sset(c, S_XARP, k + 1);
    );
  );
  sset(c, S_XP, pos + 1); sset(c, S_NEXT, t + dv); );

// ======================= INTERVÁLICO / RELATIVO =======================
function inqPush(c iv) local(q h) ( q = xb(c) + 970; h = sget(c,S_XQH); q[pmod(h, 16)] = iv; sset(c, S_XQH, h + 1); );
function inqPop(c) local(q tl) ( q = xb(c) + 970; tl = sget(c,S_XQT); sset(c, S_XQT, tl + 1); q[pmod(tl, 16)]; );
function genInterval(c t) local(ty src L form sh mx peso borde base oct dv pr po ns span seq pos acc rc lr k pass f iv d sg m w s r center play deg)
( ty = floor(mpv(c,0)); src = floor(mpv(c,1)); L = clamp(floor(mpv(c,2)), 2, 32); form = floor(mpv(c,3)); sh = floor(mpv(c,4));
  mx = clamp(floor(mpv(c,5)), 1, 12); peso = mpv(c,6)/100; borde = floor(mpv(c,7)); base = mpv(c,8); oct = clamp(floor(mpv(c,9)), 1, 4);
  dv = divOf(c,10); pr = mpv(c,11)/100; po = mpv(c,12)/100;
  ns = nstep(c); span = oct*ns + 1; seq = xb(c) + 900; pos = sget(c,S_XP); acc = sget(c,S_XACC); play = 0; d = 0;
  center = floor(span/2);
  (src == 1 && sget(c,S_XQH) > sget(c,S_XQT)) ? (
    // ENTRADA: cada tecla es un intervalo respecto a REF (como el teclado relativo del Samchillian)
    iv = inqPop(c); d = floor(iv*ns/12 + 0.5); play = 1;
    ty == 0 ? ( rc = sget(c,S_XRC); seq[pmod(sget(c,S_XRP), L)] = d; sset(c, S_XRP, sget(c,S_XRP) + 1); sset(c, S_XRC, min(L, rc + 1)); );
  ) : (
    ty == 0 ? (
      // MISHA: secuencia de intervalos reproducida con formas P/R/I/RI y desplazamiento por pasada
      lr = (src == 1 && sget(c,S_XRC) > 0) ? sget(c,S_XRC) : L;
      k = pmod(pos, lr); pass = floor(pos/lr);
      f = form == 4 ? pmod(pass, 4) : (form == 5 ? ( k == 0 ? sset(c, S_XF, rndi(c, 4)); sget(c,S_XF); ) : min(form, 3));
      d = f == 0 ? seq[k] : (f == 1 ? -seq[lr - 1 - k] : (f == 2 ? -seq[k] : seq[lr - 1 - k]));
      (k == 0 && pass > 0) ? (d += sh);
      play = rnd(c) < pr;
      sset(c, S_XP, pos + 1);
    ) : (
      src == 0 ? (
        // SAMCHILLIAN automático: un intérprete elige teclas de intervalo, con preferencia por los pequeños
        s = 0; m = 0; loop(mx + 1, s += (1 - peso) + peso*exp(-m*0.9); m += 1;);
        r = rnd(c)*s; m = 0; w = (1 - peso) + peso;
        while (m < mx && r >= w) ( r -= w; m += 1; w = (1 - peso) + peso*exp(-m*0.9); );
        sg = sget(c,S_XF); sg == 0 ? (sg = 1); rnd(c) < 0.4 ? (sg = -sg); sset(c, S_XF, sg);
        d = m*sg; play = rnd(c) < pr;
      );
    );
  );
  acc += d; sset(c, S_XACC, acc);
  play ? (
    deg = borde == 0 ? foldi(center + acc, span) : wrapi(center + acc, span);
    rnd(c) < po ? ( deg += (rnd(c) < 0.5 ? -1 : 1)*ns; );
    playNote(c, t, dP(c, base, deg), dv, velOf(c), 0, 0, 0);
  );
  sset(c, S_NEXT, t + dv); );

// ---------- estado inicial de las familias nuevas ----------
function initFamilies(c) local(x i j lane ns w)
( x = xb(c); ns = nstep(c);
  i = 0; loop(3000, x[i] = 0; i += 1;);
  permute(x, 12, c); permute(x + 32, 6, c); permute(x + 64, 6, c);
  i = 0; loop(12, x[140 + i] = i; i += 1;);
  i = 0; loop(16, x[170 + i] = rnd(c); i += 1;);
  i = 0; loop(32, x[300 + i] = rnd(c) < 0.3; i += 1;);
  x[380 + 8] = 1;
  i = 0; loop(64, x[450 + i] = rndi(c, 2*ns); x[520 + i] = rnd(c); i += 1;);
  i = 0; loop(16, x[600 + i] = rnd(c); x[616 + i] = rndi(c, ns); x[632 + i] = rnd(c); x[648 + i] = 1 + rndi(c, 4); i += 1;);
  i = 0; loop(8, x[700 + i*5] = 2 + rndi(c, 6); x[701 + i*5] = 3 + rndi(c, 6); x[702 + i*5] = 1 + rndi(c, 3); x[703 + i*5] = rndi(c, 7); x[704 + i*5] = 0; i += 1;);
  i = 0; loop(16, x[800 + i] = rndi(c, 2*ns); i += 1;);
  i = 0; loop(4, x[840 + i] = 4 + i*2; i += 1;);
  i = 0; loop(32, w = rnd(c); x[900 + i] = (w < 0.5 ? 1 : (w < 0.8 ? 2 : 3 + rndi(c, 3)))*(rnd(c) < 0.5 ? -1 : 1); i += 1;);
  i = 0; loop(8, x[2200 + i] = rndi(c, 2*ns); i += 1;);
  i = 0; loop(32, x[2210 + i] = rndi(c, 8); i += 1;);
  // mapa de Grids propio: para cada carril, cuatro esquinas (rectos, contratiempos, ternario, azar)
  lane = 0;
  loop(3,
    i = 0;
    loop(32,
      j = lane*128;
      x[2300 + j + i]      = lane == 0 ? (pmod(i,8) == 0 ? 0.95 : (pmod(i,4) == 0 ? 0.5 : 0.1)) : (lane == 1 ? (pmod(i,8) == 4 ? 0.95 : 0.12) : (pmod(i,2) == 0 ? 0.8 : 0.3));
      x[2300 + j + 32 + i] = lane == 0 ? (pmod(i,4) == 0 ? 0.85 : (pmod(i,4) == 3 ? 0.4 : 0.1)) : (lane == 1 ? (pmod(i,8) == 4 || pmod(i,16) == 14 ? 0.9 : 0.15) : (pmod(i,2) == 1 ? 0.85 : 0.35));
      x[2300 + j + 64 + i] = pmod(i, 3) == 0 ? 0.8 : 0.2 + 0.15*rnd(c);
      x[2300 + j + 96 + i] = rnd(c);
      i += 1;);
    lane += 1;);
  sset(c, S_XN, 0); sset(c, S_XK, -1); );

// ======================= reinicio =======================
function resetVoice(c) local(i vb ga gd gpa gpd reg rc p k ah vv hh)
( seedrng(c, vp(c,V_SEED) + gSeed*1000 + c*7);
  i = 0; loop(100, sset(c, i, 0); i += 1;);
  sset(c, S_SECTON, 1); sset(c, S_PREVP, (vp(c,V_MODE) <= 1) ? mpv(c,4) : 0); sset(c, S_RELOC, 1); sset(c, S_PMODE, vp(c,V_MODE));
  sset(c, S_CHI, -1); sset(c, S_HITS, 4);
  vb = vbase(c); ga = vb + O_GA; gd = vb + O_GD; gpa = vb + O_GPA; gpd = vb + O_GPD; reg = vb + O_REG;
  i = 0; loop(32, ga[i] = 0; gd[i] = 0.5; gpa[i] = 0; gpd[i] = 0; i += 1;);
  i = 0; loop(16, reg[i] = rnd(c) < 0.5; i += 1;);
  newTrunk(c); saveUndo(c);
  // corpus al azar del modo MARKOV y memoria de voces/historias
  rc = 50000 + c*200; p = 60;
  i = 0; loop(64, p = mirror(p + rndi(c, 7) - 3, 48, 84); k = 0; while (!inScale(p) && k < 12) ( p += 1; k += 1; );
                  rc[i] = p; rc[64 + i] = rnd(c) < 0.5 ? 5 : (rnd(c) < 0.5 ? 2 : (rnd(c) < 0.5 ? 8 : 7)); rc[128 + i] = 60 + rndi(c, 50); i += 1;);
  ah = vb + O_AH; i = 0; loop(32, ah[i] = 0; i += 1;); vv = vb + O_VV; i = 0; loop(4, vv[i] = 0; i += 1;);
  hh = vb + O_MH; i = 0; loop(20, hh[i] = 0; i += 1;);
  initFamilies(c);
  lastOK[c] = 0; bendUsed[c] = 1; rAct[c] = 0; oSeedV[c] = vp(c,V_SEED); );
function resetAll() local(c) ( seedrng(4, gSeed*31 + 777); c = 0; loop(4, resetVoice(c); c += 1;); evN = 0; );

// ======================= presets =======================
function parseNums(str dest) local(i n ch v sgn frac dv inNum k)
( n = strlen(str); i = 0; k = 0; v = 0; sgn = 1; frac = 0; dv = 1; inNum = 0;
  while (i <= n) (
    ch = i < n ? str_getchar(str, i) : 32;
    ch == 45 ? ( sgn = -1; inNum = 1; ) : (
      ch == 46 ? ( frac = 1; inNum = 1; ) : (
        (ch >= 48 && ch <= 57) ? ( frac ? ( dv *= 10; v += (ch - 48)/dv; ) : ( v = v*10 + ch - 48; ); inNum = 1; ) : (
          inNum ? ( dest[k] = sgn*v; k += 1; ); v = 0; sgn = 1; frac = 0; dv = 1; inNum = 0;
        ); ); );
    i += 1;);
  k; );
function setSl(idx v) ( slider(idx) = v; sliderchange(slider(idx)); );
// escribe en los sliders el preset pi (0..255): globales musicales y las cuatro voces (el canal solo si el preset lo fija)
function applyPreset(pi) local(b c vb o k)
( b = 140000;
  parseNums(prData[pi], b) >= 121 ? (
    setSl(2, b[0]); k = 1; loop(7, setSl(2 + k, b[k]); k += 1;); setSl(12, b[8]);
    c = 0;
    loop(4,
      vb = 21 + c*30; o = b + 9 + c*28;
      setSl(vb, o[0]); o[1] >= 1 ? setSl(vb + 1, o[1]); setSl(vb + 2, o[2]);
      k = 3; loop(7, setSl(vb + k, o[k]); k += 1;);
      setSl(vb + 26, o[10]); setSl(vb + 27, o[11]);
      k = 0; loop(16, setSl(vb + 10 + k, o[12 + k]); k += 1;);
      c += 1;);
  ); );

function applySliders() local(c k pr)
( // preset: se aplica cuando cambia el slider 17 (desde la interfaz o por automatización), nunca al abrir el proyecto
  pr = floor(slider17 + 0.5);
  !inited ? ( prLoaded = pr; ) : (
    (pr != prLoaded && pr >= 1 && pr <= prN[0]) ? ( applyPreset(pr - 1); prPending = 1; );
    prLoaded = pr;
  );
  gClock = slider1; gTempo = slider2; gRoot = slider3; gScale = slider4; gGrid = slider5; gQ = slider6;
  gHD = slider7; gGuide = slider8; gContra = slider9; gBendR = slider10; gReset = slider11; gSeed = slider12;
  gTrMode = slider13; gRef = slider14; gThru = slider15; gInCh = slider16; trUpdate();
  c = 0; loop(4, k = 0; loop(28, prmv[c*40 + k] = slider(21 + c*30 + k); k += 1;); c += 1;);
  loadScale();
  !inited ? ( resetAll(); inited = 1; oGSeed = gSeed; ) : (
    gSeed != oGSeed ? ( resetAll(); oGSeed = gSeed; );
    c = 0; loop(4, (vp(c,V_SEED) != oSeedV[c] || vp(c,V_MODE) != sget(c,S_PMODE)) ? resetVoice(c); c += 1;);
  );
  prPending ? ( prPending = 0; resetAll(); oGSeed = gSeed; prFlush = 1; ); );


@slider
applySliders();

@block
uiDirty ? ( uiDirty = 0; applySliders(); );
prFlush ? ( prFlush = 0; flushAll(); );
// MIDI de entrada: transposición, corpus del modo MARKOV y paso opcional a la salida
while (midirecv(mofs, m1, m2, m3)) (
  mst = m1 & 0xF0;
  (gInCh == 0 || (m1 & 15) == gInCh - 1) ? (
    (mst == 0x90 && m3 > 0) ? ( inHeld[m2] = 1; inLast = m2; corpusAdd(m2, m3, mofs); trUpdate();
      // modo INTERVÁLICO con fuente ENTRADA: cada tecla es un intervalo respecto a REF
      cc = 0; loop(4, (vp(cc,V_ON) && clamp(vp(cc,V_MODE),0,13) == 13 && floor(mpv(cc,1)) == 1) ? inqPush(cc, m2 - gRef); cc += 1;); ) :
    ((mst == 0x80 || mst == 0x90) ? ( inHeld[m2] = 0; trUpdate(); ));
  );
  gThru ? midisend(mofs, m1, m2, m3);
);
// órdenes de la interfaz
cc = 0;
loop(4,
  bCmd[cc] == 1 ? ( saveUndo(cc); newTrunk(cc); );
  bCmd[cc] == 2 ? undoTrunk(cc);
  bCmd[cc] = 0;
  testReq[cc] ? (
    testReq[cc] = 0; tch = clamp(vp(cc,V_CH) - 1, 0, 15);
    qpush(absS, 0x90|tch, lastOK[cc] ? lastNote[cc] : 60, 100); qpush(absS + srate*0.25, 0x80|tch, lastOK[cc] ? lastNote[cc] : 60, 0);
    hitTime[cc] = time_precise(); hitVel[cc] = 100;
  );
  cc += 1;);

playing = (play_state & 1) != 0;
hostMode = gClock == 0 || (gClock == 2 && playing);
hostMode ? ( run = playing; b0 = beat_position; btempo = tempo; ) : ( run = 1; b0 = fb; btempo = gTempo; );
btempo = max(btempo, 1);
spb = srate*60/btempo; b1 = b0 + samplesblock/spb; bStart = b0;
!hostMode ? (fb = b1);
barQ = ts_num*4/max(1, ts_denom); barQ <= 0 ? (barQ = 4);

(hostMode && playing && !wasPlaying && gReset) ? ( flushAll(); resetAll(); );
(gClock == 0 && !playing && wasPlaying) ? flushAll();
(wasHost != hostMode) ? flushAll();
relocated = !wasRun || abs(b0 - prevEnd) > 0.02 || wasHost != hostMode;

run ? (
  curBeat = b1;
  ci = 0;
  loop(4,
    // la voz guía se procesa primero para que las demás se ajusten a su nota actual
    cc = ci == 0 ? clamp(gGuide - 1, 0, 3) : (ci <= clamp(gGuide - 1, 0, 3) ? ci - 1 : ci);
    vp(cc,V_ON) ? (
      md = clamp(vp(cc,V_MODE), 0, 13);
      (relocated || sget(cc,S_RELOC)) ? (
        md == 2 ? ( dvv = divt[clamp(floor(mpv(cc,4)),0,16)]; sset(cc, S_NEXT, ceil(b0/dvv - 0.0000001)*dvv); ) : (
        md == 3 ? ( dvv = divt[clamp(floor(mpv(cc,7)),0,16)]; sset(cc, S_NEXT, ceil(b0/dvv - 0.0000001)*dvv); ) : (
        md == 4 ? ( dvv = max(0.25, mpv(cc,0)); sset(cc, S_NEXT, ceil(b0/dvv - 0.0000001)*dvv); ) : (
        md == 5 ? ( dvv = divt[clamp(floor(mpv(cc,6)),0,16)]; sset(cc, S_NEXT, ceil(b0/dvv - 0.0000001)*dvv); sset(cc, S_TCNT, floor(sget(cc,S_NEXT)/dvv + 0.5)); ) :
        ( md >= 7 ? ( dvv = divt[clamp(floor(mpv(cc,mDivK[md])),0,16)]; sset(cc, S_NEXT, ceil(b0/dvv - 0.0000001)*dvv);
                    (md == 10 || md == 11) ? sset(cc, S_XP, floor(sget(cc,S_NEXT)/dvv + 0.5)); ) :
                  ( sset(cc, S_NEXT, b0); ) ) ) ) );
        sset(cc, S_SECTEND, b0); sset(cc, S_RELOC, 0);
      );
      guard = 0;
      while (sget(cc,S_NEXT) < b1 && guard < 64) (
        tev = max(sget(cc,S_NEXT), b0);
        md == 0 ? genEstoc(cc, tev) : (md == 1 ? genGendyn(cc, tev) : (md == 2 ? genTuring(cc, tev) : (md == 3 ? genBloom(cc, tev) :
        (md == 4 ? genAnalog(cc, tev) : (md == 5 ? genSubseq(cc, tev) : (md == 6 ? genMarkov(cc, tev) :
        (md == 7 ? genSerial(cc, tev) : (md == 8 ? genFractal(cc, tev) : (md == 9 ? genAuto(cc, tev) :
        (md == 10 ? genSpace(cc, tev) : (md == 11 ? genEuclid(cc, tev) : (md == 12 ? genRules(cc, tev) : genInterval(cc, tev)))))))))))));
        guard += 1;
      );
    );
    ci += 1;);
);
rampBlock(absS, samplesblock);
processQueue(absS, samplesblock);
absS += samplesblock; prevEnd = b1; wasPlaying = playing; wasRun = run; wasHost = hostMode;

@serialize
file_mem(0, MEM, NMEM*MEMSTRIDE);
file_var(0, inN);
file_mem(0, inP, 512); file_mem(0, inD, 512); file_mem(0, inV, 512);

@gfx 1280 650
// ---- toda la UI se dibuja a 1180x636 en un buffer y se reescala a la ventana (como GenderBender P23) ----
UI_W = 1280; UI_H = 650; UI_BUF = 10;
!uiInit ? ( gfx_setimgdim(UI_BUF, UI_W, UI_H); uiInit = 1; );
uiScale = max(0.1, min(gfx_w/UI_W, gfx_h/UI_H));
uiOffX = floor((gfx_w - UI_W*uiScale)/2);
uiOffY = floor((gfx_h - UI_H*uiScale)/2);
mx = (mouse_x - uiOffX)/uiScale;
my = (mouse_y - uiOffY)/uiScale;
clickL = (mouse_cap & 1) && !(lastCap & 1);
clickR = (mouse_cap & 2) && !(lastCap & 2);
modCtrl = mouse_cap & 4;
modShift = mouse_cap & 8;
!(mouse_cap & 1) ? ( dragId = -1; );
wheel = mouse_wheel; mouse_wheel = 0;
nowT = time_precise();
strcpy(#help, "Pasa el ratón por encima de un control para ver qué hace. Arrastra en vertical (Mayús = fino), rueda, clic derecho = valor inicial.");

gfx_dest = UI_BUF;
gfx_mode = 0;
gfx_set(0.075, 0.075, 0.08, 1);
gfx_rect(0, 0, UI_W, UI_H);

function chColor(c, a)(
  c == 0 ? gfx_set(0.96, 0.52, 0.22, a);   // naranja
  c == 1 ? gfx_set(0.66, 0.50, 0.98, a);   // violeta
  c == 2 ? gfx_set(0.30, 0.80, 0.90, a);   // cian
  c == 3 ? gfx_set(0.80, 0.88, 0.32, a);   // lima
  c == 4 ? gfx_set(0.95, 0.80, 0.45, a);   // dorado (presets)
  c == 4 ? gfx_set(0.95, 0.80, 0.45, a);   // oro (global)
);
function hover(x, y, w, h)( mx >= x && mx < x+w && my >= y && my < y+h; );
function textC(str, cx, y) local(w, h)( gfx_measurestr(str, w, h); gfx_x = floor(cx - w/2); gfx_y = y; gfx_drawstr(str); );
function textAt(str, x, y)( gfx_x = x; gfx_y = y; gfx_drawstr(str); );
function textFit(str, x, y, maxw) local(w, h, n)(
  strcpy(#tf, str); gfx_measurestr(#tf, w, h); n = strlen(#tf);
  while (w > maxw && n > 1) ( n -= 1; strcpy_substr(#tf, str, 0, n); strcat(#tf, ".."); gfx_measurestr(#tf, w, h); );
  gfx_x = x; gfx_y = y; gfx_drawstr(#tf);
);
function wrapText(s, x, y, w, lh, maxl) local(n, i, ch, s0, ls, tw, th, ln)(
  n = strlen(s); s0 = 0; ls = -1; i = 0; ln = 0;
  while (i <= n && ln < maxl) (
    ch = i < n ? str_getchar(s, i) : 32;
    ch == 32 ? (
      strcpy_substr(#wr, s, s0, i - s0); gfx_measurestr(#wr, tw, th);
      (tw > w && ls > s0) ? ( strcpy_substr(#wr, s, s0, ls - s0); textAt(#wr, x, y + ln*lh); ln += 1; s0 = ls + 1; );
      ls = i;
    );
    i += 1;
  );
  (s0 < n && ln < maxl) ? ( strcpy_substr(#wr, s, s0, n - s0); textAt(#wr, x, y + ln*lh); ln += 1; );
);
function frame(x, y, w, h)(
  gfx_set(0.38, 0.38, 0.40, 1);
  gfx_rect(x, y, w, 1); gfx_rect(x, y+h-1, w, 1); gfx_rect(x, y, 1, h); gfx_rect(x+w-1, y, 1, h);
);
function button(x, y, w, h, label) local(hv)(
  hv = hover(x, y, w, h);
  hv ? gfx_set(0.27, 0.27, 0.29, 1) : gfx_set(0.16, 0.16, 0.17, 1);
  gfx_rect(x, y, w, h); frame(x, y, w, h);
  gfx_set(0.92, 0.92, 0.92, 1);
  textC(label, x + w/2, y + (h - gfx_texth)/2);
  hv && clickL;
);
// botón de dos estados con el color de la voz
function toggle(x, y, w, h, label, on, c) local(hv)(
  hv = hover(x, y, w, h);
  on ? chColor(c, hv ? 1 : 0.85) : (hv ? gfx_set(0.27, 0.27, 0.29, 1) : gfx_set(0.16, 0.16, 0.17, 1));
  gfx_rect(x, y, w, h); frame(x, y, w, h);
  on ? gfx_set(0.08, 0.08, 0.08, 1) : gfx_set(0.6, 0.6, 0.62, 1);
  textC(label, x + w/2, y + (h - gfx_texth)/2);
  hv && clickL;
);
function setSlider(idx, v)(
  slider(idx) != v ? (
    slider(idx) = v;
    sliderchange(slider(idx));
    slider_automate(slider(idx));
    uiDirty = 1;
  );
);
// selector con flechas < > (como STYLE en el P23): devuelve -1, +1, 2 (clic en el centro) o 0
function selector(x, y, w, label, c) local(hv, r)(
  r = 0;
  button(x, y, 13, 20, "<") ? (r = -1);
  button(x + w - 13, y, 13, 20, ">") ? (r = 1);
  hv = hover(x + 15, y, w - 30, 20);
  hv ? gfx_set(0.22, 0.22, 0.24, 1) : gfx_set(0.15, 0.15, 0.16, 1);
  gfx_rect(x + 15, y, w - 30, 20);
  chColor(c, 1); gfx_setfont(4);
  textC(label, x + w/2, y + 3);
  (hv && clickL) ? (r = 2);
  (hv && wheel != 0) ? ( r = wheel > 0 ? -1 : 1; );
  r;
);
function popup(x, y)( gfx_x = x*uiScale + uiOffX; gfx_y = y*uiScale + uiOffY; gfx_dest = -1; uiR = gfx_showmenu(#menu); gfx_dest = UI_BUF; uiR; );
function listMenu(names, n, cur) local(i)(
  strcpy(#menu, ""); i = 0;
  loop(n, i > 0 ? strcat(#menu, "|"); i == cur ? strcat(#menu, "!"); strcat(#menu, names[i]); i += 1;);
);

// texto del valor de un parámetro según su formato
function noteName(v) local(n)( n = floor(v + 0.5); sprintf(#nn, "%s%d", nmNote[n - floor(n/12)*12], floor(n/12) - 1); #nn; );
function fmtVal(v, kind, en)(
  kind == 0 ? sprintf(#fv, "%d", floor(v + 0.5));
  kind == 1 ? sprintf(#fv, "%d%%", floor(v + 0.5));
  kind == 2 ? sprintf(#fv, "%.2f", v);
  kind == 3 ? strcpy(#fv, noteName(v));
  kind == 4 ? strcpy(#fv, nmEnum[enBase[en] + floor(v + 0.0001)]);
  kind == 5 ? sprintf(#fv, "%.2f t", v);
  kind == 6 ? sprintf(#fv, "%d st", floor(v + 0.5));
  kind == 7 ? strcpy(#fv, nmDiv[max(0, min(16, floor(v)))]);
  kind == 8 ? sprintf(#fv, "%.2f/t", v);
  kind == 9 ? ( v < 1 ? strcpy(#fv, "OFF") : sprintf(#fv, "%d comp", v); );
  kind == 10 ? strcpy(#fv, v >= 0.5 ? "ON" : "OFF");
  kind == 11 ? sprintf(#fv, "%d ct", floor(v + 0.5));
  kind == 12 ? ( v < 1 ? strcpy(#fv, "LIBRE") : sprintf(#fv, "%d t", v); );
  kind == 13 ? ( v >= 97 ? strcpy(#fv, "BLOQ") : (v <= 3 ? strcpy(#fv, "BLOQ x2") : ((v >= 45 && v <= 55) ? strcpy(#fv, "AZAR") : sprintf(#fv, "%d%%", v))); );
  kind == 14 ? ( v < 1 ? strcpy(#fv, "TODOS") : sprintf(#fv, "BIT %d", v); );
  kind == 15 ? sprintf(#fv, "%d oct", v);
  kind == 16 ? ( v > 0 ? sprintf(#fv, "+%d oct", v) : sprintf(#fv, "%d oct", v); );
  #fv;
);
// knob: arrastrar en vertical (shift = fino), rueda, ctrl+clic o clic derecho = valor por defecto
function knob(cx, cy, idx, mn, mx_, def, st, label, vtxt, c, hlp) local(r, v, norm, a0, a1, av, hv, range, sens, kv, i)(
  r = 13; v = slider(idx); range = mx_ - mn;
  hv = hover(cx - r - 8, cy - r - 14, 2*r + 16, 2*r + 30);
  hv ? strcpy(#help, hlp);
  hv && clickL && !modCtrl ? ( dragId = idx; dragY = my; dragV = v; );
  hv && (clickR || (clickL && modCtrl)) ? ( setSlider(idx, def); v = def; dragId = -1; );
  dragId == idx && (mouse_cap & 1) ? (
    sens = modShift ? 900 : 180;
    kv = dragV + (dragY - my) / sens * range;
    range/st < 30 ? kv = dragV + (dragY - my) / (modShift ? 40 : 12) * st;
    kv = max(mn, min(mx_, floor(kv / st + 0.5) * st));
    setSlider(idx, kv); v = kv;
  );
  hv && wheel != 0 ? (
    kv = v + (wheel > 0 ? 1 : -1) * (modShift ? st : max(st, floor(range/50/st + 0.5)*st));
    kv = max(mn, min(mx_, floor(kv / st + 0.5) * st));
    setSlider(idx, kv); v = kv;
  );
  norm = range > 0 ? (max(mn, min(mx_, v)) - mn) / range : 0;
  a0 = -0.75*$pi; a1 = 0.75*$pi; av = a0 + norm*(a1 - a0);
  gfx_set(0.30, 0.30, 0.33, 1);
  i = 0; loop(3, gfx_arc(cx, cy, r - i, a0, a1, 1); i += 1;);
  chColor(c, hv || dragId == idx ? 1 : 0.85);
  mn < 0 && mx_ > 0 ? ( i = 0; loop(3, gfx_arc(cx, cy, r - i, min(0, av), max(0, av), 1); i += 1;); )
                    : ( i = 0; loop(3, gfx_arc(cx, cy, r - i, a0, av, 1); i += 1;); );
  gfx_set(0.13, 0.13, 0.14, 1); gfx_circle(cx, cy, r - 4, 1, 1);
  gfx_set(0.93, 0.93, 0.93, 1);
  gfx_line(cx + sin(av)*3, cy - cos(av)*3, cx + sin(av)*(r-4), cy - cos(av)*(r-4), 1);
  gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1); textC(label, cx, cy - r - 13);
  gfx_set(0.90, 0.90, 0.90, 1); textC(vtxt, cx, cy + r + 3);
);
// knob de parámetro de modo k de la voz c
function modeKnob(c, m, k, cx, cy) local(i, idx)(
  i = m*16 + k; idx = 21 + c*30 + 10 + k;
  strlen(mpLab[i]) > 0 ? (
    sprintf(#mh, "%s · %s", mpLab[i], mpHelp[i]);
    knob(cx, cy, idx, mpMin[i], mpMax[i], mpDef[i], mpStep[i], mpLab[i], fmtVal(max(mpMin[i], min(mpMax[i], slider(idx))), mpFmt[i], mpEnum[i]), c, #mh);
  );
);
function setMode(c, m) local(k, i)(
  setSlider(21 + c*30 + 2, m);
  k = 0; loop(16, i = m*16 + k; setSlider(21 + c*30 + 10 + k, mpDef[i]); k += 1;);
  setSlider(21 + c*30 + 8, m == 0 ? 80 : (m == 1 ? 100 : (m == 2 ? 60 : (m == 3 ? 70 : (m == 4 ? 100 : (m == 5 ? 85 : (m == 6 ? 90 : (m == 12 ? 95 : 75))))))));
  m == 4 || m == 6 ? setSlider(21 + c*30 + 6, 100);
);

// ---------- vistas de cada modo ----------
function viewEstoc(c, x, y, w, h) local(i, n, t, p, xx, yy, cen, an, lo, hi, bt)(
  cen = slider(21 + c*30 + 14); an = slider(21 + c*30 + 15); lo = cen - an - 2; hi = cen + an + 2;
  gfx_set(0.22, 0.22, 0.25, 1); gfx_rect(x, y + h/2, w, 1);
  i = 0; n = min(evN, 512);
  loop(n,
    bt = (evN - 1 - i); bt = bt - floor(bt/512)*512;
    evV[bt] == c && evT[bt] > curBeat - 8 ? (
      xx = x + w - (curBeat - evT[bt])/8*w; yy = y + h - 3 - (evP[bt] - lo)/max(1, hi - lo)*(h - 6);
      chColor(c, 0.35 + 0.65*evVel[bt]/127); gfx_rect(xx, max(y, min(y + h - 3, yy)), max(2, evD[bt]/8*w), 3);
    );
    i += 1;);
);
function viewGendyn(c, x, y, w, h) local(vb, n, i, s, cx, px, py, qx, qy, tmin, tmax, d, per, cur, bar)(
  vb = 40000 + c*1000; n = max(3, min(32, floor(slider(21 + c*30 + 10))));
  tmin = slider(21 + c*30 + 20); tmax = max(tmin, slider(21 + c*30 + 21)); per = slider(21 + c*30 + 22);
  bar = slider(21 + c*30 + 17)/100;
  gfx_set(0.22, 0.22, 0.25, 1); gfx_rect(x, y + h/2, w, 1);
  gfx_set(0.45, 0.25, 0.25, 1); gfx_rect(x, y + h/2 - bar*(h/2 - 3), w, 1); gfx_rect(x, y + h/2 + bar*(h/2 - 3), w, 1);
  s = 0; i = 0; loop(n, s += per > 0 ? vb[40 + i] + 0.02 : tmin + (tmax - tmin)*vb[40 + i]; i += 1;);
  cur = 34000 + c*100 + 6; cur = cur[0];
  cx = 0; i = 0;
  loop(n + 1,
    px = x + cx/max(0.0001, s)*w; py = y + h/2 - vb[(i - floor(i/n)*n)]*(h/2 - 3);
    i > 0 ? ( chColor(c, 0.9); gfx_line(qx, qy, px, py, 1); );
    i < n ? ( (i == cur) ? gfx_set(1, 1, 1, 1) : chColor(c, 1); gfx_rect(px - 2, py - 2, 4, 4); );
    qx = px; qy = py;
    d = per > 0 ? vb[40 + (i - floor(i/n)*n)] + 0.02 : tmin + (tmax - tmin)*vb[40 + (i - floor(i/n)*n)];
    cx += d; i += 1;);
);
function viewTuring(c, x, y, w, h) local(vb, len, i, bw, v)(
  vb = 40000 + c*1000; len = max(2, min(16, floor(slider(21 + c*30 + 11)))); bw = w/16;
  i = 0;
  loop(16,
    vb[160 + i] ? chColor(c, i < len ? 1 : 0.35) : gfx_set(i < len ? 0.22 : 0.13, i < len ? 0.22 : 0.13, i < len ? 0.25 : 0.15, 1);
    gfx_rect(x + i*bw + 1, y + 6, bw - 2, 18);
    i += 1;);
  gfx_set(0.6, 0.6, 0.62, 1); gfx_rect(x, y + 28, len*bw, 1);
  v = 0; i = 0; loop(8, v = v*2 + vb[160 + i]; i += 1;);
  gfx_set(0.18, 0.18, 0.2, 1); gfx_rect(x, y + 36, w, 10);
  chColor(c, 0.9); gfx_rect(x, y + 36, w*v/255, 10);
  gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1); sprintf(#tv, "DAC %d / 255", v); textAt(#tv, x, y + 50);
);
function viewBloom(c, x, y, w, h) local(vb, len, br, i, bw, v, mn, mx2, cur, dep, yy, sil)(
  vb = 40000 + c*1000; len = max(1, min(32, floor(slider(21 + c*30 + 10)))); br = max(0, min(7, floor(slider(21 + c*30 + 11))));
  sil = slider(21 + c*30 + 18)/100;
  bw = w/len; mn = vb[600]; mx2 = vb[600]; i = 0; loop(len, mn = min(mn, vb[600 + i]); mx2 = max(mx2, vb[600 + i]); i += 1;);
  cur = 34000 + c*100 + 11; cur = cur[0]; dep = 34000 + c*100 + 12; dep = dep[0];
  i = 0;
  loop(len,
    v = vb[600 + i]; yy = (v - mn)/max(1, mx2 - mn)*(h - 22);
    vb[640 + i] >= sil ? chColor(c, i == cur ? 1 : 0.65) : gfx_set(0.2, 0.2, 0.22, 1);
    gfx_rect(x + i*bw + 1, y + h - 16 - yy - 4, max(1, bw - 2), 4 + yy);
    i == cur ? ( gfx_set(1, 1, 1, 1); gfx_rect(x + i*bw + 1, y + h - 12, max(1, bw - 2), 2); );
    i += 1;);
  i = 0; loop(br + 1, i == dep ? chColor(c, 1) : gfx_set(0.3, 0.3, 0.32, 1); gfx_circle(x + 5 + i*12, y + h - 4, 3, 1, 1); i += 1;);
);

function viewAnalog(c, x, y, w, h) local(sb, s, i, bw, cnt, a, sp, st)(
  sb = 34000 + c*100; s = sb[20]; cnt = sb[24]; bw = w/8;
  i = 0;
  loop(8,
    i == s && cnt > 0 ? chColor(c, 1) : gfx_set(0.18, 0.18, 0.2, 1);
    gfx_rect(x + i*bw + 1, y + 2, bw - 2, 20);
    i == s && cnt > 0 ? gfx_set(0.08, 0.08, 0.08, 1) : gfx_set(0.6, 0.6, 0.62, 1);
    gfx_setfont(5); textC(nmEnum[enBase[5] + i], x + i*bw + bw/2, y + 6);
    i += 1;);
  a = 40000 + c*1000 + 800; i = 0;
  loop(min(cnt, 32),
    st = a[(cnt - 1 - i) - floor((cnt - 1 - i)/32)*32];
    chColor(c, 0.25 + 0.75*(st + 1)/8);
    gfx_rect(x + w - (i + 1)*w/32, y + 30 + (7 - st)*2.5, w/32 - 1, 4);
    i += 1;);
  gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1);
  slider(21 + c*30 + 14) >= 0.5 ? (
    sp = sb[25]; sprintf(#an, "sección %d · %s", floor(max(0, cnt - 1)/30) + 1, sp ? "perturbada" : "equilibrio");
    sp ? ( strcat(#an, " → "); strcat(#an, nmEnum[enBase[5] + sb[26]]); );
  ) : ( sprintf(#an, "pantalla %d", cnt); );
  textAt(#an, x, y + h - 12);
);
function viewSubseq(c, x, y, w, h) local(sb, vb, root, n, i, rel, h3, h4, h6, ci, form, gr, bw, fz, st, hits, rot, j, sec)(
  sb = 34000 + c*100; vb = 40000 + c*1000; root = sb[29]; n = sb[34];
  h3 = h4 = h6 = 0; i = 0; loop(n, rel = vb[880 + i] - root; rel -= floor(rel/12)*12; rel == 3 ? (h3 = 1); rel == 4 ? (h4 = 1); rel == 6 ? (h6 = 1); i += 1;);
  gfx_setfont(1); chColor(c, 1);
  sprintf(#sq, "%s%s", nmNote[root], h4 ? "" : (h3 && h6 ? "dim" : (h3 ? "m" : "")));
  textAt(#sq, x, y + 2);
  ci = sb[27]; form = floor(slider(21 + c*30 + 14)); gr = floor(slider(21 + c*30 + 11));
  sec = floor(max(0, ci)/4);
  gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1);
  sprintf(#sq2, form == 0 ? "en vivo" : (form == 1 ? "progresión fija" : (sec - floor(sec/4)*4 == 2 ? "sección B (en vivo)" : "sección A (fija)")));
  textAt(#sq2, x + 60, y + 6);
  bw = w/4; i = 0;
  loop(4,
    j = ci - floor(ci/4)*4;
    i == j ? chColor(c, 0.9) : gfx_set(0.18, 0.18, 0.2, 1);
    gfx_rect(x + i*bw + 1, y + 24, bw - 2, 6);
    i += 1;);
  st = sb[7]; hits = sb[36]; rot = sb[35]; bw = w/16; i = 0;
  loop(16,
    j = i + rot; j -= floor(j/16)*16;
    (j*hits - floor(j*hits/16)*16) < hits ? chColor(c, (i == (st - 1) - floor((st - 1)/16)*16) ? 1 : 0.5) : gfx_set(0.18, 0.18, 0.2, 1);
    gfx_circle(x + i*bw + bw/2, y + 44, 3, 1, 1);
    i += 1;);
);
function viewMarkov(c, x, y, w, h) local(sb, src, n, i, p, lo, hi, bw, pos, cnt)(
  sb = 34000 + c*100; src = floor(slider(21 + c*30 + 10));
  gfx_setfont(3); gfx_set(0.6, 0.6, 0.62, 1);
  cnt = src == 0 ? inN : 0;
  src == 0 && inN < 3 ? ( chColor(c, 1); textAt("toca algo en la entrada MIDI", x, y + 2); gfx_set(0.6, 0.6, 0.62, 1); textAt("(mientras, usa el corpus al azar)", x, y + 16); ) : (
    sprintf(#mk, "corpus %d notas · orden %d", sb[42], slider(21 + c*30 + 11)); textAt(#mk, x, y + 2);
    sprintf(#mk2, "coincidencias: %d", sb[41]); textAt(#mk2, x, y + 16);
  );
  src == 0 && inN > 0 ? (
    n = min(inN, 32); bw = w/32; lo = 127; hi = 0;
    i = 0; loop(n, pos = (inN - n + i) - floor((inN - n + i)/512)*512; lo = min(lo, inP[pos]); hi = max(hi, inP[pos]); i += 1;);
    i = 0; loop(n, pos = (inN - n + i) - floor((inN - n + i)/512)*512; p = (inP[pos] - lo)/max(1, hi - lo);
      chColor(c, 0.6); gfx_rect(x + (32 - n + i)*bw, y + h - 6 - p*24, bw - 1, 3); i += 1;);
  );
);

// ---------- presets ----------
// el motor carga el preset cuando cambia el slider 17
function loadPreset(pi)( setSlider(17, pi + 1); curMem = -1; );

// ---------- vistas de las familias 1.2 ----------
function xbG(c) ( 120000 + c*3000; );
function sgG(c i) local(ad) ( ad = 34000 + c*100 + i; ad[0]; );
function mpG(c k) ( slider(21 + c*30 + 10 + k); );
// rollo genérico con escala automática (últimos 8 tiempos)
function viewRoll(c, x, y, w, h) local(i, n, bt, lo, hi, xx, yy)(
  lo = 127; hi = 0; i = 0; n = min(evN, 512);
  loop(n, bt = (evN - 1 - i); bt = bt - floor(bt/512)*512;
    evV[bt] == c && evT[bt] > curBeat - 8 ? ( lo = min(lo, evP[bt]); hi = max(hi, evP[bt]); ); i += 1;);
  lo -= 2; hi += 2;
  gfx_set(0.18, 0.18, 0.2, 1); gfx_rect(x, y + h/2, w, 1);
  i = 0;
  loop(n, bt = (evN - 1 - i); bt = bt - floor(bt/512)*512;
    evV[bt] == c && evT[bt] > curBeat - 8 ? (
      xx = x + w - (curBeat - evT[bt])/8*w; yy = y + h - 3 - (evP[bt] - lo)/max(1, hi - lo)*(h - 6);
      chColor(c, 0.35 + 0.65*evVel[bt]/127); gfx_rect(xx, max(y, min(y + h - 3, yy)), max(2, evD[bt]/8*w), 3);
    ); i += 1;);
);
function ringDraw(cx, cy, r, n, k, rot, cur, c, al) local(i, a, on, px, py)(
  n = max(1, floor(n)); k = max(0, min(n, floor(k)));
  gfx_set(0.25, 0.25, 0.27, 1); gfx_circle(cx, cy, r, 0, 1);
  i = 0;
  loop(n,
    a = 2*$pi*i/n; px = cx + sin(a)*r; py = cy - cos(a)*r;
    on = ((((i + rot) - floor((i + rot)/n)*n)*k) - floor((((i + rot) - floor((i + rot)/n)*n)*k)/n)*n) < k;
    on ? chColor(c, al) : gfx_set(0.22, 0.22, 0.24, 1);
    gfx_circle(px, py, i == cur ? 4 : 2.5, 1, 1);
    i == cur ? ( gfx_set(1, 1, 1, 1); gfx_circle(px, py, 5, 0, 1); );
    i += 1;);
);
function viewSerial(c, x, y, w, h) local(xb, ty, n, i, bw, pos, k, v, txt)(
  xb = xbG(c); ty = floor(mpG(c,0)); n = max(3, min(12, floor(mpG(c,1)))); bw = w/12;
  pos = sgG(c, 44); k = pos - floor(pos/n)*n;
  i = 0;
  loop(n, v = xb[i]/max(1, n - 1);
    (ty >= 2 && i == k) ? gfx_set(1, 1, 1, 1) : chColor(c, 0.6);
    gfx_rect(x + i*bw + 1, y + h - 14 - v*(h - 20), bw - 2, 3 + v*(h - 20)*0.15);
    i += 1;);
  gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1);
  ty <= 1 ? sprintf(#sx, "%s · último grado %d", ty == 0 ? "PR1 Koenig" : "PR2 Koenig", sgG(c, 53)) : sprintf(#sx, "serie de %d · vuelta %d", n, floor(pos/n));
  textAt(#sx, x, y + h - 10);
);
function viewAuto(c, x, y, w, h) local(xb, ty, i, j, cs, a, nc, e)(
  xb = xbG(c); ty = floor(mpG(c,0));
  ty == 0 ? (
    cs = min(floor(h/9), 7); a = xb + 200; nc = max(1, min(16, floor(mpG(c,3))));
    gfx_set(0.16, 0.16, 0.18, 1); gfx_rect(x, y, cs*9, cs*9);
    i = 0; loop(nc, chColor(c, 1); gfx_rect(x + a[i*3]*cs + 1, y + a[i*3 + 1]*cs + 1, cs - 2, cs - 2); i += 1;);
    gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1); textAt("OTOMATA 9×9", x + cs*9 + 8, y + 2);
    textAt("pared = nota", x + cs*9 + 8, y + 16);
  );
  ty == 1 ? (
    e = xb + 300; cs = w/8;
    j = 0; loop(4, i = 0; loop(8, e[j*8 + i] ? chColor(c, 0.5 + j*0.15) : gfx_set(0.16, 0.16, 0.18, 1);
      gfx_rect(x + i*cs + 1, y + j*14 + 2, cs - 2, 12); i += 1;); j += 1;);
  );
  ty == 2 ? (
    e = xb + 380; cs = w/16;
    i = 0; loop(16, e[i] ? chColor(c, i == 8 ? 1 : 0.65) : gfx_set(0.16, 0.16, 0.18, 1); gfx_rect(x + i*cs + 1, y + 4, cs - 2, 16); i += 1;);
    sprintf(#wr, "regla %d", mpG(c,1)); gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1); textAt(#wr, x, y + 26);
    viewRoll(c, x, y + 40, w, h - 40);
  );
);
function viewSpace(c, x, y, w, h) local(xb, ty, i, j, cs, idx, z, pit, gts, gat, kr, pos, L, ob, ln, p)(
  xb = xbG(c); ty = floor(mpG(c,0)); pos = sgG(c, 44);
  ty == 0 ? (
    cs = min(floor(h/4), 15); z = sgG(c, 53); pit = xb + 450; gts = xb + 520; gat = mpG(c,5)/100;
    j = 0; loop(4, i = 0; loop(4, idx = z*16 + j*4 + i;
      gts[idx] < gat ? chColor(c, 0.25 + 0.75*min(1, pit[idx]/24)) : gfx_set(0.16, 0.16, 0.18, 1);
      gfx_rect(x + i*cs + 1, y + j*cs + 1, cs - 2, cs - 2);
      (i == sgG(c, 60) && j == sgG(c, 61)) ? ( gfx_set(1, 1, 1, 1); gfx_rect(x + i*cs, y + j*cs, cs, cs, 0); );
      i += 1;); j += 1;);
    gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1); sprintf(#rz, "RENÉ · página Z %d", z + 1); textAt(#rz, x + cs*4 + 8, y + 2);
  );
  ty == 1 ? (
    kr = xb + 600; cs = w/16;
    j = 0; loop(4, L = max(1, min(16, floor(mpG(c, 9 + j)))); p = pos - floor(pos/L)*L;
      i = 0; loop(16, i < L ? ( ((j == 0 && kr[i] < mpG(c,5)/100) || j > 0) ? chColor(c, i == p ? 1 : 0.4 + 0.12*j) : gfx_set(0.2, 0.2, 0.22, 1); ) : gfx_set(0.1, 0.1, 0.11, 1);
        gfx_rect(x + i*cs + 1, y + j*15 + 1, cs - 2, 12); i += 1;); j += 1;);
  );
  ty == 2 ? (
    ob = xb + 700; ln = max(1, min(8, floor(mpG(c,13))));
    gfx_setfont(3);
    i = 0; loop(ln, chColor(c, 0.8); sprintf(#ol, "D%d I%d:%d  %d", ob[i*5], ob[i*5 + 2], ob[i*5 + 1], ob[i*5 + 4]); textAt(#ol, x + (i % 2)*(w/2), y + floor(i/2)*14); i += 1;);
  );
);
function viewEuclid(c, x, y, w, h) local(xb, ty, n1, k1, rot, n2, k2, pos, mp, i, ln, cs, gx, gy, v, thr)(
  xb = xbG(c); ty = floor(mpG(c,0)); pos = sgG(c, 44);
  n1 = max(1, mpG(c,1)); k1 = mpG(c,2); rot = mpG(c,3); n2 = max(1, mpG(c,4)); k2 = mpG(c,5);
  ty == 2 ? (
    mp = xb + 2300; cs = w/32; gx = mpG(c,7)/100; gy = mpG(c,8)/100; thr = 1 - mpG(c,9)/100;
    ln = 0; loop(3, i = 0; loop(32,
      v = (mp[ln*128 + i]*(1 - gx) + mp[ln*128 + 32 + i]*gx)*(1 - gy) + (mp[ln*128 + 64 + i]*(1 - gx) + mp[ln*128 + 96 + i]*gx)*gy;
      v > thr ? chColor(c, 0.4 + 0.6*v) : gfx_set(0.16, 0.16, 0.18, 1);
      gfx_rect(x + i*cs, y + ln*18 + 2, max(1, cs - 1), 14);
      i == (pos - 1) - floor((pos - 1)/32)*32 ? ( gfx_set(1, 1, 1, 1); gfx_rect(x + i*cs, y + ln*18 + 16, max(1, cs - 1), 2); );
      i += 1;); ln += 1;);
  ) : (
    ringDraw(x + 30, y + h/2, 26, n1, k1, rot, (pos - 1) - floor((pos - 1)/n1)*n1, c, 1);
    ty != 1 ? ringDraw(x + 100, y + h/2, 26, n2, k2, 0, (pos - 1) - floor((pos - 1)/n2)*n2, c, 0.55);
    gfx_setfont(3); gfx_set(0.55, 0.55, 0.58, 1);
    sprintf(#eu, "E(%d,%d)", k1, n1); textAt(#eu, x + 138, y + 4);
    ty != 1 ? ( sprintf(#eu2, "E(%d,%d)", k2, n2); textAt(#eu2, x + 138, y + 18); );
  );
);
function viewPhrase(c, x, y, w, h, base, L) local(i, bw, v, mn, mx2, k, pos)(
  L = max(1, L); bw = w/L; mn = base[0]; mx2 = base[0]; i = 0; loop(L, mn = min(mn, base[i]); mx2 = max(mx2, base[i]); i += 1;);
  pos = sgG(c, 44); k = (pos - 1) - floor((pos - 1)/L)*L;
  i = 0; loop(L, v = (base[i] - mn)/max(1, mx2 - mn);
    i == k ? gfx_set(1, 1, 1, 1) : chColor(c, 0.6);
    gfx_rect(x + i*bw + 1, y + h - 8 - v*(h - 14), max(1, bw - 2), 4); i += 1;);
);
function viewRules(c, x, y, w, h) local(ty)(
  ty = floor(mpG(c,0));
  ty == 0 ? viewPhrase(c, x, y, w, h, xbG(c) + 800, max(4, min(16, floor(mpG(c,1))))) : viewRoll(c, x, y, w, h);
  ty == 3 ? ( chColor(c, 1); gfx_circle(x + sgG(c, 60)*w, y + h - sgG(c, 61)*h, 4, 1, 1); gfx_set(0.4, 0.4, 0.42, 1); gfx_rect(x, y, w, h, 0); );
);
function viewInterval(c, x, y, w, h) local(xb, ty, L, i, bw, v, k, pos, rc)(
  xb = xbG(c); ty = floor(mpG(c,0)); pos = sgG(c, 44);
  ty == 0 ? (
    rc = sgG(c, 72); L = (mpG(c,1) >= 1 && rc > 0) ? rc : max(2, min(32, floor(mpG(c,2)))); bw = w/L; k = (pos - 1) - floor((pos - 1)/L)*L;
    gfx_set(0.25, 0.25, 0.27, 1); gfx_rect(x, y + h/2, w, 1);
    i = 0; loop(L, v = max(-6, min(6, xb[900 + i]));
      i == k ? gfx_set(1, 1, 1, 1) : chColor(c, 0.65);
      v >= 0 ? gfx_rect(x + i*bw + 1, y + h/2 - v*h/14, max(1, bw - 2), max(2, v*h/14)) : gfx_rect(x + i*bw + 1, y + h/2, max(1, bw - 2), -v*h/14);
      i += 1;);
  ) : viewRoll(c, x, y, w, h);
  mpG(c,1) >= 1 ? ( gfx_setfont(3); gfx_set(0.6, 0.85, 0.7, 1); textAt("ENTRADA: toca intervalos (REF = 0)", x, y); );
);

// ---------- cabecera ----------
gfx_setfont(1, "Arial", 17, 'b');
gfx_setfont(2, "Arial", 13, 'b');
gfx_setfont(3, "Arial", 11);
gfx_setfont(4, "Arial", 12);
gfx_setfont(5, "Arial", 11, 'b');
gfx_setfont(6, "Arial", 24, 'b');

gfx_setfont(6); gfx_set(0.95, 0.80, 0.45, 1); textAt("AURELIA", 16, 8);
gfx_setfont(3); gfx_set(0.5, 0.5, 0.52, 1);
gfx_x += 12; gfx_y = 19; gfx_drawstr("secuenciador generativo");
// selector de presets
gfx_setfont(3); gfx_set(0.5, 0.5, 0.52, 1); textAt("PRESET", 300, 19);
curPr = max(0, min(prN[0], floor(slider(17) + 0.5)));
curPr > 0 ? sprintf(#prl, "%d · %s", curPr, prName[curPr - 1]) : strcpy(#prl, "— elige un preset —");
r = selector(346, 14, 400, #prl, 4);
hover(346, 14, 400, 20) ? (
  curPr > 0 ? sprintf(#help, "%s · %s — %s", prCat[floor((curPr - 1)/32)], prName[curPr - 1], prDesc[curPr - 1])
            : strcpy(#help, "PRESETS: 256 configuraciones completas inspiradas en obras y técnicas (Xenakis, Cage, serialismo, minimalismo, Berlin School, generativa, contemporánea, ritmos euclídeos). Flechas o rueda para recorrerlos; clic para el menú por categorías. Cargar un preset reinicia las cuatro voces.");
);
r == -1 ? loadPreset(curPr <= 1 ? prN[0] - 1 : curPr - 2);
r == 1 ? loadPreset(curPr >= prN[0] ? 0 : curPr);
r == 2 ? (
  strcpy(#menu, ""); gi = 0;
  loop(prN[1],
    gi > 0 ? strcat(#menu, "|"); strcat(#menu, ">"); strcat(#menu, prCat[gi]);
    gj = 0; loop(32, pidx = gi*32 + gj; strcat(#menu, "|"); gj == 31 ? strcat(#menu, "<"); pidx + 1 == curPr ? strcat(#menu, "!");
      sprintf(#mi, "%d  %s", pidx + 1, prName[pidx]); strcat(#menu, #mi); gj += 1;);
    gi += 1;);
  rr = popup(350, 36); rr > 0 ? loadPreset(rr - 1);
);
gfx_setfont(2);
(gClock == 1 || (gClock == 2 && !playing)) ? ( gfx_set(0.6, 0.9, 0.7, 1); sprintf(#hd, "RELOJ LIBRE  %.1f BPM", gTempo); ) : (
  playing ? ( gfx_set(0.6, 0.9, 0.7, 1); sprintf(#hd, "REPRODUCIENDO  %.1f BPM", btempo); ) : ( gfx_set(0.6, 0.6, 0.62, 1); strcpy(#hd, "PARADO  (play en REAPER)"); ) );
gfx_measurestr(#hd, uiTw, uiTh); textAt(#hd, 1264 - uiTw, 16);

// ---------- voces ----------
COLW = 225;
gc = 0;
loop(4,
  x0 = 12 + gc*COLW; vb0 = 21 + gc*30; gm = max(0, min(13, floor(slider(vb0 + 2))));
  gfx_set(0.115, 0.115, 0.125, 1); gfx_rect(x0, 46, COLW - 8, 548);
  chColor(gc, slider(vb0) ? 1 : 0.35); gfx_rect(x0, 46, COLW - 8, 3);

  // nombre + LED + ON + TEST
  gfx_setfont(1); chColor(gc, slider(vb0) ? 1 : 0.4);
  sprintf(#vn, "VOZ %d", gc + 1); textAt(#vn, x0 + 10, 58);
  led = max(0, 1 - (nowT - hitTime[gc]) / 0.12);
  gfx_set(0.25, 0.25, 0.27, 1); gfx_circle(x0 + 78, 67, 5, 1, 1);
  led > 0 && slider(vb0) ? ( chColor(gc, led*(0.4 + 0.6*hitVel[gc]/127)); gfx_circle(x0 + 78, 67, 5, 1, 1); );
  gfx_setfont(3);
  toggle(x0 + 94, 57, 40, 20, slider(vb0) ? "ON" : "OFF", slider(vb0), gc) ? setSlider(vb0, !slider(vb0));
  hover(x0 + 94, 57, 40, 20) ? strcpy(#help, vcHelp[0]);
  button(x0 + 140, 57, 42, 20, "TEST") ? testReq[gc] = 1;
  hover(x0 + 140, 57, 42, 20) ? strcpy(#help, "Envía una nota de prueba por el canal de esta voz.");

  // modo
  gfx_setfont(3); gfx_set(0.5, 0.5, 0.52, 1); textAt("MODO", x0 + 10, 86);
  r = selector(x0 + 6, 100, COLW - 20, nmMode[gm], gc);
  hover(x0 + 6, 100, COLW - 20, 20) ? strcpy(#help, vcHelp[2]);
  r == -1 ? setMode(gc, (gm + 13) % 14);
  r == 1 ? setMode(gc, (gm + 1) % 14);
  r == 2 ? ( listMenu(nmMode, 14, gm); rr = popup(x0 + 21, 120); rr > 0 ? setMode(gc, rr - 1); );

  // canal MIDI
  gfx_setfont(3); gfx_set(0.5, 0.5, 0.52, 1); textAt("MIDI OUT", x0 + 10, 126);
  mch = max(1, min(16, floor(slider(vb0 + 1))));
  sprintf(#chs, "CANAL %d", mch);
  r = selector(x0 + 6, 140, 92, #chs, gc);
  hover(x0 + 6, 140, 92, 20) ? strcpy(#help, vcHelp[1]);
  r == -1 ? setSlider(vb0 + 1, mch == 1 ? 16 : mch - 1);
  r == 1 ? setSlider(vb0 + 1, mch == 16 ? 1 : mch + 1);
  r == 2 ? (
    strcpy(#menu, ""); gi = 1; loop(16, gi > 1 ? strcat(#menu, "|"); gi == mch ? strcat(#menu, "!"); sprintf(#mi, "Canal %d", gi); strcat(#menu, #mi); gi += 1;);
    rr = popup(x0 + 21, 160); rr > 0 ? setSlider(vb0 + 1, rr);
  );
  // salida: notas o CC
  isCC = slider(vb0 + 26) >= 0.5; ccn = max(0, min(127, floor(slider(vb0 + 27) + 0.5)));
  gfx_setfont(5);
  toggle(x0 + 102, 140, 30, 20, "CC", isCC, gc) ? setSlider(vb0 + 26, !isCC);
  hover(x0 + 102, 140, 30, 20) ? strcpy(#help, vcHelp[10]);
  isCC ? sprintf(#ccs, "%d", ccn) : strcpy(#ccs, "notas");
  r = selector(x0 + 136, 140, COLW - 150, #ccs, gc);
  hover(x0 + 136, 140, COLW - 150, 20) ? strcpy(#help, vcHelp[11]);
  r == -1 ? ( setSlider(vb0 + 26, 1); setSlider(vb0 + 27, max(0, ccn - 1)); );
  r == 1 ? ( setSlider(vb0 + 26, 1); setSlider(vb0 + 27, min(127, ccn + 1)); );
  r == 2 ? (
    strcpy(#menu, isCC ? "Notas" : "!Notas"); gi = 0;
    loop(8, sprintf(#mi, "|>CC %d-%d", gi*16, gi*16 + 15); strcat(#menu, #mi);
      gj = 0; loop(16, n2 = gi*16 + gj; strcat(#menu, "|"); gj == 15 ? strcat(#menu, "<"); (isCC && n2 == ccn) ? strcat(#menu, "!");
        sprintf(#mi, "%d%s", n2, n2 == 1 ? " modulación" : (n2 == 7 ? " volumen" : (n2 == 10 ? " panorama" : (n2 == 11 ? " expresión" : (n2 == 71 ? " resonancia" : (n2 == 74 ? " corte/brillo" : (n2 == 64 ? " sustain" : ""))))))); strcat(#menu, #mi); gj += 1;);
      gi += 1;);
    rr = popup(x0 + 140, 160);
    rr == 1 ? setSlider(vb0 + 26, 0) : ( rr > 1 ? ( setSlider(vb0 + 26, 1); setSlider(vb0 + 27, rr - 2); ); );
  );

  // cuantización
  gfx_setfont(5);
  toggle(x0 + 6, 168, 66, 20, "ESC", slider(vb0 + 3), gc) ? setSlider(vb0 + 3, !slider(vb0 + 3));
  hover(x0 + 6, 168, 66, 20) ? strcpy(#help, vcHelp[3]);
  toggle(x0 + 76, 168, 66, 20, "RIT", slider(vb0 + 4), gc) ? setSlider(vb0 + 4, !slider(vb0 + 4));
  hover(x0 + 76, 168, 66, 20) ? strcpy(#help, vcHelp[4]);
  isGuide = gContra == 0 && gc == gGuide - 1;
  toggle(x0 + 146, 168, 66, 20, isGuide ? "GUÍA" : "ARM", slider(vb0 + 5) && !isGuide, gc) ? setSlider(vb0 + 5, !slider(vb0 + 5));
  hover(x0 + 146, 168, 66, 20) ? strcpy(#help, isGuide ? "Esta voz es la guía armónica: las demás voces con ARM se ajustan a ella (cámbialo en GUÍA, a la derecha)." : vcHelp[5]);

  // vista del modo
  gfx_set(0.08, 0.08, 0.085, 1); gfx_rect(x0 + 6, 196, COLW - 20, 70);
