  gm == 2 ? viewTuring(gc, vx, vy, vw, vh);
  gm == 4 ? viewAnalog(gc, vx, vy, vw, vh);
  gm == 5 ? viewSubseq(gc, vx, vy, vw, vh);
  gm == 6 ? viewMarkov(gc, vx, vy, vw, vh);
  gm == 7 ? viewSerial(gc, vx, vy, vw, vh);
  (gm == 8) ? viewRoll(gc, vx, vy, vw, vh);
  gm == 9 ? viewAuto(gc, vx, vy, vw, vh);
  gm == 10 ? viewSpace(gc, vx, vy, vw, vh);
  gm == 11 ? viewEuclid(gc, vx, vy, vw, vh);
  gm == 12 ? viewRules(gc, vx, vy, vw, vh);
  gm == 13 ? viewInterval(gc, vx, vy, vw, vh);
  gm == 3 ? (
    viewBloom(gc, vx, vy, vw - 52, vh);
    gfx_setfont(3);
    button(x0 + COLW - 62, 200, 46, 18, "NUEVO") ? bCmd[gc] = 1;
    hover(x0 + COLW - 62, 200, 46, 18) ? strcpy(#help, "Genera un tronco nuevo (como MUTATE al máximo). El anterior queda guardado para DESHACER.");
    button(x0 + COLW - 62, 222, 46, 18, "DESH.") ? bCmd[gc] = 2;
    hover(x0 + COLW - 62, 222, 46, 18) ? strcpy(#help, "Deshace las mutaciones: vuelve al último tronco guardado (como Shift + Reset en Bloom).");
  );
  hover(x0 + 6, 196, COLW - 20, 70) && !hover(x0 + COLW - 62, 200, 46, 40) ? (
    gm == 0 ? strcpy(#help, "Nube de esta voz en los últimos 8 tiempos: altura (vertical) y duración (largo de cada trazo).");
    gm == 1 ? strcpy(#help, "El polígono de GENDYN: cada punto es una nota; la distancia horizontal, su duración. Las líneas rojas son las barreras de amplitud. El punto blanco es el siguiente.");
    gm == 2 ? strcpy(#help, "Registro de 16 bits del Turing Machine (encendidos = 1). La raya marca la longitud del bucle; la barra, la salida del DAC de 8 bits.");
    gm == 3 ? strcpy(#help, "Rama que suena ahora (alturas del tronco transformado). Los puntos de abajo son el tronco y las ramas; el iluminado es el actual.");
    gm == 4 ? strcpy(#help, "Las 8 pantallas de Analogique A (A = f0 g0 d0 … H = f1 g1 d1: altura, dinámica, densidad). Abajo, las últimas 32 pantallas: la cadena de Markov en el tiempo.");
    gm == 5 ? strcpy(#help, "Acorde actual, sus 4 compases de sección y el ritmo euclídeo del ciclo (se reconstruye cada 16 pasos).");
    gm == 7 ? strcpy(#help, "La serie de alturas (grados) y la posición actual. En PR1/PR2, el último grado elegido por los métodos de selección de Koenig.");
    gm == 8 ? strcpy(#help, "Lo que ha tocado esta voz en los últimos 8 tiempos (escala automática): la autosemejanza de la serie de Nørgård, el ruido 1/f o la gramática.");
    gm == 9 ? strcpy(#help, "Estado del autómata: la rejilla de Otomata (cada cuadro es una célula), las 4 filas de ECA-256 o la fila de 16 células de Wolfram (la central, resaltada).");
    gm == 10 ? strcpy(#help, "RENÉ: rejilla 4×4 (brillo = altura; apagada = sin disparo; recuadro = cursor). KRIA: los 4 bucles (disparo, nota, octava, duración) con su longitud. ORCA: periodo, paso, módulo y contador de cada línea.");
    gm == 11 ? strcpy(#help, "Los anillos euclídeos A y B con el paso actual; en GRIDS, los tres carriles (bombo, caja, charles) que superan el umbral de densidad.");
    gm == 12 ? strcpy(#help, "OMCLOUDS: la frase que se va corrigiendo. CONTRAP. y SITUATION: lo que ha sonado. MUS.MOUSE: la posición del cursor.");
    gm == 13 ? strcpy(#help, "MISHA: la secuencia de intervalos (arriba = sube, abajo = baja) y el paso actual. SAMCHILL: lo que ha sonado.");
    gm == 6 ? strcpy(#help, "Tamaño del corpus aprendido, orden de la cadena y cuántas continuaciones posibles encontró para la última nota. Abajo, las últimas notas que has tocado por la entrada.");
  );

  // knobs del modo: 4 x 4
  gfx_setfont(3); gfx_set(0.42, 0.42, 0.45, 1); textAt(nmMode[gm], x0 + 10, 272);
  kx = 0;
